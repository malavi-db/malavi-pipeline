{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "malavi/grand_lineage_summary.schema.json",
  "title": "MalAvi Grand Lineage Summary record",
  "description": "Per-lineage summary row. Authoritative columns as of malaviR release 2026-03-23 (24 columns). Note: all columns ship as character/string from malaviR, including the numeric-looking tallies.",
  "type": "object",
  "properties": {
    "LINEAGE_NAME":  { "type": "string", "description": "MalAvi parasite lineage code." },
    "GENBANK_ACC":   { "type": ["string", "null"], "description": "GenBank accession for the lineage sequence." },
    "SEQ_LENGTH":    { "type": ["string", "null"], "description": "Reported sequence length (as string)." },
    "GENUS_NAME":    { "type": ["string", "null"], "description": "Parasite genus." },
    "SPECIES_NAME":  { "type": ["string", "null"], "description": "Linked morphospecies name, if any." },
    "SUM_VECTORS":   { "type": ["string", "null"], "description": "Number of vector records." },
    "SUM_HOST":      { "type": ["string", "null"], "description": "Number of host species." },
    "SUM_GENUS":     { "type": ["string", "null"], "description": "Number of host genera." },
    "SUM_FAMILY":    { "type": ["string", "null"], "description": "Number of host families." },
    "SUM_ORDER":     { "type": ["string", "null"], "description": "Number of host orders." },
    "PASSERIFORMES": { "type": ["string", "null"], "description": "Recorded in Passeriformes (tally/flag)." },
    "EUROPE":                         { "type": ["string", "null"], "description": "Regional occurrence tally: Europe." },
    "SUB_SAHARAN_AFRICA":             { "type": ["string", "null"], "description": "Regional occurrence tally." },
    "NORTH_AFRICA_AND_MIDDLE_EAST":   { "type": ["string", "null"], "description": "Regional occurrence tally." },
    "NORTH_AMERICA":                  { "type": ["string", "null"], "description": "Regional occurrence tally." },
    "HAWAI":                          { "type": ["string", "null"], "description": "Regional occurrence tally: Hawaii." },
    "CENTRAL_AMERICA":                { "type": ["string", "null"], "description": "Regional occurrence tally." },
    "SOUTH_AMERICA":                  { "type": ["string", "null"], "description": "Regional occurrence tally." },
    "ASIA":                           { "type": ["string", "null"], "description": "Regional occurrence tally." },
    "AUSTRALIA_AND_NEW_ZEALAND":      { "type": ["string", "null"], "description": "Regional occurrence tally." },
    "OCEANIA":                        { "type": ["string", "null"], "description": "Regional occurrence tally." },
    "ANTARCTICA":                     { "type": ["string", "null"], "description": "Regional occurrence tally." },
    "UNKNOWN_REGION":                 { "type": ["string", "null"], "description": "Regional occurrence tally: unknown." },
    "SEQUENCE":      { "type": ["string", "null"], "description": "Full cytochrome b nucleotide sequence for the lineage." }
  },
  "required": ["LINEAGE_NAME"],
  "additionalProperties": false
}
