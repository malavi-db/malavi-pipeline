{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "malavi/hosts_and_sites.schema.json",
  "title": "MalAvi Hosts and Sites record",
  "description": "One individual host infection record. Authoritative columns as of malaviR release 2026-03-23 (20 columns).",
  "type": "object",
  "properties": {
    "LINEAGE_NAME":        { "type": "string", "description": "MalAvi parasite lineage code (e.g. SGS1)." },
    "ALT_NAME":            { "type": ["string", "null"], "description": "Alternate / synonymous lineage name." },
    "PARASITE_GENUS":      { "type": ["string", "null"], "description": "Plasmodium, Haemoproteus, Leucocytozoon, or unresolved." },
    "ORDER_NAME":          { "type": ["string", "null"], "description": "Host order." },
    "FAMILY_NAME":         { "type": ["string", "null"], "description": "Host family." },
    "GENUS_NAME":          { "type": ["string", "null"], "description": "Host genus." },
    "SPECIES_NAME":        { "type": ["string", "null"], "description": "Host species epithet." },
    "SUB_SPECIES_NAME":    { "type": ["string", "null"], "description": "Host subspecies, if recorded." },
    "HOST_STATUS":         { "type": ["string", "null"], "enum": ["Resident", "Migratory", "Unknown", null], "description": "Migratory behavior of the host. Controlled vocabulary as observed in the 2026-03-23 release." },
    "HOST_AGE":            { "type": ["string", "null"], "enum": ["Adult", "Juvenile", "Nestling", "Adult + Juvenile", "Adult + Nestling", "Unknown", null], "description": "Host age class if recorded. Controlled vocabulary as observed in the 2026-03-23 release." },
    "HOST_ENVIRONMENT":    { "type": ["string", "null"], "enum": ["Wild", "Captivity", null], "description": "Whether the host was free-living or held. The Grand Lineage Summary excludes 'Captivity' records." },
    "CONTINENT_NAME":      { "type": ["string", "null"], "description": "Continent of the record." },
    "COUNTRY_NAME":        { "type": ["string", "null"], "description": "Country of the record." },
    "COUNTRY_REGION_NAME": { "type": ["string", "null"], "description": "Sub-national region." },
    "SITE_NAME":           { "type": ["string", "null"], "description": "Locality name." },
    "SITE_COORDINATES":    { "type": ["string", "null"], "description": "Latitude/longitude as recorded (free text)." },
    "NUMBER_FOUND":        { "type": ["number", "null"], "description": "Count of infected individuals." },
    "NUMBER_TESTED":       { "type": ["number", "null"], "description": "Count of individuals tested." },
    "REFERENCE_NAME":      { "type": "string", "description": "Citation key into the references table (e.g. 'Bensch et al 2009')." },
    "COMMENT":             { "type": ["string", "null"], "description": "Free-text note." }
  },
  "required": ["LINEAGE_NAME", "REFERENCE_NAME"],
  "additionalProperties": false
}
