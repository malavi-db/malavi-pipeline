/**
 * mail.gs: the ONE place this project sends email.
 *
 * WHY
 * ---
 * On 2026-10-16 the first live intake cycle with the review state in the repository
 * re-applied thirteen old verdict-form responses and the endpoint sent the curators nine
 * duplicate notices. Every send in the project called GmailApp directly, in twenty
 * places, so nothing stood between a program's mistake and a curator's inbox. Vincenzo
 * asked for guard rails: no incorrect or unneeded email, during development or in
 * production (results/GUARDRAILS_PLAN_2026-10-16.md, section 1.1).
 *
 * Now nothing else in the project calls GmailApp.sendEmail, MailApp.sendEmail or
 * GmailMessage.forward; a test (curation/tests/test_apps_script_mail.py) fails if one
 * does. Every message goes through sendMail_ or forwardMail_, which apply, in order:
 *
 *   1. the recipient rules: a message for a curator or a lead goes only to an address on
 *      CURATORS, ATTENTION_TO or ASSIGNEES; a message for a submitter must not mention
 *      another submitter's submission id;
 *   2. MAIL_MODE (Script Property): live sends; dry sends nothing; redirect sends every
 *      message to MAIL_REDIRECT_TO instead, with the real recipient in the subject.
 *      UNSET MEANS DRY: a pasted bundle sends nothing until the property is set, and
 *      showSettings says NOT READY until it is. Properties first, paste second;
 *   3. the duplicate check: the message's key (given by the caller for machine-originated
 *      mail, where it names the RESPONSE or the REPORT the message is about; derived from
 *      the text otherwise), plus the recipient, is remembered in Script Properties for
 *      MAIL_DEDUPE_DAYS. The same message to the same person is sent once;
 *   4. the per-execution cap MAIL_MAX_PER_RUN and the daily quota reserve
 *      MAIL_QUOTA_RESERVE (MailApp.getRemainingDailyQuota, as the inbox triage already
 *      does).
 *
 * A message that is not sent is HELD: recorded on the Mail tab with the reason, counted
 * for the day, reported to the caller as { sent: false, held: <reason> }, and the
 * endpoint tells the Python side the same in its reply so nothing is recorded as sent
 * that was not. A held message is never silently lost: in dry and redirect mode one
 * alarm a day goes to the fallback address (the first lead) saying how many were held
 * and why, and the daily digest carries the count.
 *
 * `force: true` bypasses the mode, the caps and the duplicate check. It exists for the
 * alarm itself and for the "notice FAILED" fallbacks, which are the channel that says
 * something is wrong; it is still recorded.
 *
 * FAIL CLOSED. The duplicate memory is written BEFORE the send and forgotten again if
 * the send throws: a memory that cannot be written holds the message rather than
 * sending it unremembered (review of 2026-10-16, finding 11). The Mail tab is the
 * human record and is never the mechanism; recordMail_ never throws.
 */

var SETTINGS_NEEDED_MAIL = ['MAIL_MODE', 'MAIL_REDIRECT_TO', 'MAIL_MAX_PER_RUN',
                            'MAIL_QUOTA_RESERVE', 'MAIL_DEDUPE_DAYS',
                            'CURATORS', 'ATTENTION_TO', 'ASSIGNEES'];

var MAIL_MODES = ['live', 'redirect', 'dry'];
var MAIL_DEFAULT_MAX_PER_RUN = 25;      // above any legitimate single execution (~15)
var MAIL_DEFAULT_QUOTA_RESERVE = 20;    // sends kept back for alarms and fallbacks
var MAIL_DEFAULT_DEDUPE_DAYS = 30;

// Script Property prefixes. Properties survive every paste and every new version.
var MAIL_MEMORY_PREFIX = 'mail:';       // mail:<key> -> epoch ms of the send
var MAIL_HELD_PREFIX = 'mailheld:';     // mailheld:<UTC day> -> messages held that day
var MAIL_ALARM_PREFIX = 'mailalarm:';   // mailalarm:<UTC day>:<reason> -> alarm sent
var MAIL_MEMORY_PRUNE_AT = 300;         // prune expired memory once this many properties exist
var MAIL_COUNTER_KEEP_DAYS = 14;

// Per execution. Apps Script runs each trigger or request in a fresh execution.
var mailRunCount_ = 0;        // messages actually sent in this execution
var mailRunHeld_ = [];        // [{ to, reason }] held in this execution
var mailCapAlarmed_ = false;  // the per-run cap alarm goes once per execution

var SUBMISSION_ID_RE = /MALAVI-SUB-\d{4}-\d{6}/g;


// ---------------------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------------------

// A request may ask for a MORE restrictive mode than the property for its own execution
// (doPost sets this from the payload's mail_mode, so a maintainer running the machine side
// with MALAVI_MAIL_MODE=redirect receives the mail even while the project is live). Never
// less restrictive: live > redirect > dry, and the property is the ceiling.
var mailRequestedMode_ = '';
var MAIL_RANK = { live: 0, redirect: 1, dry: 2 };

/** The mode in force: the more restrictive of the Script Property and the request's
 *  own wish. Anything else, including unset, is dry. */
function mailMode_() {
  var value = setting_('MAIL_MODE').toLowerCase();
  var mode = MAIL_MODES.indexOf(value) === -1 ? 'dry' : value;
  var wanted = String(mailRequestedMode_ || '').toLowerCase();
  if (MAIL_MODES.indexOf(wanted) !== -1 && MAIL_RANK[wanted] > MAIL_RANK[mode]) mode = wanted;
  return mode;
}

/** Called by doPost with the payload's mail_mode (a downgrade request); ignored unless
 *  it names one of the three modes. */
function requestMailMode_(wanted) {
  mailRequestedMode_ = String(wanted || '').toLowerCase();
}

/** Whether MAIL_MODE is set to one of the three words (unset is dry but not explicit). */
function mailModeIsExplicit_() {
  return MAIL_MODES.indexOf(setting_('MAIL_MODE').toLowerCase()) !== -1;
}

/** A numeric setting with a default; a setting that is not a positive number is ignored. */
function mailNumber_(name, fallback) {
  var number = Number(setting_(name));
  return number > 0 ? number : fallback;
}

/** Every address a curator- or lead-kind message may go to, lowercase, as a set. */
function mailKnownAddresses_() {
  var known = {};
  var lists = [curators_(), attentionTo_(), assignees_()];
  for (var i = 0; i < lists.length; i++) {
    for (var j = 0; j < lists[i].length; j++) known[String(lists[i][j]).toLowerCase()] = true;
  }
  return known;
}


// ---------------------------------------------------------------------------------------
// Keys and memory
// ---------------------------------------------------------------------------------------

/** SHA-256 of a string, as 32 hex characters. */
function mailSha_(text) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(text),
                                      Utilities.Charset.UTF_8);
  var out = '';
  for (var i = 0; i < bytes.length && out.length < 32; i++) {
    var b = bytes[i] < 0 ? bytes[i] + 256 : bytes[i];
    out += (b < 16 ? '0' : '') + b.toString(16);
  }
  return out;
}

/** Today as YYYY-MM-DD, UTC. */
function mailUtcDay_(date) {
  return (date || new Date()).toISOString().slice(0, 10);
}

/** Whether this key was sent within the duplicate window. */
function mailAlreadySent_(key) {
  var stamp = PropertiesService.getScriptProperties().getProperty(MAIL_MEMORY_PREFIX + key);
  if (!stamp) return false;
  var age = Date.now() - Number(stamp);
  return age >= 0 && age < mailNumber_('MAIL_DEDUPE_DAYS', MAIL_DEFAULT_DEDUPE_DAYS) * 86400000;
}

/** Remember a key as sent now. Returns false when the memory could not be written. */
function mailRemember_(key) {
  try {
    var properties = PropertiesService.getScriptProperties();
    properties.setProperty(MAIL_MEMORY_PREFIX + key, String(Date.now()));
    if (Object.keys(properties.getProperties()).length > MAIL_MEMORY_PRUNE_AT) pruneMailMemory_();
    return true;
  } catch (err) {
    Logger.log('mail memory could not be written: ' + err);
    return false;
  }
}

/** Forget a key (a send that threw after the key was remembered). Best effort. */
function mailForget_(key) {
  try { PropertiesService.getScriptProperties().deleteProperty(MAIL_MEMORY_PREFIX + key); }
  catch (err) { Logger.log('mail memory could not be cleared: ' + err); }
}

/** Delete expired memory, old daily counters and old alarm markers. */
function pruneMailMemory_() {
  var properties = PropertiesService.getScriptProperties();
  var all = properties.getProperties();
  var now = Date.now();
  var window = mailNumber_('MAIL_DEDUPE_DAYS', MAIL_DEFAULT_DEDUPE_DAYS) * 86400000;
  var keepDay = mailUtcDay_(new Date(now - MAIL_COUNTER_KEEP_DAYS * 86400000));
  var removed = 0;
  for (var name in all) {
    if (!all.hasOwnProperty(name)) continue;
    var expired = false;
    if (name.indexOf(MAIL_MEMORY_PREFIX) === 0) {
      expired = now - Number(all[name]) > window;
    } else if (name.indexOf(MAIL_HELD_PREFIX) === 0 || name.indexOf(MAIL_ALARM_PREFIX) === 0) {
      expired = name.split(':')[1] < keepDay;
    }
    if (expired) { properties.deleteProperty(name); removed += 1; }
  }
  return removed;
}

/** Count one held message for today. Never throws. */
function mailCountHeld_() {
  try {
    var properties = PropertiesService.getScriptProperties();
    var name = MAIL_HELD_PREFIX + mailUtcDay_();
    properties.setProperty(name, String(Number(properties.getProperty(name) || 0) + 1));
  } catch (err) {
    Logger.log('held counter could not be written: ' + err);
  }
}

/** How many messages were held today (UTC). */
function mailHeldToday_() {
  return Number(PropertiesService.getScriptProperties()
                    .getProperty(MAIL_HELD_PREFIX + mailUtcDay_()) || 0);
}


// ---------------------------------------------------------------------------------------
// The recipient rules
// ---------------------------------------------------------------------------------------

/** Submission ids mentioned in a text, unique, in order. */
function mailSubmissionIds_(text) {
  var found = String(text || '').match(SUBMISSION_ID_RE) || [];
  var unique = [];
  for (var i = 0; i < found.length; i++) if (unique.indexOf(found[i]) === -1) unique.push(found[i]);
  return unique;
}

/**
 * The first submission id in the text whose Submissions row belongs to a DIFFERENT
 * submitter than `to`, or ''. A submitter may be told about their own other submissions
 * (one person often has two in the queue; review 2026-10-16, finding 12), never about
 * somebody else's. Without a status sheet nothing can be checked, and ids are then
 * allowed through: the sheet is the only source of who owns what.
 */
function mailForeignSubmissionId_(to, text, ownId) {
  if (!statusSheetEnabled_()) return '';
  var ids = mailSubmissionIds_(text);
  var address = String(to || '').toLowerCase();
  for (var i = 0; i < ids.length; i++) {
    if (ids[i] === ownId) continue;
    var row = null;
    try { row = findRow_(TAB_SUBMISSIONS, 'id', ids[i]); } catch (err) { row = null; }
    if (!row) continue;                   // unknown here: nothing to compare with
    var owner = String(row.submitter_email || '').toLowerCase();
    if (owner && owner !== address) return ids[i];
  }
  return '';
}


// ---------------------------------------------------------------------------------------
// Sending
// ---------------------------------------------------------------------------------------

/**
 * Send one email, subject to every rule above.
 *
 *   message = {
 *     to, subject, body,          required
 *     options,                    passed to GmailApp.sendEmail (cc, replyTo, htmlBody, name)
 *     kind,                       'curator' | 'lead' | 'submitter' | 'system'
 *     submissionId,               for the Mail tab and the submitter rule
 *     key,                        the message's identity (the caller's, or derived)
 *     note,                       for the Mail tab
 *     force                       bypass mode, caps and the duplicate check (alarms only)
 *   }
 *
 * Returns { sent: true, to, key } or { sent: false, held: <reason>, to }. Throws only
 * when GmailApp itself threw, after recording the failure, so a caller that sends to
 * several people can catch per address exactly as before.
 */
function sendMail_(message) {
  var to = String(message.to || '').trim();
  var kind = String(message.kind || 'system');
  var subject = String(message.subject || '');
  var body = String(message.body || '');
  var options = {};
  var given = message.options || {};
  for (var name in given) if (given.hasOwnProperty(name)) options[name] = given[name];
  if (!options.name) options.name = 'MalAvi';
  var force = !!message.force;
  var mode = mailMode_();
  var record = { direction: 'out', id: message.submissionId || '', from: 'MalAvi', to: to,
                 subject: subject, kind: kind, mode: mode, key: '',
                 note: message.note || '' };

  function held(reason) {
    record.note = (record.note ? record.note + '; ' : '') + 'NOT SENT: ' + reason;
    recordMail_(record);
    mailCountHeld_();
    mailRunHeld_.push({ to: to, reason: reason });
    return { sent: false, held: reason, to: to };
  }

  if (!to || to.indexOf('@') === -1) return held('no usable address');
  if (!force && (kind === 'curator' || kind === 'lead') &&
      !mailKnownAddresses_()[to.toLowerCase()]) {
    return held('address not on CURATORS, ATTENTION_TO or ASSIGNEES');
  }
  if (!force && kind === 'submitter') {
    var foreign = mailForeignSubmissionId_(to, subject + '\n' + body, message.submissionId);
    if (foreign) return held('the text mentions ' + foreign + ', another submitter\'s submission');
  }

  var base = String(message.key || '') ||
             mailSha_([kind, message.submissionId || '', to.toLowerCase(), subject, body].join('|'));
  var key = mailSha_(base + '|' + to.toLowerCase());
  record.key = key;

  if (!force) {
    if (mode === 'dry') {
      mailAlarm_('dry');
      return held('MAIL_MODE=' + (mailModeIsExplicit_() ? 'dry' : 'unset (dry)'));
    }
    if (mode === 'live' && mailAlreadySent_(key)) return held('duplicate');
    if (mailRunCount_ >= mailNumber_('MAIL_MAX_PER_RUN', MAIL_DEFAULT_MAX_PER_RUN)) {
      if (!mailCapAlarmed_) { mailCapAlarmed_ = true; mailAlarm_('cap'); }
      return held('per-run cap');
    }
    var quota = MailApp.getRemainingDailyQuota();
    if (quota <= mailNumber_('MAIL_QUOTA_RESERVE', MAIL_DEFAULT_QUOTA_RESERVE)) {
      return held('daily quota reserve (' + quota + ' left)');
    }
  }

  var actualTo = to;
  var actualSubject = subject;
  var redirected = false;
  if (!force && mode === 'redirect') {
    var redirectTo = setting_('MAIL_REDIRECT_TO');
    if (redirectTo.indexOf('@') === -1) {
      return held('MAIL_MODE=redirect but MAIL_REDIRECT_TO is not set');
    }
    actualTo = redirectTo;
    actualSubject = '[REDIRECT to ' + to + '] ' + subject;
    // A redirected message must not carry its real cc list either.
    delete options.cc;
    delete options.bcc;
    redirected = true;
    mailAlarm_('redirect');
  }

  var remembered = false;
  if (!force && mode === 'live') {
    if (!mailRemember_(key)) return held('the send memory could not be written');
    remembered = true;
  }
  try {
    GmailApp.sendEmail(actualTo, actualSubject, body, options);
  } catch (err) {
    if (remembered) mailForget_(key);
    record.note = (record.note ? record.note + '; ' : '') + 'SEND FAILED: ' + err;
    recordMail_(record);
    throw err;
  }
  mailRunCount_ += 1;
  if (redirected) {
    record.mode = 'redirect';
    record.note = (record.note ? record.note + '; ' : '') + 'redirected to ' + actualTo;
    recordMail_(record);
    mailCountHeld_();
    mailRunHeld_.push({ to: to, reason: 'redirected' });
    return { sent: false, held: 'redirected', to: to, key: key };
  }
  if (force) record.mode = mode + ' (forced)';
  recordMail_(record);
  return { sent: true, to: to, key: key };
}


/**
 * Forward a Gmail message to several recipients under the same rules, as ONE forward.
 * Each recipient is checked (kind rule, duplicate of this message id to this address,
 * cap, quota); those that pass receive one forward. Returns { sent: <count>, held: [...] }.
 */
function forwardMail_(gmailMessage, recipients, options, kind, submissionId, note) {
  var mode = mailMode_();
  var messageId = gmailMessage.getId();
  var subject = String((options && options.subject) || gmailMessage.getSubject() || '');
  var known = mailKnownAddresses_();
  var send = [];
  var result = { sent: 0, held: [] };

  function held(to, reason) {
    recordMail_({ direction: 'out', id: submissionId || '', from: 'MalAvi', to: to,
                  subject: subject, kind: kind, mode: mode, key: '',
                  note: (note ? note + '; ' : '') + 'NOT SENT (forward): ' + reason });
    mailCountHeld_();
    mailRunHeld_.push({ to: to, reason: reason });
    result.held.push({ to: to, reason: reason });
  }

  for (var i = 0; i < recipients.length; i++) {
    var to = String(recipients[i] || '').trim();
    if (!to || to.indexOf('@') === -1) { held(to, 'no usable address'); continue; }
    if ((kind === 'curator' || kind === 'lead') && !known[to.toLowerCase()]) {
      held(to, 'address not on CURATORS, ATTENTION_TO or ASSIGNEES'); continue;
    }
    var key = mailSha_('forward|' + messageId + '|' + to.toLowerCase());
    if (mode === 'dry') { mailAlarm_('dry'); held(to, 'MAIL_MODE=' + (mailModeIsExplicit_() ? 'dry' : 'unset (dry)')); continue; }
    if (mode === 'live' && mailAlreadySent_(key)) { held(to, 'duplicate'); continue; }
    if (mailRunCount_ + send.length >= mailNumber_('MAIL_MAX_PER_RUN', MAIL_DEFAULT_MAX_PER_RUN)) {
      if (!mailCapAlarmed_) { mailCapAlarmed_ = true; mailAlarm_('cap'); }
      held(to, 'per-run cap'); continue;
    }
    send.push({ to: to, key: key });
  }
  if (!send.length) return result;
  var quota = MailApp.getRemainingDailyQuota();
  if (quota - send.length <= mailNumber_('MAIL_QUOTA_RESERVE', MAIL_DEFAULT_QUOTA_RESERVE)) {
    for (var q = 0; q < send.length; q++) held(send[q].to, 'daily quota reserve (' + quota + ' left)');
    return result;
  }

  var settings = {};
  for (var name in (options || {})) if (options.hasOwnProperty(name)) settings[name] = options[name];
  if (!settings.name) settings.name = 'MalAvi';
  var addresses = send.map(function (s) { return s.to; });
  var target = addresses.join(',');
  if (mode === 'redirect') {
    var redirectTo = setting_('MAIL_REDIRECT_TO');
    if (redirectTo.indexOf('@') === -1) {
      for (var r = 0; r < send.length; r++) held(send[r].to, 'MAIL_MODE=redirect but MAIL_REDIRECT_TO is not set');
      return result;
    }
    target = redirectTo;
    settings.subject = '[REDIRECT to ' + addresses.join(', ') + '] ' + subject;
    delete settings.cc;
    delete settings.bcc;
    mailAlarm_('redirect');
  } else {
    for (var m = 0; m < send.length; m++) {
      if (!mailRemember_(send[m].key)) {
        for (var h = 0; h < send.length; h++) held(send[h].to, 'the send memory could not be written');
        return result;
      }
    }
  }
  try {
    gmailMessage.forward(target, settings);
  } catch (err) {
    for (var f = 0; f < send.length; f++) {
      if (mode === 'live') mailForget_(send[f].key);
      held(send[f].to, 'FORWARD FAILED: ' + err);
    }
    return result;
  }
  mailRunCount_ += send.length;
  for (var s = 0; s < send.length; s++) {
    if (mode === 'redirect') {
      recordMail_({ direction: 'out', id: submissionId || '', from: 'MalAvi', to: send[s].to,
                    subject: subject, kind: kind, mode: 'redirect', key: send[s].key,
                    note: (note ? note + '; ' : '') + 'forward redirected to ' + target });
      mailCountHeld_();
      mailRunHeld_.push({ to: send[s].to, reason: 'redirected' });
      result.held.push({ to: send[s].to, reason: 'redirected' });
    } else {
      recordMail_({ direction: 'out', id: submissionId || '', from: 'MalAvi', to: send[s].to,
                    subject: subject, kind: kind, mode: mode, key: send[s].key,
                    note: (note ? note + '; ' : '') + 'forwarded' });
      result.sent += 1;
    }
  }
  return result;
}


// ---------------------------------------------------------------------------------------
// The alarm: a held message is never silent for more than a day
// ---------------------------------------------------------------------------------------

/**
 * Once per UTC day per reason, tell the fallback address that mail is being held. A
 * forced send: it bypasses the mode, the caps and the duplicate check, and is recorded.
 */
function mailAlarm_(reason) {
  var properties;
  var marker = MAIL_ALARM_PREFIX + mailUtcDay_() + ':' + reason;
  try {
    properties = PropertiesService.getScriptProperties();
    if (properties.getProperty(marker)) return false;
    properties.setProperty(marker, String(Date.now()));
  } catch (err) {
    Logger.log('alarm marker could not be written: ' + err);
    return false;
  }
  var mode = mailMode_();
  var explicit = mailModeIsExplicit_();
  var subject, lines;
  if (reason === 'cap') {
    subject = 'MalAvi: the per-run mail cap was reached';
    lines = ['[this is an automatic email from the MalAvi curation project]', '',
             'One execution tried to send more than MAIL_MAX_PER_RUN (' +
             mailNumber_('MAIL_MAX_PER_RUN', MAIL_DEFAULT_MAX_PER_RUN) + ') messages. The ' +
             'rest were held and recorded on the Mail tab with the reason "per-run cap".',
             '', 'A legitimate execution never sends that many. Look at the Mail tab before ' +
             'raising the cap.'];
  } else {
    subject = 'MalAvi: mail is being held (MAIL_MODE=' +
              (explicit ? mode : 'unset') + ')';
    lines = ['[this is an automatic email from the MalAvi curation project]', '',
             'MAIL_MODE is ' + (explicit ? mode : 'NOT SET, which means dry') + '. ' +
             (mode === 'redirect'
               ? 'Every message is being sent to ' + setting_('MAIL_REDIRECT_TO') +
                 ' instead of its real recipient.'
               : 'Nothing the project is asked to send reaches anyone.'),
             '', 'Messages held so far today (UTC): ' + mailHeldToday_() + '. Each one is on ' +
             'the Mail tab of the status sheet with its reason.',
             '', 'If this is a development window, nothing to do; this reminder comes once ' +
             'a day. If it is not, set MAIL_MODE to live under Project Settings > Script ' +
             'Properties. Messages from the intake programs are retried by their next ' +
             'run; the form triggers\' messages (arrival, verdict, submitter message) are ' +
             'not, and the Mail tab says which ones they were.'];
  }
  // In redirect mode the alarm goes to the person reading the redirected mail, not to
  // the first lead: during development nobody else hears from the project.
  var redirectTo = setting_('MAIL_REDIRECT_TO');
  var to = (mode === 'redirect' && redirectTo.indexOf('@') !== -1) ? redirectTo
                                                                   : fallbackAddress_();
  try {
    sendMail_({ to: to, subject: subject, body: lines.join('\n'),
                kind: 'system', force: true, note: 'mail guard alarm: ' + reason });
    return true;
  } catch (err) {
    Logger.log('the mail alarm itself could not be sent: ' + err);
    // The day's marker is forgotten so the next held message tries the alarm again.
    try { properties.deleteProperty(marker); } catch (err2) { Logger.log('' + err2); }
    return false;
  }
}


/** One line for the daily digest and for describe_. */
function mailStatusLine_() {
  var mode = mailMode_();
  return 'Mail guard: MAIL_MODE ' + (mailModeIsExplicit_() ? mode : 'unset (dry)') +
         '; ' + mailHeldToday_() + ' message(s) held today; quota left ' +
         MailApp.getRemainingDailyQuota();
}


// ---------------------------------------------------------------------------------------
// Hand functions
// ---------------------------------------------------------------------------------------

/** HAND FUNCTION. Print the mode, today's held count, the memory size and the quota. */
function showMailStatus() {
  var all = PropertiesService.getScriptProperties().getProperties();
  var remembered = 0;
  for (var name in all) if (name.indexOf(MAIL_MEMORY_PREFIX) === 0) remembered += 1;
  Logger.log(mailStatusLine_() + '\n' + remembered + ' message key(s) in the duplicate ' +
             'memory (window ' + mailNumber_('MAIL_DEDUPE_DAYS', MAIL_DEFAULT_DEDUPE_DAYS) +
             ' days); per-run cap ' + mailNumber_('MAIL_MAX_PER_RUN', MAIL_DEFAULT_MAX_PER_RUN) +
             '; quota reserve ' + mailNumber_('MAIL_QUOTA_RESERVE', MAIL_DEFAULT_QUOTA_RESERVE) +
             (mailModeIsExplicit_() ? '' : '\nNOT READY: set MAIL_MODE (live, redirect or dry).'));
}

/** HAND FUNCTION. Send one test message to the first lead, under the rules in force:
 *  in dry mode it is held and says so; in redirect mode it goes to MAIL_REDIRECT_TO. */
function sendMailTest() {
  var result = sendMail_({ to: attentionTo_()[0] || fallbackAddress_(),
                           subject: 'MalAvi: mail guard test',
                           body: '[this is an automatic email]\n\nsendMailTest in the MalAvi ' +
                                 'curation project. ' + mailStatusLine_(),
                           kind: 'lead', key: 'mailtest|' + Date.now(),
                           note: 'sendMailTest' });
  Logger.log(result.sent ? 'Sent to ' + result.to + '.' : 'HELD (' + result.held + ') for ' +
             result.to + '. ' + mailStatusLine_());
}

/** HAND FUNCTION. Prune expired memory now and say how much went. */
function pruneMailMemoryNow() {
  Logger.log('removed ' + pruneMailMemory_() + ' expired propert(y/ies)');
}

/**
 * HAND FUNCTION, dangerous. Forget every sent message: the next request for any of them
 * would be sent again. Only for a rebuilt project whose memory is known to be wrong.
 */
function clearMailMemory() {
  var properties = PropertiesService.getScriptProperties();
  var all = properties.getProperties();
  var removed = 0;
  for (var name in all) {
    if (name.indexOf(MAIL_MEMORY_PREFIX) === 0) { properties.deleteProperty(name); removed += 1; }
  }
  logEvent_('clearMailMemory', 'cleared ' + removed + ' message key(s)');
  Logger.log('cleared ' + removed + ' message key(s)');
}


// ======================================================================================
// FILE: status_sheet.gs
// ======================================================================================

/**
 * The private status sheet: where every submission stands, who owns it, and what was said.
 *
 * WHY THIS EXISTS
 * ---------------
 * Until 2026-10-16 the only record of what a submission was waiting on lived in the review
 * ledger on BIOMIX, and the only record of who had written to a submitter lived in one
 * person's inbox. Reports went to five people and nobody owned them; 000007 and 000009
 * each sat a week with no verdict (results/PLAN_SUBMISSION_SYSTEM_RETHINK_2026-10-14.md,
 * section 2). The curators agreed on 2026-10-15/16 to one assigned reviewer per
 * submission, a two-week clock, and reminders at 7 and 14 days.
 *
 * This file is the shared memory those pieces need. One private Google Sheet, "MalAvi
 * submissions", owned by malaviadmin and shared Viewer with each curator, with these tabs:
 *
 *   Submissions  one row per submission: id, submitter, ASSIGNEE, report, the state and
 *                "waiting on" as last synced from the ledger, verdicts so far, when the
 *                submitter last wrote and was last written to, when the last reminder went
 *   Verdicts     one row per verdict-form response, written the moment it is submitted
 *   Mail         every message in or out that the project saw: inbox triage and sends
 *   Arrivals     one row per submission-form response, before it has an id
 *   Curators     the registry (names, addresses, roles), synced from config/curators.yml
 *   Log          every automatic action, so "why did I get this email" has an answer
 *
 * WHO WRITES WHAT
 * ---------------
 *   notify_on_submission.gs   Arrivals row, on the form trigger
 *   publish_report.gs         Submissions row (report link, submitter, ASSIGNMENT) when a
 *                             report is published; the whole Submissions tab's state
 *                             columns and the Curators tab on the `status` action, which
 *                             the intake cycle sends after every run
 *   notify_on_verdict.gs      Verdicts row, the verdict summary on the Submissions row,
 *                             and the message to the submitter when a flag carries one
 *   inbox_triage.gs           Mail rows and last_from_submitter
 *   daily_clock.gs            last_reminder, Log rows
 *
 * THE SHEET IS A VIEW, NOT THE LEDGER
 * ----------------------------------
 * The rules (which verdict counts, when a hold elapses, which names are reserved) stay in
 * curation/src/malavi_curation/ledger.py. The sheet shows what the ledger last said and
 * what happened in Google since. Where they disagree the ledger is right, and the
 * `synced_at` column says how old the sheet's copy is. The assignee, the mail log and the
 * reminders exist ONLY here: they are Google-side bookkeeping the ledger never sees.
 *
 * PRIVACY
 * -------
 * The sheet carries submitter names and addresses and a verdict's internal note. Every
 * curator already receives all of that by email, so the sheet adds no exposure, but it
 * must never be shared by link and never made public. It is NOT the encrypted board on
 * the public site (status_board.py), which carries no names; that board stays as the
 * curators' password-only view and may be retired later.
 *
 * NOTHING HAPPENS UNTIL STATUS_SHEET_ID IS SET
 * -------------------------------------------
 * Every writer below checks statusSheetEnabled_() first and returns quietly when the
 * property is empty, so the notifiers and the publisher work exactly as before until the
 * sheet exists. Run createStatusSheet() once (as malaviadmin) to make it; it prints the id
 * to put into the STATUS_SHEET_ID Script Property.
 *
 * DATES ARE TEXT
 * --------------
 * Every timestamp is written as an ISO 8601 UTC string into cells formatted as plain
 * text ('@'). Sheets would otherwise parse them into its own date type in the
 * spreadsheet's time zone, and a value read back would no longer compare with what the
 * ledger wrote.
 */

var SETTINGS_NEEDED_STATUS_SHEET = ['STATUS_SHEET_ID', 'ASSIGNEES', 'CURATORS'];

var STATUS_SHEET_TITLE = 'MalAvi submissions';

var TAB_SUBMISSIONS = 'Submissions';
var TAB_VERDICTS = 'Verdicts';
var TAB_MAIL = 'Mail';
var TAB_ARRIVALS = 'Arrivals';
var TAB_CURATORS = 'Curators';
var TAB_LOG = 'Log';

// Column headers, by tab. Everything is addressed by header name, never by letter, so a
// column added by hand at the right end breaks nothing and a header renamed here is a
// visible diff.
var TAB_HEADERS = {};
TAB_HEADERS[TAB_SUBMISSIONS] = [
  'id', 'received', 'submitter_name', 'submitter_email',
  'assignee', 'assigned_at',
  'report_url', 'report_at', 'revision',
  'state', 'waiting_on', 'waiting_since', 'hold_ends', 'embargoed', 'names',
  'verdicts',
  'last_from_submitter', 'last_to_submitter', 'last_reminder',
  'synced_at', 'notes'
];
TAB_HEADERS[TAB_VERDICTS] = [
  'recorded_at', 'id', 'curator', 'action', 'verdict',
  'internal_note', 'message_to_submitter', 'sent_to_submitter_at', 'answers'
];
TAB_HEADERS[TAB_MAIL] = [
  'at', 'direction', 'id', 'from', 'to', 'subject', 'thread_url', 'message_id', 'note',
  // Added 2026-10-16 by mail.gs: what kind of message, the mode it was sent (or held)
  // under, and its duplicate-check key. statusTab_ appends missing headers on first use.
  'kind', 'mode', 'key'
];
TAB_HEADERS[TAB_ARRIVALS] = [
  'form_timestamp', 'submitter_name', 'submitter_email', 'stage', 'files', 'matched_id'
];
// name..synced_at are written by the ledger sync (publish_report.gs statusSync_); the
// last two are edited BY HAND on the sheet and the sync never touches them:
//   away_until  a date (YYYY-MM-DD); assignment skips this curator until then
//   max_open    a number; assignment skips this curator while they hold that many open
//               submissions (Rust's triagebot "capacity" and GitHub's "Busy" flag; see
//               results/RESEARCH_curated_db_practices_2026-10-16.md, item 3)
TAB_HEADERS[TAB_CURATORS] = ['name', 'email', 'role', 'active', 'synced_at',
                             'away_until', 'max_open'];
TAB_HEADERS[TAB_LOG] = ['at', 'function', 'message'];

// The ledger's live states (ledger.py LIVE_STATES). A row whose state is one of these, or
// still blank because the ledger has not synced yet, is "open" for the rotation and the
// clock. Kept in step by hand; the ledger is the authority.
var LIVE_STATES = ['received', 'screening_failed', 'ready_for_review', 'in_review', 'held',
                   'awaiting_submitter', 'approved'];

// How a verdict word is shown on the sheet (the form's labels are long).
var SHEET_VERDICT_WORDS = {
  'Accept': 'accepted',
  'Flag for further review': 'flagged',
  'Reject': 'rejected'
};


// ---------------------------------------------------------------------------------------
// Access
// ---------------------------------------------------------------------------------------

/** True when a status sheet is configured. Every writer checks this first. */
function statusSheetEnabled_() {
  return !!setting_('STATUS_SHEET_ID');
}


/** The spreadsheet. Throws a readable sentence if the id is unset or not openable. */
function statusSpreadsheet_() {
  var id = requireSetting_('STATUS_SHEET_ID');
  try {
    return SpreadsheetApp.openById(id);
  } catch (err) {
    throw new Error('STATUS_SHEET_ID does not open as a spreadsheet this account can ' +
                    'read: ' + err);
  }
}


/** ISO 8601 UTC, to the second, for every timestamp this project writes. */
function isoNow_(date) {
  return Utilities.formatDate(date || new Date(), 'UTC', "yyyy-MM-dd'T'HH:mm:ss'Z'");
}


/** Parse one of our ISO strings (or anything Date understands) to a Date, or null. */
function parseStamp_(text) {
  if (!text) return null;
  if (Object.prototype.toString.call(text) === '[object Date]') return text;
  var parsed = new Date(String(text));
  return isNaN(parsed.getTime()) ? null : parsed;
}


/** Any readable stamp re-emitted in this project's one format (ISO UTC, 'Z'); '' when
 *  unreadable. The ledger writes '+00:00', the sheet writes 'Z'; compared as strings they
 *  must agree (review 2026-10-16, finding 9). */
function normStamp_(text) {
  var parsed = parseStamp_(text);
  return parsed ? isoNow_(parsed) : '';
}


/** Whole days between two stamps, as a number; null when either is unreadable. */
function daysBetween_(earlier, later) {
  var a = parseStamp_(earlier);
  var b = parseStamp_(later || new Date());
  if (!a || !b) return null;
  return Math.floor((b.getTime() - a.getTime()) / 86400000);
}


/**
 * A tab by name, created with its header row if missing. A header present in TAB_HEADERS
 * but absent from the sheet is appended at the right end, so adding a column here never
 * requires touching the live sheet by hand; a column somebody added by hand is left alone.
 */
function statusTab_(name) {
  var spreadsheet = statusSpreadsheet_();
  var sheet = spreadsheet.getSheetByName(name);
  var wanted = TAB_HEADERS[name];
  if (!wanted) throw new Error('no such status tab: ' + name);
  if (!sheet) {
    sheet = spreadsheet.insertSheet(name);
    // Everything as text, so dates and ids stay exactly the strings that were written.
    sheet.getRange(1, 1, sheet.getMaxRows(), Math.max(wanted.length, sheet.getMaxColumns()))
         .setNumberFormat('@');
    sheet.getRange(1, 1, 1, wanted.length).setValues([wanted]).setFontWeight('bold');
    sheet.setFrozenRows(1);
    return sheet;
  }
  var lastColumn = Math.max(sheet.getLastColumn(), 1);
  var present = sheet.getRange(1, 1, 1, lastColumn).getValues()[0]
      .map(function (h) { return String(h).trim(); });
  var missing = wanted.filter(function (h) { return present.indexOf(h) === -1; });
  if (missing.length) {
    // Appended after the LAST used column, not after the count of non-empty headers: a
    // header somebody cleared in the middle must not make a new header land on a column
    // that still holds data (review 2026-10-16, finding 17).
    var start = lastColumn + 1;
    sheet.getRange(1, start, 1, missing.length).setValues([missing]).setFontWeight('bold');
    sheet.getRange(1, start, sheet.getMaxRows(), missing.length).setNumberFormat('@');
  }
  return sheet;
}


/** The header row of a tab as an array of names, with their 1-based column numbers. */
function tabColumns_(sheet) {
  var lastColumn = Math.max(sheet.getLastColumn(), 1);
  var headers = sheet.getRange(1, 1, 1, lastColumn).getValues()[0];
  var columns = {};
  for (var i = 0; i < headers.length; i++) {
    var name = String(headers[i]).trim();
    if (name && !(name in columns)) columns[name] = i + 1;
  }
  return columns;
}


/**
 * Every data row of a tab as an object keyed by header, each with `_row` (its 1-based
 * sheet row). Values come back as strings, trimmed.
 */
function readTable_(name) {
  var sheet = statusTab_(name);
  var columns = tabColumns_(sheet);
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  var width = Math.max(sheet.getLastColumn(), 1);
  var values = sheet.getRange(2, 1, lastRow - 1, width).getValues();
  var rows = [];
  for (var r = 0; r < values.length; r++) {
    var row = { _row: r + 2 };
    var empty = true;
    for (var header in columns) {
      var cell = values[r][columns[header] - 1];
      var text = cell === null || cell === undefined ? '' : String(cell).trim();
      if (Object.prototype.toString.call(cell) === '[object Date]') text = isoNow_(cell);
      row[header] = text;
      if (text) empty = false;
    }
    if (!empty) rows.push(row);
  }
  return rows;
}


/** The first row of `name` whose `column` equals `value`, or null. */
function findRow_(name, column, value) {
  var wanted = String(value || '').trim();
  if (!wanted) return null;
  var rows = readTable_(name);
  for (var i = 0; i < rows.length; i++) {
    if (rows[i][column] === wanted) return rows[i];
  }
  return null;
}


/** Write the given fields (by header name) into one existing row. Unknown headers are
 *  refused loudly rather than dropped: a typo here would otherwise lose data silently. */
function writeFields_(name, rowNumber, fields) {
  var sheet = statusTab_(name);
  var columns = tabColumns_(sheet);
  var width = Math.max(sheet.getLastColumn(), 1);
  // One read and one write for the whole row: a call per cell was 26 round trips per
  // submission and would outrun the caller's timeout (review 2026-10-16, finding 3).
  var range = sheet.getRange(rowNumber, 1, 1, width);
  var values = range.getValues()[0];
  for (var header in fields) {
    if (!(header in columns)) throw new Error(name + ' has no column ' + header);
    var value = fields[header];
    values[columns[header] - 1] = (value === null || value === undefined) ? '' : String(value);
  }
  range.setNumberFormat('@').setValues([values]);
}


/**
 * Create or update MANY Submissions rows in one pass: the tab is read once, existing rows
 * are rewritten one range each, and all new rows go down in a single setValues. For the
 * ledger sync, which touches every row every time. `rowsById` maps id -> fields (same
 * rules as upsertSubmission_: undefined fields are left alone). Returns { written, created }.
 */
function bulkUpsertSubmissions_(rowsById) {
  var sheet = statusTab_(TAB_SUBMISSIONS);
  var columns = tabColumns_(sheet);
  var width = Math.max(sheet.getLastColumn(), 1);
  var lastRow = sheet.getLastRow();
  var existing = lastRow >= 2 ? sheet.getRange(2, 1, lastRow - 1, width).getValues() : [];
  var idColumn = columns.id;
  if (!idColumn) throw new Error('Submissions has no id column');

  var rowIndexById = {};
  for (var r = 0; r < existing.length; r++) {
    var cellId = String(existing[r][idColumn - 1] || '').trim();
    if (cellId && !(cellId in rowIndexById)) rowIndexById[cellId] = r;
  }

  var written = 0, created = 0;
  var appended = [];
  for (var id in rowsById) {
    var fields = rowsById[id];
    if (id in rowIndexById) {
      var index = rowIndexById[id];
      var values = existing[index];
      var changed = false;
      for (var header in fields) {
        if (fields[header] === undefined) continue;
        if (!(header in columns)) throw new Error(TAB_SUBMISSIONS + ' has no column ' + header);
        var text = fields[header] === null ? '' : String(fields[header]);
        if (String(values[columns[header] - 1]) !== text) { values[columns[header] - 1] = text; changed = true; }
      }
      if (changed) {
        sheet.getRange(index + 2, 1, 1, width).setNumberFormat('@').setValues([values]);
      }
      written += 1;
    } else {
      var fresh = [];
      for (var i = 0; i < width; i++) fresh.push('');
      fresh[idColumn - 1] = id;
      for (var h in fields) {
        if (fields[h] === undefined) continue;
        if (!(h in columns)) throw new Error(TAB_SUBMISSIONS + ' has no column ' + h);
        fresh[columns[h] - 1] = fields[h] === null ? '' : String(fields[h]);
      }
      appended.push(fresh);
      written += 1;
      created += 1;
    }
  }
  if (appended.length) {
    sheet.getRange(lastRow + 1, 1, appended.length, width).setNumberFormat('@').setValues(appended);
  }
  return { written: written, created: created };
}


/**
 * Run `work` holding the project's script lock, so two executions (a form trigger, the
 * endpoint, the clock) cannot both append a row for the same id (review 2026-10-16,
 * finding 12). Waits up to 30 s; a lock that cannot be had is an error the caller sees.
 * Not re-entrant: call it at the entry point of an action, never inside a helper.
 */
function withSheetLock_(work) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    return work();
  } finally {
    lock.releaseLock();
  }
}


/** Append one row built from fields by header name. Returns the new row number. */
function appendRow_(name, fields) {
  var sheet = statusTab_(name);
  var columns = tabColumns_(sheet);
  var width = Math.max(sheet.getLastColumn(), 1);
  var values = [];
  for (var i = 0; i < width; i++) values.push('');
  for (var header in fields) {
    if (!(header in columns)) throw new Error(name + ' has no column ' + header);
    var value = fields[header];
    values[columns[header] - 1] = (value === null || value === undefined) ? '' : String(value);
  }
  var rowNumber = sheet.getLastRow() + 1;
  sheet.getRange(rowNumber, 1, 1, width).setNumberFormat('@').setValues([values]);
  return rowNumber;
}


/**
 * Create or update the Submissions row for one id. Returns { row, created }. Fields that
 * are undefined are not touched, so a caller that knows only the report link does not
 * blank the assignee.
 */
function upsertSubmission_(submissionId, fields) {
  var id = String(submissionId || '').trim();
  if (!id) throw new Error('upsertSubmission_ needs a submission id');
  var existing = findRow_(TAB_SUBMISSIONS, 'id', id);
  var clean = {};
  for (var header in fields) {
    if (fields[header] !== undefined) clean[header] = fields[header];
  }
  if (existing) {
    writeFields_(TAB_SUBMISSIONS, existing._row, clean);
    return { row: existing._row, created: false };
  }
  clean.id = id;
  return { row: appendRow_(TAB_SUBMISSIONS, clean), created: true };
}


/** Append a Log row and echo it to the execution log. Never throws: a failed log line
 *  must not stop the action it describes. */
function logEvent_(functionName, message) {
  Logger.log(functionName + ': ' + message);
  if (!statusSheetEnabled_()) return;
  try {
    appendRow_(TAB_LOG, { at: isoNow_(), 'function': functionName, message: message });
  } catch (err) {
    Logger.log('could not write the Log tab: ' + err);
  }
}


/** Record one message, in or out, on the Mail tab. Returns the row number, or 0 when
 *  the write failed or there is no sheet. Never throws. */
function recordMail_(fields) {
  if (!statusSheetEnabled_()) return 0;
  try {
    var row = { at: isoNow_() };
    for (var key in fields) row[key] = fields[key];
    return appendRow_(TAB_MAIL, row);
  } catch (err) {
    Logger.log('could not write the Mail tab: ' + err);
    return 0;
  }
}


/**
 * Send one email through the account and record it on the Mail tab. Every message the
 * project sends to a SUBMITTER goes through here, so the Submissions row can say when
 * they were last written to. Options are passed to GmailApp.sendEmail unchanged, with the
 * sender name defaulting to "MalAvi".
 */
var AUTOMATIC_FOOTER = '(Sent by the MalAvi curation system; a reply reaches the curators.)';

function sendAndRecord_(to, subject, body, options, submissionId, note) {
  // The footer marks the message as ours, so the inbox triage's outgoing pass does not
  // record it a second time as "written by hand" (review 2026-10-16, finding 11). The
  // send itself, and the Mail row, are mail.gs's: mode, duplicate check, caps.
  return sendMail_({ to: to, subject: subject, body: body + '\n\n' + AUTOMATIC_FOOTER,
                     options: options || {}, kind: 'submitter', submissionId: submissionId,
                     note: note || '' });
}


// ---------------------------------------------------------------------------------------
// Names
// ---------------------------------------------------------------------------------------

/** Address -> display name from the Curators tab; the address itself when unknown.
 *  Read once per execution. */
var curatorNameCache_ = null;

function curatorName_(address) {
  var wanted = String(address || '').trim().toLowerCase();
  if (!wanted) return '';
  if (curatorNameCache_ === null) {
    curatorNameCache_ = {};
    if (statusSheetEnabled_()) {
      try {
        var rows = readTable_(TAB_CURATORS);
        for (var i = 0; i < rows.length; i++) {
          if (rows[i].email) curatorNameCache_[rows[i].email.toLowerCase()] = rows[i].name;
        }
      } catch (err) {
        Logger.log('could not read the Curators tab: ' + err);
      }
    }
  }
  return curatorNameCache_[wanted] || address;
}


/** The first (given) name, for a friendly subject line; the whole name if it is one word. */
function firstName_(address) {
  var name = curatorName_(address);
  if (name === address) return address;
  return name.split(/\s+/)[0];
}


// ---------------------------------------------------------------------------------------
// Assignment
// ---------------------------------------------------------------------------------------

/**
 * Who gets the next submission.
 *
 * Least-loaded first: the assignee with the fewest OPEN rows (state blank or live). Ties
 * go to whoever comes next in the ASSIGNEES list after the most recent assignment, so with
 * equal loads it is a plain rotation. A curator whose Curators-tab row says away_until a
 * future date, or whose open count has reached their max_open, is skipped; if that leaves
 * nobody, the skips are ignored rather than leaving a submission unowned. `excluding` is a
 * list of addresses to leave out (the curator being relieved, on reassignment). Nothing
 * here decides who is a curator (config/curators.yml does); it only picks who is asked
 * first.
 */
function nextAssignee_(excluding) {
  var pool = assignees_();
  var skipList = (excluding || []).map(function (a) { return String(a).toLowerCase(); });
  pool = pool.filter(function (a) { return skipList.indexOf(a.toLowerCase()) === -1; });
  if (!pool.length) pool = assignees_();        // better the same person than nobody
  if (!pool.length) throw new Error('ASSIGNEES and CURATORS are both empty; nobody to assign');
  var lower = pool.map(function (a) { return a.toLowerCase(); });
  var limits = curatorLimits_();

  var open = {};
  var latestAt = '';
  var latestWho = '';
  for (var p = 0; p < lower.length; p++) open[lower[p]] = 0;

  var rows = readTable_(TAB_SUBMISSIONS);
  for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    var who = (row.assignee || '').toLowerCase();
    if (!who) continue;
    var isOpen = !row.state || LIVE_STATES.indexOf(row.state) !== -1;
    if (isOpen && who in open) open[who] += 1;
    if (row.assigned_at && row.assigned_at > latestAt) {
      latestAt = row.assigned_at;
      latestWho = who;
    }
  }

  // Who is available today: not away, and under their own limit.
  var today = isoNow_().slice(0, 10);
  var available = [];
  for (var v = 0; v < lower.length; v++) {
    var limit = limits[lower[v]] || {};
    if (limit.away_until && limit.away_until >= today) continue;
    if (limit.max_open !== null && limit.max_open !== undefined &&
        open[lower[v]] >= limit.max_open) continue;
    available.push(v);
  }
  if (!available.length) {
    for (var w = 0; w < lower.length; w++) available.push(w);   // everyone is away: ignore it
  }

  var fewest = Infinity;
  for (var q = 0; q < available.length; q++) {
    fewest = Math.min(fewest, open[lower[available[q]]]);
  }

  // Walk the list starting just after the last person assigned, take the first available
  // curator with the minimum load.
  var start = latestWho ? (lower.indexOf(latestWho) + 1) % lower.length : 0;
  if (start < 0) start = 0;
  for (var step = 0; step < lower.length; step++) {
    var candidate = (start + step) % lower.length;
    if (available.indexOf(candidate) !== -1 && open[lower[candidate]] === fewest) {
      return pool[candidate];
    }
  }
  return pool[available[0]];
}


/** Per-curator limits from the Curators tab: address -> { away_until, max_open }. */
function curatorLimits_() {
  var limits = {};
  try {
    var rows = readTable_(TAB_CURATORS);
    for (var i = 0; i < rows.length; i++) {
      if (!rows[i].email) continue;
      var max = String(rows[i].max_open || '').trim();
      limits[rows[i].email.toLowerCase()] = {
        away_until: String(rows[i].away_until || '').trim().slice(0, 10),
        max_open: /^\d+$/.test(max) ? parseInt(max, 10) : null
      };
    }
  } catch (err) {
    Logger.log('could not read curator limits: ' + err);
  }
  return limits;
}


/**
 * Assign a submission if it has no assignee yet. Returns the assignee's address (existing
 * or new) and whether this call made the assignment. Writes nothing when the sheet is off.
 */
function assignSubmission_(submissionId, fields) {
  if (!statusSheetEnabled_()) return { assignee: '', assigned: false };
  var row = findRow_(TAB_SUBMISSIONS, 'id', submissionId);
  if (row && row.assignee) return { assignee: row.assignee, assigned: false };
  var chosen = nextAssignee_();
  var extra = fields || {};
  extra.assignee = chosen;
  extra.assigned_at = isoNow_();
  upsertSubmission_(submissionId, extra);
  logEvent_('assignSubmission_', submissionId + ' assigned to ' + chosen);
  return { assignee: chosen, assigned: true };
}


/**
 * HAND FUNCTION. Move a submission to another curator: set the two values in the editor's
 * argument-free way by editing the two lines below, run, then put them back; or call it
 * from another function. The new assignee is emailed; the old one and the leads are told.
 */
function reassign() {
  var SUBMISSION_ID = 'MALAVI-SUB-0000-EDITME';
  var NEW_ASSIGNEE = 'someone@example.org';
  reassignSubmission_(SUBMISSION_ID, NEW_ASSIGNEE, 'reassigned by hand');
}


function reassignSubmission_(submissionId, newAssignee, why) {
  var address = String(newAssignee || '').trim();
  var known = curators_().concat(assignees_()).map(function (a) { return a.toLowerCase(); });
  if (known.indexOf(address.toLowerCase()) === -1) {
    throw new Error(address + ' is in neither CURATORS nor ASSIGNEES; add them there (and ' +
                    'to config/curators.yml) first');
  }
  var row = findRow_(TAB_SUBMISSIONS, 'id', submissionId);
  if (!row) throw new Error('no Submissions row for ' + submissionId);
  var previous = row.assignee;
  writeFields_(TAB_SUBMISSIONS, row._row, { assignee: address, assigned_at: isoNow_(),
                                            last_reminder: '' });
  logEvent_('reassignSubmission_', submissionId + ': ' + (previous || 'nobody') + ' -> ' +
            address + ' (' + (why || 'no reason given') + ')');

  var subject = 'MalAvi: ' + submissionId + ' is now assigned to you';
  var body = [
    '[this is an automatic email]',
    '',
    'Submission ' + submissionId + ' has been reassigned to you' +
      (previous ? ' (it was with ' + curatorName_(previous) + ')' : '') + '.',
    '',
    row.report_url ? 'Report: ' + row.report_url : 'The report link is on the status sheet.',
    '',
    'The two-week clock restarts today. Record your verdict on the form linked from the ' +
      'report; the other curators remain in copy.',
    '',
    '--', 'Confidential. A submission may contain unpublished sequences.'
  ].join('\n');
  var stamp = isoNow_();
  sendMail_({ to: address, subject: subject, body: body, kind: 'curator',
              submissionId: submissionId, key: 'reassign|' + submissionId + '|' + stamp,
              note: 'reassigned (' + (why || 'no reason given') + ')' });

  var told = attentionTo_().slice();
  if (previous && told.indexOf(previous) === -1) told.push(previous);
  for (var i = 0; i < told.length; i++) {
    if (told[i].toLowerCase() === address.toLowerCase()) continue;
    sendMail_({ to: told[i], subject: 'MalAvi: ' + submissionId + ' reassigned to ' +
                curatorName_(address),
                body: '[this is an automatic email]\n\n' + submissionId + ' is now assigned to ' +
                      curatorName_(address) + (previous ? ', previously ' + curatorName_(previous) : '') +
                      '. ' + (why || '') + '\n',
                kind: 'curator', submissionId: submissionId,
                key: 'reassign-told|' + submissionId + '|' + stamp, note: 'reassignment notice' });
  }
}


// ---------------------------------------------------------------------------------------
// Verdict summary on the Submissions row
// ---------------------------------------------------------------------------------------

/** Rebuild the one-line verdict summary for a submission from the Verdicts tab. */
function verdictSummary_(submissionId) {
  var rows = readTable_(TAB_VERDICTS);
  var parts = [];
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].id !== submissionId || !rows[i].verdict) continue;
    parts.push((SHEET_VERDICT_WORDS[rows[i].verdict] || rows[i].verdict) + ' by ' +
               firstName_(rows[i].curator) + ' ' + String(rows[i].recorded_at).slice(0, 10));
  }
  return parts.join('; ');
}


// ---------------------------------------------------------------------------------------
// Setup and inspection (run by hand)
// ---------------------------------------------------------------------------------------

/**
 * Create the status spreadsheet, once. Refuses if STATUS_SHEET_ID is already set, so it
 * cannot make a second sheet by accident. Prints the id to put into the property, and
 * shares the sheet Viewer with every address in CURATORS (never by link).
 */
function createStatusSheet() {
  if (setting_('STATUS_SHEET_ID')) {
    throw new Error('STATUS_SHEET_ID is already set (' + setting_('STATUS_SHEET_ID') +
                    '). To start over, clear the property first.');
  }
  var curators = curators_();
  if (!curators.length) throw new Error('set CURATORS first, so the sheet can be shared');

  var spreadsheet = SpreadsheetApp.create(STATUS_SHEET_TITLE);
  var id = spreadsheet.getId();
  // Set the property NOW so statusTab_ can find the sheet while we build the tabs.
  PropertiesService.getScriptProperties().setProperty('STATUS_SHEET_ID', id);
  var names = [TAB_SUBMISSIONS, TAB_VERDICTS, TAB_MAIL, TAB_ARRIVALS, TAB_CURATORS, TAB_LOG];
  for (var i = 0; i < names.length; i++) statusTab_(names[i]);
  var first = spreadsheet.getSheets()[0];
  if (first.getName() !== TAB_SUBMISSIONS && names.indexOf(first.getName()) === -1) {
    spreadsheet.deleteSheet(first);          // the default "Sheet1"
  }
  for (var c = 0; c < curators.length; c++) {
    try {
      spreadsheet.addViewer(curators[c]);
    } catch (err) {
      Logger.log('could not share with ' + curators[c] + ': ' + err);
    }
  }
  logEvent_('createStatusSheet', 'created; shared Viewer with ' + curators.length +
            ' curator(s)');
  Logger.log('Created "' + STATUS_SHEET_TITLE + '": ' + spreadsheet.getUrl());
  Logger.log('STATUS_SHEET_ID has been set to ' + id + ' in this project\'s Script ' +
             'Properties. Record it in CUSTODY_PRIVATE.md. Next: run installAllTriggers.');
}


/** Print the Submissions tab, one line each, newest first. Sends nothing. */
function showStatusSheet() {
  if (!statusSheetEnabled_()) { Logger.log('STATUS_SHEET_ID is not set.'); return; }
  var rows = readTable_(TAB_SUBMISSIONS);
  Logger.log(rows.length + ' submission row(s); sheet ' + statusSpreadsheet_().getUrl());
  for (var i = rows.length - 1; i >= 0; i--) {
    var r = rows[i];
    Logger.log([r.id, r.state || '(not synced)', 'waiting on ' + (r.waiting_on || '?'),
                'assigned ' + (r.assignee ? curatorName_(r.assignee) : 'nobody'),
                r.verdicts || 'no verdicts', 'synced ' + (r.synced_at || 'never')]
               .join(' | '));
  }
}


// ======================================================================================
// FILE: publish_report.gs
// ======================================================================================

/**
 * Receive a curator report from BIOMIX, put it in Drive, and tell the curators.
 *
 * WHY THIS EXISTS RATHER THAN A SERVICE ACCOUNT
 * ---------------------------------------------
 * The plan was for a service account to upload the PDF straight to Drive. It was tested
 * before being built and it cannot work:
 *
 *     HTTP 403  storageQuotaExceeded
 *     "Service Accounts do not have storage quota. Leverage shared drives, or use
 *      OAuth delegation instead."
 *
 * A file created by a service account is owned by that service account no matter which
 * folder it goes in, and a service account has no Drive storage. Shared Drives would fix
 * it and need Google Workspace; malaviadmin@gmail.com is a consumer account. So the write
 * has to be performed by a human account, and this script runs as one.
 *
 * It also removes a wart from the original design. That version needed a second script on
 * a timer to notice new files and email about them, so a report could sit unannounced for
 * up to an hour. Here the write and the email are one request.
 *
 * THE SECURITY POSITION, STATED HONESTLY
 * --------------------------------------
 * This must be deployed "Anyone can access", because BIOMIX has no Google credential to
 * present. The endpoint is therefore public, and the shared secret is all that stands in
 * front of it. That is weaker than a key and it is a deliberate trade, so the blast radius
 * is kept small:
 *
 *   - Every request must carry an HMAC-SHA256 signature over the exact body, in ?sig=.
 *     Nothing is parsed or written before that is verified.
 *   - The signed body carries a timestamp; anything older than MAX_AGE_SECONDS is refused,
 *     so a captured request is not a permanent key.
 *   - The script can do exactly one thing: write a PDF into REPORTS_FOLDER_ID and email
 *     the curators. It never reads a submission, never lists another folder, and has no
 *     path that returns Drive contents to the caller.
 *
 * Somebody who steals the secret can put a PDF in the reports folder and cause an email.
 * That is recoverable. They cannot read submitter data, which is the thing worth guarding.
 *
 * INSTALLING IT
 * -------------
 *   1. Sign in as malaviadmin@gmail.com. Create the Drive folder that will hold curator
 *      reports. Share it as Viewer with each curator's address. Do NOT link-share it:
 *      undoing link-sharing was the entire point of the 2026-08-06 change.
 *   2. script.google.com > New project, name it "MalAvi report publisher". Paste this
 *      file in, and paste settings.gs in as a second file (Files > "+" > Script,
 *      named "settings").
 *   3. Generate a secret on BIOMIX:  openssl rand -hex 32
 *      Save it there at ~/.config/malavi/report_secret.txt (chmod 600).
 *   4. Project Settings (gear) > Script Properties > Add: REPORTS_FOLDER_ID (the folder
 *      id out of its URL), SHARED_SECRET (the same value as on BIOMIX), CURATORS and
 *      ATTENTION_TO (comma-separated addresses, matching config/curators.yml). No live
 *      value is ever written in this file.
 *   5. Run `showSettings` until it says READY.
 *   6. Run `testSetup` once. It checks the folder and the secret without needing a
 *      request, and emails you a sample notification so you can see what a curator gets.
 *      Authorize when asked.
 *   7. Deploy > New deployment > Web app. Execute as: **Me**. Who has access: **Anyone**.
 *      Copy the /exec URL into google.report_endpoint in config/project.yml.
 *   8. From BIOMIX:  curation/publish_report.py --check
 *      then:         curation/publish_report.py <submission_id>
 *
 * THE PERMISSION THAT DOES NOT AUTO-DETECT
 * ----------------------------------------
 * Apps Script normally works out which permissions a script needs by reading it. It gets
 * this one wrong, and the way it fails is nasty: the FIRST publish of any report works,
 * because creating a file uses DriveApp, and every publish AFTERWARDS fails, because
 * replacing a file's contents uses UrlFetchApp -- which needs
 * https://www.googleapis.com/auth/script.external_request, and that scope does not get
 * requested. So the failure appears the first time somebody corrects a report, which could
 * be months later, and the error names a permission rather than a cause:
 *
 *     You do not have permission to call UrlFetchApp.fetch
 *
 * The cure is to stop letting it guess. curation/apps_script/appsscript.json in this
 * repository lists the three scopes this script actually needs; paste it over the manifest
 * in the Apps Script project (Project Settings > "Show appsscript.json manifest file in
 * editor"), then run any function once to re-authorize, then push a new version of the
 * deployment. Found the hard way on 2026-08-08, on the second publish.
 *
 * RE-DEPLOYING
 * ------------
 * Editing this file changes nothing on its own. Deploy > Manage deployments > edit the
 * existing deployment > Version: New version. Creating a *new* deployment instead gives a
 * new URL and quietly leaves the old one running the old code, which is the single easiest
 * way to spend an afternoon debugging a change that was never live.
 *
 * Since 2026-10-14 pasting this file over the live one is safe: the live values are
 * Script Properties, not code. Paste, run showSettings (READY), then push a new version.
 *
 * ONE PROJECT, AND WHAT WAS ADDED ON 2026-10-16
 * ---------------------------------------------
 * This project now also holds the other .gs files of this directory (settings.gs explains
 * the merge). Two things changed here:
 *   - When a report is published for the first time, the submission is ASSIGNED to one
 *     curator in rotation (status_sheet.gs). The assignee's email says "needs your
 *     verdict"; the others are told who has it and that they are in copy. The payload may
 *     carry the submitter's name and address and the revision, which go onto the status
 *     sheet so the verdict trigger and the inbox triage can reach the submitter. A
 *     corrected report (action "updated") keeps its assignee.
 *   - A `status` action: the intake cycle sends the ledger's view of every submission and
 *     the curator registry after each run (curation/push_status.py), and this writes them
 *     to the status sheet. Without STATUS_SHEET_ID both are no-ops and the publisher
 *     behaves as it did before.
 * No value is read from Script Properties at the top of this file any more: every read
 * is a function call at the moment of use (see LOAD ORDER in settings.gs).
 */

// ---------------------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------------------

// The Drive folder that holds curator reports. Shared as Viewer with each curator.
// The live value is "MalAvi curator reports" under malaviadmin@gmail.com, created
// 2026-08-08, and it is recorded in CUSTODY_PRIVATE.md rather than here. A folder id is
// not a credential -- without permission on the folder it gets you a 404 -- but this file
// is published, and printing the id would mean that any future mistake in the folder's
// sharing settings is instantly exploitable by anyone who read the repository.
// Since 2026-10-14 every live value is a Script Property (settings.gs, pasted into this
// project as a second file); this code holds none, so pasting it over the live script
// blanks nothing. Set them under Project Settings > Script Properties and run
// showSettings(), then testSetup().
var SETTINGS_NEEDED_PUBLISHER = ['REPORTS_FOLDER_ID', 'SHARED_SECRET', 'CURATORS',
                                 'ATTENTION_TO', 'STATUS_SHEET_ID'];
function reportsFolderId_() { return setting_('REPORTS_FOLDER_ID'); }

// Must equal the contents of ~/.config/malavi/report_secret.txt on BIOMIX.
function sharedSecret_() { return setting_('SHARED_SECRET'); }

// Who is told when a report is ready: curators_() in settings.gs (the CURATORS Script
// Property). Keep in step with config/curators.yml, which is the record of who is a
// curator; the list only decides who gets told.

// Must match MAX_AGE_SECONDS in curation/src/malavi_curation/report_delivery.py.
var MAX_AGE_SECONDS = 600;

// Apps Script will happily accept a huge body and then fail obscurely. Refuse early.
var MAX_PDF_BYTES = 8 * 1024 * 1024;

// How long this script remembers that a name confirmation went out, so that the same one
// is not mailed twice. The retry that matters arrives the next day (BIOMIX records the
// send only after the reply, so a request that timed out after the mail had gone is sent
// again by the next run); 30 days covers a run that was not made for weeks.
var CONFIRMATION_MEMORY_DAYS = 30;
var CONFIRMATION_KEY_PREFIX = 'confirmed:';

// The date of the last change to what this script DOES, and every action it answers.
//
// These exist for one question that had no answer before 2026-10-02: "is the deployed
// script the one in the repository?" Editing this file changes nothing until a new version
// of the deployment is pushed (see RE-DEPLOYING above), and nothing reported which code
// was live, so a change could sit undeployed for weeks while the Python side believed it
// was in service. The `describe` action returns both values to a signed request, and
// `curation/publish_report.py --check --live` compares them with this file.
//
// Change CODE_VERSION whenever an action is added or its behavior changes. A request for
// an action missing from the deployed script falls through to the PDF branch and is
// refused there ("unusable filename") without writing or emailing anything, which is how
// the Python side recognizes a deployment older than `describe` itself.
var CODE_VERSION = '2026-10-16-mailguard';
var ACTIONS = ['publish_report', 'confirm_names', 'decline_notice', 'verdict_notice',
               'attention_notice', 'describe', 'status'];

// Who is told when an unattended run of the intake cycle needs a person
// (curation/intake_cycle.py). The lead curators, not every curator: the message is
// program output and can name a submitter or quote a response that could not be parsed.
// The ATTENTION_TO Script Property, read through attentionTo_() in settings.gs.
var MAX_ATTENTION_BODY = 20000;


// ---------------------------------------------------------------------------------------
// The endpoint
// ---------------------------------------------------------------------------------------

/**
 * Handle one publish request.
 *
 * Every failure returns JSON with ok:false and a reason the Python side can print. It
 * never throws out of this function: an uncaught error in a web app returns an HTML error
 * page, which the caller cannot parse and which tells whoever is debugging nothing.
 */
function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      return reply_({ ok: false, error: 'empty request body' });
    }
    var body = e.postData.contents;

    // 0. No secret configured means no request can be genuine. Refuse before any
    //    signature arithmetic: an HMAC over an empty key is still a valid HMAC, and a
    //    freshly pasted project with its Script Properties not yet set must not accept
    //    anything from anyone.
    if (!sharedSecret_()) {
      return reply_({ ok: false, error: 'endpoint not configured (SHARED_SECRET unset)' });
    }

    // 1. Signature, before anything else touches the body.
    var provided = (e.parameter && e.parameter.sig) || '';
    if (!provided) {
      return reply_({ ok: false, error: 'no signature' });
    }
    if (!signatureValid_(body, provided)) {
      return reply_({ ok: false, error: 'bad signature' });
    }

    // 2. Only now is the body worth parsing.
    var payload;
    try {
      payload = JSON.parse(body);
    } catch (err) {
      return reply_({ ok: false, error: 'body is not JSON' });
    }

    // 3. Freshness, so a captured request cannot be replayed.
    var age = Math.abs((Date.now() / 1000) - Number(payload.issued_at || 0));
    if (!payload.issued_at || age > MAX_AGE_SECONDS) {
      return reply_({ ok: false, error: 'stale request (age ' + Math.round(age) + 's)' });
    }

    // 3b. The request may ask for a MORE restrictive mail mode than the project's own
    //     (the maintainer reading the mail himself); never a less restrictive one, and
    //     never an address: mail.gs takes the redirect address from MAIL_REDIRECT_TO only.
    requestMailMode_(payload.mail_mode);

    // 4. Which of the two jobs is this? Routing happens only after the signature and the
    //    freshness check, so an unsigned request never reaches either branch.
    var action = String(payload.action || 'publish_report');
    if (action === 'confirm_names') {
      return reply_(withMailStatus_(confirmNames_(payload)));
    }
    if (action === 'decline_notice') {
      return reply_(withMailStatus_(declineNotice_(payload)));
    }
    if (action === 'verdict_notice') {
      return reply_(withMailStatus_(verdictNotice_(payload)));
    }
    if (action === 'attention_notice') {
      return reply_(withMailStatus_(attentionNotice_(payload)));
    }
    if (action === 'describe') {
      return reply_(describe_());
    }
    if (action === 'status') {
      return reply_(statusSync_(payload));
    }

    // 5. The file itself.
    var filename = String(payload.filename || '');
    if (!filename || filename.indexOf('/') !== -1 || filename.slice(-4) !== '.pdf') {
      return reply_({ ok: false, error: 'unusable filename' });
    }
    var bytes = Utilities.base64Decode(payload.pdf_b64 || '');
    if (!bytes.length) {
      return reply_({ ok: false, error: 'empty PDF' });
    }
    if (bytes.length > MAX_PDF_BYTES) {
      return reply_({ ok: false, error: 'PDF too large (' + bytes.length + ' bytes)' });
    }

    // Verify the content matches what was signed. The signature covers the base64, so this
    // is belt and braces -- but it is the check that catches a truncated upload, which is
    // the failure that would otherwise put a half-rendered report in front of a curator.
    var digest = hex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, bytes));
    if (payload.sha256 && payload.sha256 !== digest) {
      return reply_({ ok: false, error: 'checksum mismatch' });
    }

    // A report nobody would be told about must not be written: the Python side records
    // a publish as announced, and --all-pending never sends it again. (Review of
    // 2026-10-14: with the lists in Script Properties, an unset or misspelled CURATORS
    // is an empty list, and an empty loop used to look like success.)
    if (payload.notify && !curators_().length) {
      return reply_({ ok: false, error: 'CURATORS is not set (Script Properties); ' +
                                        'nothing written, nobody emailed' });
    }

    var blob = Utilities.newBlob(bytes, 'application/pdf', filename);
    var written = writeOrUpdate_(filename, blob);

    // 5a. The status sheet: the report link, the submitter, and -- for a first report --
    //     the assignment. A sheet failure must not undo a publish that already happened,
    //     so it is caught and reported in the reply; the report is announced either way.
    var submissionId = String(payload.submission_id || '');
    var assignment = { assignee: '', assigned: false, error: '' };
    try {
      assignment = statusSheetEnabled_()
          ? withSheetLock_(function () { return recordReport_(submissionId, payload, written); })
          : recordReport_(submissionId, payload, written);
    } catch (err) {
      assignment.error = String(err && err.message ? err.message : err);
      Logger.log('status sheet not updated for ' + submissionId + ': ' + assignment.error);
    }

    // 5b. Tell the curators, unless the caller asked us not to (a re-send during debugging).
    var notified = 0;
    if (payload.notify) {
      notified = notifyCurators_(submissionId, written, assignment.assignee,
                                 String(payload.mail_key || ''), payload.announced_before);
    }

    return reply_(withMailStatus_({
      ok: true,
      fileId: written.id,
      url: written.url,
      action: written.action,
      sha256: digest,
      notified: notified,
      // What became of the notice: emailed, already_sent (every recipient had it), held
      // (the mode, a cap or the quota), or none (notify was false).
      notice: !payload.notify ? 'none' : noticeOutcome_(notified),
      assignee: assignment.assignee,
      assigned: assignment.assigned,
      sheet_error: assignment.error
    }));

  } catch (err) {
    // Anything unforeseen still comes back as JSON, with enough to act on.
    return reply_({ ok: false, error: 'unhandled: ' + (err && err.message ? err.message : err) });
  }
}


/**
 * Add what the mail guard did in this execution to a reply: how many messages were
 * sent, which were held and why, and the mode in force. The Python side raises MailHeld
 * on any held message that is not a duplicate, so nothing is recorded as sent that was
 * not (review of 2026-10-16, finding 5).
 */
function withMailStatus_(result) {
  if (result && result.ok) {
    result.sent = mailRunCount_;
    result.held = mailRunHeld_.slice();
    result.mail_mode = mailMode_();
  }
  return result;
}

/** 'emailed' when something was sent, 'already_sent' when everything held was a
 *  duplicate, 'held' otherwise. */
function noticeOutcome_(sent) {
  if (sent > 0) return 'emailed';
  if (!mailRunHeld_.length) return 'held';
  for (var i = 0; i < mailRunHeld_.length; i++) {
    if (mailRunHeld_[i].reason !== 'duplicate') return 'held';
  }
  return 'already_sent';
}


/**
 * Tell the lead curators that the intake cycle needs a person.
 *
 * The same rule as verdictNotice_: the text comes from the maintainer's side, which is
 * where the programs ran, and THE RECIPIENTS DO NOT. They are ATTENTION_TO, so the secret's
 * holder still cannot use this endpoint to send mail to anyone of their choosing.
 */
function attentionNotice_(payload) {
  var subject = String(payload.subject || '').trim();
  var body = String(payload.body || '').trim();
  if (!subject || !body) {
    return { ok: false, error: 'an attention notice needs both a subject and a body' };
  }
  if (body.length > MAX_ATTENTION_BODY + 200) {
    return { ok: false, error: 'attention notice too long (' + body.length + ' characters)' };
  }
  var leads = settingList_('ATTENTION_TO');
  if (!leads.length) {
    return { ok: false, error: 'ATTENTION_TO is not set (Script Properties); nobody emailed' };
  }
  var sent = 0;
  for (var i = 0; i < leads.length; i++) {
    var result = sendMail_({ to: leads[i], subject: subject, body: body, kind: 'lead',
                             key: String(payload.mail_key || ''), note: 'attention notice' });
    if (result.sent) sent += 1;
  }
  return { ok: true, action: noticeOutcome_(sent), notified: sent };
}


/**
 * Say which code is deployed. Reads nothing, writes nothing and emails nobody.
 *
 * `curators` and `attention_to` are how many addresses the live CURATORS and ATTENTION_TO
 * properties hold. Counts and never the addresses: enough to see that appointing a curator reached this script (the second
 * of the three grants in RUNBOOK section 3ca) without the endpoint ever listing who they
 * are.
 */
function describe_() {
  return {
    ok: true,
    action: 'described',
    code_version: CODE_VERSION,
    actions: ACTIONS,
    curators: curators_().length,
    attention_to: settingList_('ATTENTION_TO').length,
    status_sheet: statusSheetEnabled_(),
    // The mail guard (mail.gs, 2026-10-16): the mode in force and today's held count, so
    // the intake cycle can say before sending anything whether it would be sent.
    mail_mode: mailMode_(),
    mail_mode_explicit: mailModeIsExplicit_(),
    held_today: mailHeldToday_()
  };
}


// ---------------------------------------------------------------------------------------
// The status sheet (status_sheet.gs): assignment at publish time, and the `status` action
// ---------------------------------------------------------------------------------------

/**
 * Put the report on the Submissions row and, for a first report, assign the submission.
 *
 * Returns { assignee, assigned }. With no status sheet configured it returns empty values
 * and touches nothing, so the publisher behaves exactly as before 2026-10-16.
 *
 * The payload's `assign` defaults to true; the Python side sends false when it re-sends a
 * report during debugging (--no-notify) so a test publish does not hand somebody work.
 * An "updated" report (a corrected one) never reassigns: the person who has it keeps it.
 */
function recordReport_(submissionId, payload, written) {
  if (!statusSheetEnabled_() || !submissionId) return { assignee: '', assigned: false };
  var fields = {
    report_url: written.url,
    report_at: isoNow_(),
    submitter_name: payload.submitter_name !== undefined ? String(payload.submitter_name) : undefined,
    submitter_email: payload.submitter_email !== undefined ? String(payload.submitter_email) : undefined,
    received: payload.received_at !== undefined ? String(payload.received_at) : undefined,
    revision: payload.revision !== undefined ? String(payload.revision) : undefined
  };
  var wantAssignment = payload.assign === undefined ? true : !!payload.assign;
  if (wantAssignment && payload.notify) {
    // assignSubmission_ upserts the row with these fields and the assignee together.
    return assignSubmission_(submissionId, fields);
  }
  upsertSubmission_(submissionId, fields);
  var row = findRow_(TAB_SUBMISSIONS, 'id', submissionId);
  return { assignee: row && row.assignee ? row.assignee : '', assigned: false };
}


/**
 * The `status` action: the ledger's view of every submission, and the curator registry,
 * written onto the sheet. Sent by curation/push_status.py at the end of each intake cycle.
 *
 * Only the columns the ledger owns are written (state, waiting_on, waiting_since,
 * hold_ends, embargoed, names, revision, received, submitter, synced_at). The assignee,
 * the mail columns and the reminders are Google-side and are never overwritten here.
 * A row the ledger no longer lists (excluded or purged) is left as it is; its synced_at
 * stops moving, which the daily clock reports.
 */
function statusSync_(payload) {
  if (!statusSheetEnabled_()) {
    return { ok: false, error: 'STATUS_SHEET_ID is not set (Script Properties); nothing ' +
                               'to write to. Run createStatusSheet in the project.' };
  }
  var rows = payload.rows;
  if (Object.prototype.toString.call(rows) !== '[object Array]') {
    return { ok: false, error: 'a status payload needs a rows array' };
  }
  return withSheetLock_(function () { return statusSyncLocked_(rows, payload.curators); });
}


function statusSyncLocked_(rows, curatorRows) {
  var stamp = isoNow_();
  var byId = {};
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i] || {};
    var id = String(r.id || '').trim();
    if (!/^MALAVI-SUB-\d{4}-\d{6}$/.test(id)) continue;      // never write a junk row
    // Every stamp re-emitted in the sheet's one format (normStamp_), so the ledger's
    // '+00:00' and the sheet's 'Z' never sit in the same column.
    byId[id] = {
      received: r.received !== undefined ? normStamp_(r.received) || String(r.received) : undefined,
      submitter_name: r.submitter_name !== undefined ? String(r.submitter_name) : undefined,
      submitter_email: r.submitter_email !== undefined ? String(r.submitter_email) : undefined,
      revision: r.revision !== undefined ? String(r.revision) : undefined,
      state: String(r.state || ''),
      waiting_on: String(r.waiting_on || ''),
      waiting_since: r.waiting_since ? normStamp_(r.waiting_since) : '',
      hold_ends: r.hold_ends ? normStamp_(r.hold_ends) : '',
      embargoed: r.embargoed ? 'yes' : 'no',
      names: r.names !== undefined ? String(r.names) : undefined,
      report_url: r.report_url ? String(r.report_url) : undefined,
      report_at: r.report_at ? normStamp_(r.report_at) : undefined,
      synced_at: stamp
    };
  }
  // One read of the tab, one write per changed row, one write for all new rows.
  var result = bulkUpsertSubmissions_(byId);
  var written = result.written;
  var created = result.created;

  var curatorsWritten = 0;
  if (Object.prototype.toString.call(curatorRows) === '[object Array]' && curatorRows.length) {
    // One row per address, matched by email: the registry columns are rewritten, the
    // hand-edited ones (away_until, max_open) are kept. A curator no longer in the
    // registry keeps their row with active = no.
    var existing = readTable_(TAB_CURATORS);
    var seen = {};
    for (var c = 0; c < curatorRows.length; c++) {
      var person = curatorRows[c] || {};
      var address = String(person.email || '').trim();
      if (!address) continue;
      seen[address.toLowerCase()] = true;
      var fields = { name: String(person.name || ''), email: address,
                     role: String(person.role || ''), active: person.active ? 'yes' : 'no',
                     synced_at: stamp };
      var match = null;
      for (var e = 0; e < existing.length; e++) {
        if ((existing[e].email || '').toLowerCase() === address.toLowerCase()) { match = existing[e]; break; }
      }
      if (match) writeFields_(TAB_CURATORS, match._row, fields);
      else appendRow_(TAB_CURATORS, fields);
      curatorsWritten += 1;
    }
    for (var g = 0; g < existing.length; g++) {
      if (existing[g].email && !seen[existing[g].email.toLowerCase()] && existing[g].active !== 'no') {
        writeFields_(TAB_CURATORS, existing[g]._row, { active: 'no', synced_at: stamp });
      }
    }
    curatorNameCache_ = null;
  }

  logEvent_('statusSync_', written + ' submission row(s) synced (' + created + ' new), ' +
            curatorsWritten + ' curator(s)');
  return { ok: true, action: 'synced', rows: written, created: created,
           curators: curatorsWritten, synced_at: stamp };
}


/**
 * Write the report, replacing the previous version *in place* if there is one.
 *
 * Idempotency is the point. A corrected report must land on the same file id, because the
 * link in a curator's inbox points at that id. Creating a second file would leave the
 * curator reading a superseded report with no indication that it was superseded -- the
 * worst outcome this whole path can produce.
 *
 * DriveApp cannot replace binary content, so the update goes through the Drive REST API
 * with this script's own OAuth token. Creation stays on DriveApp, which is simpler and has
 * no such limitation.
 */
function writeOrUpdate_(filename, blob) {
  var folder = DriveApp.getFolderById(reportsFolderId_());
  var existing = folder.getFilesByName(filename);

  if (existing.hasNext()) {
    var file = existing.next();
    var id = file.getId();
    var response = UrlFetchApp.fetch(
      'https://www.googleapis.com/upload/drive/v3/files/' + id + '?uploadType=media',
      {
        method: 'patch',
        contentType: 'application/pdf',
        payload: blob.getBytes(),
        headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
        muteHttpExceptions: true
      });
    if (response.getResponseCode() !== 200) {
      throw new Error('update failed: HTTP ' + response.getResponseCode() + ' ' +
                      response.getContentText().slice(0, 200));
    }
    return { id: id, url: file.getUrl(), action: 'updated' };
  }

  var created = folder.createFile(blob);
  return { id: created.getId(), url: created.getUrl(), action: 'created' };
}


/**
 * Tell a submitter which lineage names are theirs, once a curator has approved them.
 *
 * WHY THIS IS AUTOMATED AND THE REST OF THE SUBMITTER CORRESPONDENCE IS NOT
 * ------------------------------------------------------------------------
 * The MalAvi site tells every visitor, in the name checker, that a curator will confirm
 * their proposed name and that they should wait for that before depositing in GenBank.
 * That promise was kept by somebody remembering to write an email. A submitter who gives
 * up waiting deposits the wrong name, which is the exact failure the two-stage submission
 * process exists to prevent -- so this one message is worth automating and the rest are
 * not.
 *
 * WHEN IT FIRES, AND WHY NOT SOONER
 * ---------------------------------
 * Only after a curator has approved AND the publish hold has elapsed with no objection
 * standing. Not at screening: the name is derived from the host species, which is the
 * single thing curators most often correct, so a name confirmed by machine could be
 * withdrawn by a person. Not at approval either: the hold exists precisely so a second
 * curator can still object, and a confirmation sent into that window could be retracted.
 * A slow email is recoverable. A retracted lineage name, already in a manuscript, is not.
 *
 * WHAT IT MUST SAY
 * ----------------
 * The granted names, and -- separately and unmissably -- any name that CHANGED from what
 * was proposed. A submitter who proposed TUMIG06 and was granted TUMIG25 has to see that,
 * because the granted name is the one that goes in the paper and in GenBank.
 */
function confirmNames_(payload) {
  var to = String(payload.to || '');
  if (to.indexOf('@') === -1) {
    return { ok: false, error: 'no usable submitter address' };
  }
  var names = payload.names || [];
  if (!names.length) {
    return { ok: false, error: 'no names to confirm' };
  }

  // Sent once. BIOMIX writes its "already told them" record only after this reply
  // arrives, so a request that timed out on its side AFTER the mail had gone is sent
  // again by the next run -- and a second "your names are confirmed" invites the reader
  // to look for a difference that is not there. The key is the submission, the address
  // and the names, which is what makes two requests the same message; see
  // confirmationKey_. Checked before composing anything, and recorded only after the
  // mail has actually gone.
  var key = confirmationKey_(payload);
  if (alreadyConfirmed_(key)) {
    return { ok: true, action: 'already_sent', notified: 0 };
  }

  var corrections = payload.corrections || {};
  var changed = [];
  for (var proposed in corrections) {
    if (corrections.hasOwnProperty(proposed) && corrections[proposed] !== proposed) {
      changed.push('    ' + proposed + '  ->  ' + corrections[proposed]);
    }
  }

  var who = String(payload.submitter_name || '').trim();
  var lines = [
    '[this is an automatic email]',
    '',
    who ? 'Dear ' + who + ',' : 'Hello,',
    '',
    'This is an automatic message from MalAvi, sent once a curator has approved your',
    'submission. Replies go straight to the curators, so if anything below looks wrong,',
    'or you have a question, just reply to this email.',
    '',
    'A MalAvi curator has reviewed your submission and confirmed the lineage names below.',
    'These are the names to use in your manuscript and when you deposit the sequences in',
    'GenBank, so that the same name appears in all three places.',
    '',
    'Confirmed lineage names:'
  ];
  for (var i = 0; i < names.length; i++) {
    lines.push('    ' + names[i]);
  }

  if (changed.length) {
    lines.push('');
    lines.push('PLEASE NOTE -- the following names are NOT the ones you proposed. The name');
    lines.push('you proposed was already in use in MalAvi, so a free one was assigned:');
    lines.push('');
    lines = lines.concat(changed);
    lines.push('');
    lines.push('Use the name on the right.');
  }

  if (payload.reference) {
    lines.push('');
    lines.push('Submission: ' + payload.reference);
  }

  // What happens to the RECORDS, told from what the submitter actually selected rather
  // than as an "if you asked us to..." conditional the reader has to resolve themselves.
  //
  // The two booleans are decided in Python (form_metadata.records_are_held and
  // records_were_included) and arrive already settled. Deciding them here would put an
  // untested branch in charge of whether somebody is told their unpublished records are
  // about to be published.
  var selections = payload.selections || {};
  var stage = String(selections.stage || '').trim();
  var sending = String(selections.sending || '').trim();

  if (stage || sending) {
    lines.push('');
    if (stage && sending) {
      lines.push('You selected: "' + stage + '" data, sending "' + sending + '".');
    } else {
      lines.push('You selected: "' + (stage || sending) + '".');
    }
  }

  lines.push('');
  if (!selections.records_included) {
    // They said they were sending names and sequences only, so the host and geography
    // records are still to come. Saying so is the whole reason this branch exists.
    lines.push('Your host and geography records have not reached MalAvi. Please submit');
    lines.push('those as soon as your study is accepted for publication.');
  } else if (selections.records_held) {
    lines.push('Your host and geography records are held until your study is published,');
    lines.push('as you asked. Let us know when it is accepted and they will go into the');
    lines.push('next MalAvi data release after that.');
  } else {
    lines.push('The records themselves appear in the next MalAvi data release.');
  }

  lines = lines.concat([
    '',
    '--',
    'MalAvi',
    'https://malavi-db.github.io/'
  ]);

  // replyTo is set explicitly rather than left to default to the sending account. The
  // default would work today, but this message tells the reader to reply, and that
  // instruction must not quietly stop being true if the sending alias ever changes.
  // mail.gs applies the mode, its own duplicate memory (keyed on the same identity), the
  // caps and the submitter rule. The older confirmation memory above is consulted for
  // messages sent before 2026-10-16 and no longer written to.
  var result = sendMail_({ to: to,
                           subject: 'MalAvi: your lineage names are confirmed (automatic message)',
                           body: lines.join('\n'),
                           options: { replyTo: 'malaviadmin@gmail.com' },
                           kind: 'submitter', submissionId: String(payload.submission_id || ''),
                           key: key, note: 'name confirmation' });
  if (result.sent) return { ok: true, action: 'emailed', notified: 1 };
  return { ok: true, action: result.held === 'duplicate' ? 'already_sent' : 'held',
           notified: 0 };
}


/**
 * The identity of one name confirmation, for the sent-once check in confirmNames_.
 *
 * An explicit `idempotency_key` in the payload wins, so that BIOMIX can name the message
 * itself without this script changing again. Absent that, the key is derived from what
 * makes two requests the same message: the submission, the address, and the sorted names.
 * It is deliberately NOT built from `issued_at`, which is stamped fresh on every attempt
 * and would therefore never match the retry this check exists to catch. A re-approval
 * after a revision that changed a name produces a different key and is sent, which is
 * right: it is a different message.
 */
function confirmationKey_(payload) {
  var explicit = String(payload.idempotency_key || '').trim();
  if (explicit) {
    return CONFIRMATION_KEY_PREFIX + explicit;
  }
  var names = (payload.names || []).map(function (name) { return String(name); });
  names.sort();
  return CONFIRMATION_KEY_PREFIX +
    String(payload.submission_id || '') + '|' +
    String(payload.to || '').trim().toLowerCase() + '|' +
    names.join(',');
}


/**
 * Has this confirmation gone out within CONFIRMATION_MEMORY_DAYS?
 *
 * Script properties rather than CacheService: the cache is allowed to evict an entry at
 * any time, and an eviction here means a second email. Properties persist until deleted;
 * rememberConfirmation_ prunes the old ones so they do not accumulate forever.
 */
function alreadyConfirmed_(key) {
  var sentAt = PropertiesService.getScriptProperties().getProperty(key);
  if (!sentAt) {
    return false;
  }
  var ageMs = Date.now() - Number(sentAt);
  return ageMs >= 0 && ageMs < CONFIRMATION_MEMORY_DAYS * 24 * 3600 * 1000;
}


/**
 * Record that a confirmation was mailed, and forget any older than the memory window.
 *
 * Called only after GmailApp.sendEmail returned: a key recorded before the send would,
 * on a failed send, suppress the retry that is supposed to fix it.
 */
function rememberConfirmation_(key) {
  var properties = PropertiesService.getScriptProperties();
  var now = Date.now();
  var cutoff = now - CONFIRMATION_MEMORY_DAYS * 24 * 3600 * 1000;
  var all = properties.getProperties();
  for (var name in all) {
    if (all.hasOwnProperty(name) && name.indexOf(CONFIRMATION_KEY_PREFIX) === 0 &&
        Number(all[name]) < cutoff) {
      properties.deleteProperty(name);
    }
  }
  properties.setProperty(key, String(now));
}


/**
 * Tell a submitter their submission was not accepted, and point them at a person.
 *
 * WHY THIS CARRIES NO REASON
 * --------------------------
 * A curator's written reasoning quotes the submission and is usually a judgment about the
 * data. Put in an automatic message it becomes an assertion nobody can answer: the reader
 * has a question the moment they finish reading, and the sender cannot respond. So this
 * says what happened, says it plainly, and hands the conversation to a human -- which is
 * also the honest description of what a decline actually is at this stage.
 *
 * WHY IT EXISTS AT ALL
 * --------------------
 * The alternative is silence. A submitter who hears nothing does not conclude "declined";
 * they conclude "lost", and they wait, and their reserved names sit claimed while they do.
 * Being told is better than being left to infer, even when the news is unwelcome.
 *
 * TONE IS DELIBERATE
 * ------------------
 * Not accepted "in its current form", and an explicit invitation to write back. Most
 * declines at this stage are fixable -- a workbook that could not be read, records that
 * could not be reconciled with the paper -- and a submitter who reads this as a permanent
 * verdict is a contributor MalAvi has lost for no reason.
 */
/**
 * Tell the other curators that somebody recorded a verdict.
 *
 * Until this existed, a verdict was visible only to whoever next ran fetch_verdicts on
 * BIOMIX. A hold was invisible to the curator it was blocking, and an override was
 * invisible to the curator whose objection had just been set aside -- which is the one
 * person entitled to know.
 *
 * The body is composed on the maintainer's side, because that is where the ledger is: the
 * verdict id, the reason, the resulting state and the link a reader should follow are all
 * things this script has no way to know.
 *
 * BUT THE RECIPIENTS ARE NOT TAKEN FROM THE PAYLOAD. They are CURATORS, minus whoever the
 * payload says performed the act. A signed request that could name its own recipients
 * would turn this endpoint into a mailer for anyone who ever obtained the secret, and the
 * whole argument for the secret being an acceptable risk (see the header) is that its
 * holder can do exactly two harmless things. Sending mail to strangers is not one of them.
 */
function verdictNotice_(payload) {
  var subject = String(payload.subject || '').trim();
  var body = String(payload.body || '').trim();
  if (!subject || !body) {
    return { ok: false, error: 'a verdict notice needs both a subject and a body' };
  }
  var actor = String(payload.actor_email || '').trim().toLowerCase();
  // Who hears it: every curator, or the leads only (the ledger's hold id and clear-hold
  // link are a lead's tools; the form's trigger already told the curators of the flag).
  var audience = String(payload.audience || 'curators') === 'leads' ? 'leads' : 'curators';
  var recipients = audience === 'leads' ? attentionTo_() : curators_();
  if (!recipients.length) {
    return { ok: false, error: (audience === 'leads' ? 'ATTENTION_TO' : 'CURATORS') +
                               ' is not set (Script Properties); nobody emailed' };
  }

  var sent = 0;
  for (var i = 0; i < recipients.length; i++) {
    if (recipients[i].toLowerCase() === actor) {
      continue;                     // nobody needs mail about their own click
    }
    var result = sendMail_({ to: recipients[i], subject: subject, body: body,
                             kind: audience === 'leads' ? 'lead' : 'curator',
                             submissionId: String(payload.submission_id || ''),
                             key: String(payload.mail_key || ''), note: 'verdict notice' });
    if (result.sent) sent += 1;
  }
  return { ok: true, action: noticeOutcome_(sent), notified: sent };
}


function declineNotice_(payload) {
  var to = String(payload.to || '');
  if (to.indexOf('@') === -1) {
    return { ok: false, error: 'no usable submitter address' };
  }
  var who = String(payload.submitter_name || '').trim();

  var lines = [
    '[this is an automatic email]',
    '',
    who ? 'Dear ' + who + ',' : 'Hello,',
    '',
    'This is an automatic message from MalAvi. Replies go straight to the curators, so',
    'please reply to this email with any questions.',
    '',
    'A curator has reviewed your submission, and it has not been accepted into MalAvi in',
    'its current form.',
    '',
    'The most common reason is new sequences that do not pass quality control checks.',
    'A curator can tell you the specific issues.',
    '',
    'Please write back and we will determine if we can work through this with you.'
  ];

  if (payload.reference) {
    lines.push('');
    lines.push('Submission: ' + payload.reference);
  }

  lines = lines.concat([
    '',
    'Any lineage names you proposed are no longer reserved, so they may be assigned to',
    'another submission. If you resubmit, propose them again and a curator will check',
    'whether they are still free.',
    '',
    '--',
    'MalAvi',
    'https://malavi-db.github.io/'
  ]);

  var result = sendMail_({ to: to,
                           subject: 'MalAvi: about your submission (automatic message)',
                           body: lines.join('\n'),
                           options: { replyTo: 'malaviadmin@gmail.com' },
                           kind: 'submitter', submissionId: String(payload.submission_id || ''),
                           key: String(payload.mail_key || ''), note: 'decline notice' });
  if (result.sent) return { ok: true, action: 'emailed', notified: 1 };
  return { ok: true, action: result.held === 'duplicate' ? 'already_sent' : 'held',
           notified: 0 };
}


/**
 * Email the curators that a report is ready.
 *
 * Deliberately short, and deliberately says nothing about what the report found. The
 * report itself carries the disposition line and the prefilled verdict link; an email that
 * summarized the findings would be a second place for them to be wrong, and would put
 * something about an unpublished submission into an inbox that may not be the curator's
 * only device. The subject line does not name the submitter either.
 */
function notifyCurators_(submissionId, written, assignee, mailKey, announcedBefore) {
  // "updated" only when the curators were TOLD of an earlier version. Drive's own
  // created/updated says whether the file existed, which is not the same thing: a first
  // report whose notice was held (mail mode) exists in Drive before anyone heard of it
  // (code review 2026-10-16, finding 10). The Python side says what the ledger knows;
  // an older caller that says nothing falls back to Drive's word.
  var verb = (announcedBefore === true || announcedBefore === false)
      ? (announcedBefore ? 'updated' : 'ready')
      : (written.action === 'updated' ? 'updated' : 'ready');
  var corrected = verb === 'updated';
  var curators = curators_();
  var owner = String(assignee || '').trim();
  var ownerName = owner ? curatorName_(owner) : '';

  // Two subjects when somebody owns it: the assignee is asked for a verdict by name, the
  // others are told who has it. One subject, as before 2026-10-16, when nobody does.
  var subjectForOwner = 'MalAvi: ' + submissionId + ' needs your verdict (curator report ' +
                        verb + ')';
  var subjectForOthers = owner
      ? 'MalAvi: curator report ' + verb + ' (' + submissionId + '; assigned to ' +
        ownerName + ', you are in copy)'
      : 'MalAvi: curator report ' + verb + ' (' + submissionId + ')';

  var lines = [
    '[this is an automatic email]',
    '',
    'A curator report is ' + (corrected
      ? 'available in a corrected version.'
      : 'ready for review.'),
    '',
    'Submission: ' + submissionId,
    'Report:     ' + written.url,
    '',
    // One line per paragraph, not hand-wrapped. A mail client re-wraps to its own
    // width, so a sentence split across two source lines comes out broken at whatever
    // word the author happened to stop at -- "...what was / submitted..." is what that
    // looked like in the first real report email.
    'The report opens in the browser. It carries the automated check results, what was '
      + 'submitted, and a link that records your decision.',
    '',
    'Opening it needs the Google account the reports folder was shared with. If the link '
      + 'says you need access, check which account your browser is signed into.',
    '',
    corrected
      ? 'This replaces the earlier version at the same link. If you already read it, the '
        + 'findings may have changed.'
      : 'Nothing is added to MalAvi without a curator decision.',
    ''
  ];
  if (owner) {
    // One line per paragraph, not hand-wrapped (a mail client re-wraps to its width).
    lines.push('This submission is assigned to ' + ownerName + ', who is asked to record a '
        + 'verdict within two weeks; the others are in copy and may still comment or record '
        + 'a verdict of their own. Reminders go to the assignee after 7 days and to everyone '
        + 'after 14. If you cannot take it, reply to this email and a lead will reassign it.');
    lines.push('');
  }
  lines.push('Confidential: a submission can contain unpublished sequences.');
  var body = lines.join('\n');

  // The key names the report (submission and PDF bytes, from the Python side), so the
  // same report posted twice is announced once and a corrected one is announced again.
  var key = mailKey || ('report|' + submissionId + '|' + written.id + '|' + written.action);
  var sent = 0;
  var ownerTold = false;
  for (var i = 0; i < curators.length; i++) {
    var isOwner = owner && curators[i].toLowerCase() === owner.toLowerCase();
    var result = sendMail_({ to: curators[i],
                             subject: isOwner ? subjectForOwner : subjectForOthers, body: body,
                             kind: 'curator', submissionId: submissionId, key: key,
                             note: 'report ' + verb });
    if (result.sent) sent += 1;
    if (isOwner) ownerTold = true;
  }
  // An assignee who is in ASSIGNEES but not in CURATORS still has to hear about it.
  if (owner && !ownerTold) {
    var ownerResult = sendMail_({ to: owner, subject: subjectForOwner, body: body,
                                  kind: 'curator', submissionId: submissionId, key: key,
                                  note: 'report ' + verb + ' (assignee)' });
    if (ownerResult.sent) sent += 1;
  }
  return sent;
}


// ---------------------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------------------

/**
 * Constant-time-ish comparison of the provided signature against the expected one.
 *
 * Apps Script has no constant-time compare. Over HTTPS, against a hex digest, a timing
 * attack is not a practical route in -- but comparing every character rather than
 * returning at the first difference costs nothing, so there is no reason to hand out the
 * information.
 */
function signatureValid_(body, provided) {
  var raw = Utilities.computeHmacSha256Signature(body, sharedSecret_());
  var expected = hex_(raw);
  if (provided.length !== expected.length) {
    return false;
  }
  var difference = 0;
  for (var i = 0; i < expected.length; i++) {
    difference |= (expected.charCodeAt(i) ^ provided.charCodeAt(i));
  }
  return difference === 0;
}


/** Byte array to lowercase hex. Apps Script bytes are signed, hence the & 0xFF. */
function hex_(bytes) {
  var out = '';
  for (var i = 0; i < bytes.length; i++) {
    var b = (bytes[i] & 0xFF).toString(16);
    out += (b.length === 1 ? '0' : '') + b;
  }
  return out;
}


/** Every response is JSON, including every failure. See the note on doPost. */
function reply_(object) {
  return ContentService
    .createTextOutput(JSON.stringify(object))
    .setMimeType(ContentService.MimeType.JSON);
}


// ---------------------------------------------------------------------------------------
// Run this once, by hand, before deploying
// ---------------------------------------------------------------------------------------

/**
 * Force Google to ask for the permissions the web app needs, in the editor.
 *
 * Editing appsscript.json is not always enough on its own: Google decides whether to
 * re-prompt, and if it decides not to, the missing permission stays missing and only shows
 * up as a failure inside the deployed web app -- where there is no way to consent, because
 * a web app request has no user sitting in front of it.
 *
 * This function calls UrlFetchApp for real. Running it from the editor either raises the
 * authorization dialog (which is the point) or succeeds, which proves the permission is
 * already there and the problem is elsewhere. Either way it answers the question, which
 * staring at the manifest does not.
 *
 * The request it makes is deliberately trivial and read-only: it asks Drive who this
 * script is running as.
 */
function forceAuthorization() {
  var response = UrlFetchApp.fetch(
    'https://www.googleapis.com/drive/v3/about?fields=user',
    {
      headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
      muteHttpExceptions: true
    });
  Logger.log('UrlFetchApp is authorized. Drive replied: ' +
             response.getContentText().slice(0, 200));
}


/**
 * Check the configuration without needing a request, and send yourself a sample email.
 *
 * Worth running before the first deployment, because the two most likely mistakes -- an
 * unedited folder id and an unedited secret -- both produce failures at the far end of the
 * pipeline, on BIOMIX, where the cause is invisible.
 */
function testSetup() {
  var problems = [];
  var folderId = reportsFolderId_();
  var secret = sharedSecret_();
  var curators = curators_();

  if (!folderId) {
    problems.push('REPORTS_FOLDER_ID is not set (Project Settings > Script Properties).');
  } else {
    try {
      var folder = DriveApp.getFolderById(folderId);
      Logger.log('Reports folder: ' + folder.getName());
    } catch (err) {
      problems.push('REPORTS_FOLDER_ID is not a folder this account can open: ' + err);
    }
  }

  if (!secret) {
    problems.push('SHARED_SECRET is not set (Project Settings > Script Properties).');
  } else if (secret.length < 32) {
    problems.push('SHARED_SECRET is shorter than 32 characters; generate one with ' +
                  '`openssl rand -hex 32`.');
  }

  if (!curators.length) {
    problems.push('CURATORS is not set, so nobody would be told a report exists.');
  }

  if (!settingList_('ATTENTION_TO').length) {
    problems.push('ATTENTION_TO is not set, so nobody would be told the intake cycle ' +
                  'needs a person.');
  }

  if (!statusSheetEnabled_()) {
    Logger.log('Note: STATUS_SHEET_ID is not set, so reports will not be assigned and ' +
               'nothing is written to a status sheet. Run createStatusSheet to set it up.');
  }

  if (problems.length) {
    Logger.log('NOT READY:\n  ' + problems.join('\n  '));
    return;
  }

  // Show what a curator will actually receive, using a fake submission id. Sent to the
  // LEADS only (ATTENTION_TO), not to every curator: with real curators on the list a
  // test report is noise. The sample names the first lead as the assignee so both subject
  // lines are seen; nothing is written to the status sheet by this test.
  var leads = attentionTo_();
  var sample = { id: 'example', url: 'https://drive.google.com/file/d/EXAMPLE/view',
                 action: 'created' };
  var bodyLines = ['[this is an automatic email]', '',
                   'This is testSetup in the MalAvi curation project: a SAMPLE of the two ' +
                   'report emails (assignee / in copy). No report exists and nothing was ' +
                   'written anywhere.', '', 'Submission: MALAVI-SUB-0000-TEST',
                   'Report:     ' + sample.url];
  var delivered = 0;
  var stamp = String(Date.now());
  for (var L = 0; L < leads.length; L++) {
    var one = sendMail_({ to: leads[L],
                          subject: 'MalAvi: MALAVI-SUB-0000-TEST needs your verdict (curator ' +
                                   'report ready) [SAMPLE]',
                          body: bodyLines.join('\n'), kind: 'lead',
                          key: 'testSetup-owner|' + stamp, note: 'testSetup sample' });
    var two = sendMail_({ to: leads[L],
                          subject: 'MalAvi: curator report ready (MALAVI-SUB-0000-TEST; assigned ' +
                                   'to ' + curatorName_(leads[0]) + ', you are in copy) [SAMPLE]',
                          body: bodyLines.join('\n'), kind: 'lead',
                          key: 'testSetup-copy|' + stamp, note: 'testSetup sample' });
    delivered += (one.sent ? 1 : 0) + (two.sent ? 1 : 0);
  }
  Logger.log('Configuration looks right. ' + delivered + ' of ' + (2 * leads.length) +
             ' sample notifications went to the ' + leads.length + ' lead address(es) in ' +
             'ATTENTION_TO (not to the curators). CURATORS holds ' + curators.length +
             ' address(es). ' + mailStatusLine_());
}


// ======================================================================================
// FILE: notify_on_submission.gs
// ======================================================================================

/**
 * Email the curators when a submission arrives, and acknowledge the submitter.
 *
 * WHY THIS RATHER THAN THE PYTHON SIDE
 * ------------------------------------
 * Two routes were possible. A mail API key driven from the repository could send the full
 * screen result — every automated check, the sequence comparisons — but costs a secret to
 * store and rotate, and only fires when a job runs. This one fires the moment somebody
 * presses Submit, needs no credential at all, and sends from the account that owns the
 * form. For "a curator finds out promptly", that wins.
 *
 * WHAT IT CANNOT KNOW, AND WHY THE EMAIL IS SHORT
 * -----------------------------------------------
 * At submission time the automated checks have not run. Nothing here knows whether a
 * proposed lineage name is taken, whether a sequence is already a named lineage, or what
 * the opaque submission id will be — all of that is minted and computed later, by the
 * fetch and screen jobs. So this email says *that* something arrived and *where it is*,
 * and deliberately does not characterize the science. An email that guessed would be worse
 * than one that waits.
 *
 * PRIVACY
 * -------
 * The curator email names the submitter, because a curator may need to go back to them and
 * cannot do that from an opaque id. It does not quote their data. It goes only to the
 * addresses listed below, never to a list, and the footer says it is confidential — a
 * submission can contain unpublished sequences whose author has told nobody else.
 *
 * WHO HEARS ABOUT AN ARRIVAL (changed 2026-10-16)
 * ----------------------------------------------
 * The leads only (the ARRIVAL_TO Script Property, falling back to ATTENTION_TO), not every
 * curator. Mélanie asked on 2026-10-16 to receive only the report email; the arrival
 * notice exists so that somebody knows a submission is sitting unscreened if the intake
 * cycle is late, and the leads are who act on that. The arrival is also written to the
 * Arrivals tab of the status sheet (status_sheet.gs), and the daily clock reports an
 * arrival that has had no report for two days.
 *
 * INSTALLING IT
 * -------------
 * This file is one of the files of the single "MalAvi curation" project (settings.gs
 * explains). Set SUBMISSION_FORM_ID (and CURATORS, ATTENTION_TO) in the Script Properties,
 * run `testSubmissionNotification` once (it emails the arrival recipients a sample), then
 * run `installAllTriggers` in triggers.gs, which attaches onSubmissionReceived to the
 * form. Do NOT hunt for the Triggers screen: this project is standalone rather than bound
 * to the form, and a standalone script is not offered "From form" in that dropdown at all.
 * If the old separate "MalAvi submission notifier" project still has its trigger, delete
 * that trigger (or the project), or every arrival is announced twice.
 *
 * IF AN EMAIL DOES NOT ARRIVE
 * ---------------------------
 * The log saying it sent means Google accepted it, not that anyone received it. A brand
 * new Gmail account with no sending history, writing to a university address, is a
 * textbook spam-filter trigger. Run `diagnoseDelivery` below: it reports the remaining
 * send quota and mails the operational account itself, which isolates "sending is broken"
 * from "the recipient's filter ate it".
 *
 * Sends go through GmailApp rather than MailApp so a copy lands in the account's Sent
 * folder. MailApp leaves no trace, which is the difference between believing a message
 * went and being able to point at it.
 *
 * QUOTA
 * -----
 * A consumer Gmail account may send about 100 email recipients per day through Apps
 * Script. MalAvi is nowhere near that — a busy week is a handful of submissions times a
 * handful of curators — but a bulk operation would hit it.
 */

// ---------------------------------------------------------------------------------------
// WHO GETS TOLD.
//
// **This list is for NOTIFICATION only. It does not grant anybody authority.** Whether a
// verdict counts is decided by config/curators.yml in the repository, which this script
// cannot read. The two therefore have to be kept in step by hand: adding a curator means
// editing both, and a curator removed from the registry but left here keeps receiving
// submissions they can no longer vote on.
// ---------------------------------------------------------------------------------------
// The recipients are arrivalTo_() in settings.gs: the ARRIVAL_TO Script Property, or the
// leads (ATTENTION_TO) when it is empty. No live value is written in this published file,
// so pasting it over the live script blanks nothing. Nothing is read from the properties
// at the top of this file (LOAD ORDER in settings.gs).
var SETTINGS_NEEDED_SUBMISSION = ['SUBMISSION_FORM_ID', 'ARRIVAL_TO'];

// The submission form id: the SUBMISSION_FORM_ID Script Property, read when a trigger is
// installed. The live value is in CUSTODY_PRIVATE.md, not here, because this file is
// published. It is not a credential -- opening the edit URL still requires being signed in
// as someone with access -- but a published id is one that can be probed, and there is no
// reason to hand out the target.

// Question titles, matched on a lowercase substring so light rewording of the form does not
// silently blank a field. Keep in step with create_submission_form.gs.
var FIELDS = {
  name: 'first and last name',
  institution: 'institution',
  country: 'country',
  stage: 'published or unpublished',
  kind: 'template file, a pdf',
  sending: 'what are you sending',
  notes: 'notes or communication'
};


/**
 * The trigger. Runs on every submission to the form it is installed against.
 */
function onSubmissionReceived(e) {
  var answers = readResponse(e);
  try {
    if (statusSheetEnabled_()) withSheetLock_(function () { recordArrival_(answers); });
  } catch (err0) {
    Logger.log('Could not write the Arrivals tab: ' + err0);
  }
  try {
    notifyCurators(answers);
  } catch (err) {
    // A failed curator email must be visible to somebody. Without this the submission
    // simply sits unnoticed, which is the failure this script exists to prevent.
    Logger.log('FAILED to notify curators: ' + err);
    sendMail_({ to: fallbackAddress_(), subject: 'MalAvi: submission notification FAILED',
                body: 'A submission arrived but the notification email failed:\n\n' + err +
                      '\n\nCheck the responses sheet directly.',
                kind: 'system', force: true, note: 'arrival notice failed' });
  }
  try {
    acknowledgeSubmitter(answers);
  } catch (err2) {
    Logger.log('Could not acknowledge submitter: ' + err2);
  }
}


/**
 * Pull the response into a plain object, tolerating a reworded question.
 */
function readResponse(e) {
  var out = { email: '', received: new Date(), files: 0, links: [] };
  if (!e || !e.response) return out;

  out.email = e.response.getRespondentEmail() || '';
  out.received = e.response.getTimestamp() || new Date();

  var items = e.response.getItemResponses();
  for (var i = 0; i < items.length; i++) {
    var title = items[i].getItem().getTitle().toLowerCase();
    var value = items[i].getResponse();

    // A file-upload answer is an array of file ids; count them rather than linking each,
    // since a curator reaches them through the submission folder anyway.
    if (Object.prototype.toString.call(value) === '[object Array]' &&
        title.indexOf('upload') === -1 && title.indexOf('submission ') === 0) {
      out.files += value.length;
      continue;
    }
    if (Object.prototype.toString.call(value) === '[object Array]') {
      if (title.indexOf('what did you check') === -1) {
        out.files += value.length;
        // The links, not just the count. For a PDF-only submission there is no report to
        // open, so without these the email tells a curator that a paper arrived and gives
        // them no way to read it.
        for (var f = 0; f < value.length; f++) {
          out.links.push({ label: items[i].getItem().getTitle().split('(')[0].trim(),
                           url: 'https://drive.google.com/open?id=' + value[f] });
        }
      }
      continue;
    }
    for (var key in FIELDS) {
      if (title.indexOf(FIELDS[key]) !== -1) { out[key] = value; }
    }
  }
  return out;
}


function notifyCurators(a) {
  a.links = a.links || [];
  // "arrived", not "needs review". Nothing has been checked when this fires, so there is
  // nothing for a curator to review yet; the report email is the one that asks for a
  // decision. The old subject invited action this message cannot support.
  var subject = 'MalAvi: a submission arrived'
      + (a.stage ? ' (' + a.stage.toLowerCase() + ')' : '');

  var lines = [
    '[this is an automatic email]',
    '',
    'A new submission arrived on the MalAvi form.',
    '',
    'Received:     ' + Utilities.formatDate(a.received, 'GMT', "yyyy-MM-dd HH:mm 'GMT'"),
    'From:         ' + (a.name || 'not given')
                     + (a.institution ? ', ' + a.institution : '')
                     + (a.country ? ' (' + a.country + ')' : ''),
    'Contact:      ' + (a.email || 'not given'),
    'Data:         ' + (a.stage || 'not stated'),
    'Sending:      ' + (a.sending || 'not stated'),
    'Attached:     ' + (a.files ? a.files + ' file(s)' : 'no files'),
    ''
  ];

  if (a.notes) {
    lines.push('Their notes:');
    lines.push('  ' + a.notes);
    lines.push('');
  }

  if (a.links.length) {
    lines.push('The files they sent:');
    for (var L = 0; L < a.links.length; L++) {
      lines.push('  ' + a.links[L].label);
      lines.push('    ' + a.links[L].url);
    }
    lines.push('');
  }

  // "Automated" was the wrong word here and a curator read it the way anyone would:
  // as "a machine is about to do this", and then waited. The checks are automated in
  // the sense of being rule-based, not in the sense of being scheduled. Say plainly what
  // happens next, or the silence between the two emails looks like a system working
  // rather than a step nobody has run.
  //
  // Reworded 2026-10-02. The earlier text said the maintainer "will run the report
  // checking software" and asked curators to tell the maintainer if nothing came, which
  // told five people that somebody else had it in hand. This version says what the second
  // email is for and what to do if it does not come, and names nobody whose job it is to
  // act instead of the reader. A reply goes to the MalAvi address. One line per paragraph,
  // not hand-wrapped: a mail client re-wraps to its own width.
  //
  // Since 2026-10-16 this goes to the leads only, and the report email names the
  // assigned curator (publish_report.gs), so the text can say so.
  lines.push('The checks have not run yet. This email only says a submission arrived; it '
      + 'does not say whether the names or sequences are new, and there is nothing to '
      + 'decide yet.');
  lines.push('');
  lines.push('The curator report follows when the intake cycle has run (four times a day '
      + 'when scheduled). That email goes to every curator and names the one the '
      + 'submission is assigned to. The daily digest will say so if no report has gone out '
      + 'within two days.');
  lines.push('');
  lines.push('--');
  lines.push('Confidential. A submission may contain unpublished sequences. Please do not');
  lines.push('forward this email.');

  var recipients = arrivalTo_();
  if (!recipients.length) {
    // Thrown so the trigger's catch mails the account that owns the script.
    throw new Error('neither ARRIVAL_TO, ATTENTION_TO nor CURATORS is set (Project ' +
                    'Settings > Script Properties)');
  }
  // One send per recipient rather than one with several recipients, so nobody learns who
  // else is on the list and a bad address cannot take the whole send down. The key is
  // the arrival itself (who, when), so a re-run trigger announces it once.
  var key = 'arrival|' + String(a.email || '').toLowerCase() + '|' + isoNow_(a.received);
  for (var i = 0; i < recipients.length; i++) {
    sendMail_({ to: recipients[i], subject: subject, body: lines.join('\n'),
                kind: 'curator', key: key, note: 'arrival notice' });
  }
}


/**
 * One Arrivals row on the status sheet, so the daily clock can notice an arrival that
 * never got a report. Nothing is written when there is no sheet. The matched_id column
 * is filled later by the clock, when a Submissions row with the same address appears.
 */
function recordArrival_(a) {
  if (!statusSheetEnabled_()) return;
  appendRow_(TAB_ARRIVALS, {
    form_timestamp: isoNow_(a.received),
    submitter_name: a.name || '',
    submitter_email: a.email || '',
    stage: a.stage || '',
    files: String(a.files || 0),
    matched_id: ''
  });
}


function acknowledgeSubmitter(a) {
  if (!a.email) return;

  var body = [
    '[this is an automatic email]',
    '',
    'Thank you! Your submission to MalAvi has been received.',
    '',
    'Received: ' + Utilities.formatDate(a.received, 'GMT', "yyyy-MM-dd HH:mm 'GMT'"),
    '',
    'A curator will look at it. If anything needs clarifying, a curator will write to you',
    'at this email address.',
    '',
    'Thanks again for submitting data to MalAvi.',
    '',
    '--',
    'MalAvi',
    'https://malavi-db.github.io/'
  ].join('\n');

  sendMail_({ to: a.email, subject: 'MalAvi: submission received', body: body,
              kind: 'submitter', key: 'received|' + String(a.email).toLowerCase() + '|' +
              isoNow_(a.received), note: 'submission received' });
}


/**
 * Attach onSubmissionReceived to the submission form. installAllTriggers (triggers.gs)
 * does this together with the others; this one exists for installing it alone.
 *
 * Done in code rather than through the Triggers screen because this project is standalone,
 * and the UI only offers a form trigger for a script bound to that form. It is also safely
 * repeatable: any existing trigger for this handler is removed first, so running it twice
 * cannot produce two emails per submission -- which is the usual result of clicking Add
 * trigger again after being unsure whether the first one took.
 */
function installSubmissionTrigger() {
  var FORM_ID = requireSetting_('SUBMISSION_FORM_ID');
  var existing = ScriptApp.getProjectTriggers();
  var removed = 0;
  for (var i = 0; i < existing.length; i++) {
    if (existing[i].getHandlerFunction() === 'onSubmissionReceived') {
      ScriptApp.deleteTrigger(existing[i]);
      removed++;
    }
  }
  ScriptApp.newTrigger('onSubmissionReceived')
      .forForm(FORM_ID)
      .onFormSubmit()
      .create();
  Logger.log((removed ? 'Removed ' + removed + ' existing trigger(s). ' : '') +
             'Installed onSubmissionReceived on form ' + FORM_ID);
}


/**
 * Is sending working at all, and is the problem at the far end?
 *
 * Mails the operational account itself. Gmail to Gmail is barely filtered, so if that one
 * arrives and a message to a university address does not, the script is fine and the
 * recipient's spam filter is holding it.
 */
function diagnoseDelivery() {
  var quota = MailApp.getRemainingDailyQuota();
  Logger.log('Remaining send quota today: ' + quota);
  if (quota === 0) {
    Logger.log('QUOTA EXHAUSTED — nothing will send until it resets.');
    return;
  }
  var self = Session.getActiveUser().getEmail();
  // Forced: this is the test of whether sending works at all, whatever the mode.
  sendMail_({ to: self, subject: 'MalAvi: delivery test',
              body: 'If you are reading this in the MalAvi account, sending works.\n\n' +
                    'If the same test does not reach a university address, the message is being\n' +
                    'filtered at that end. Check the spam folder and any institutional quarantine,\n' +
                    'and add this address to your contacts.\n',
              kind: 'system', force: true, note: 'diagnoseDelivery' });
  Logger.log('Sent a test to the account itself: ' + self);
  Logger.log('Also check the Sent folder of ' + self + ' for the earlier messages.');
}


/**
 * Send the arrival recipients one sample of the arrival email, without waiting for a real
 * submission. Run this before installing the trigger. Nothing is written to the sheet.
 */
function testSubmissionNotification() {
  notifyCurators({
    received: new Date(),
    name: 'A Submitter',
    institution: 'An Institution',
    country: 'Sweden',
    email: 'submitter@example.edu',
    stage: 'Unpublished',
    sending: 'New lineage names and sequences',
    notes: 'This is a test of the notification email. No real submission was made.',
    files: 2,
    links: [{ label: 'Submission PDF and Supplementary Materials',
              url: 'https://drive.google.com/open?id=1EXAMPLEfileid0000000' }]
  });
  Logger.log('Sent a sample to: ' + arrivalTo_().join(', '));
}


// ======================================================================================
// FILE: notify_on_verdict.gs
// ======================================================================================

/**
 * Email every curator the moment something is recorded on the verdict form.
 *
 * WHY THIS EXISTS
 * ---------------
 * Without this script a response on the verdict form does nothing and tells nobody. It
 * becomes a ledger entry, and an email to the other curators, only when the maintainer
 * runs curation/fetch_verdicts.py. So a curator who records a verdict hears nothing back,
 * the other curators hear nothing until the next fetch, and the maintainer finds out only
 * by running the fetch or opening the responses sheet. A form that answers nobody is a
 * letterbox, and people stop posting into it.
 *
 * This is the same pattern as notify_on_submission.gs: a form-submit trigger that runs as
 * the operational account, needs no credential and no maintainer, and keeps working when
 * nobody is at a terminal.
 *
 * WHAT IT SAYS, AND WHAT IT DOES NOT CLAIM
 * ----------------------------------------
 * It reports what was ENTERED ON THE FORM, in the form's own words. It does not say the
 * entry counted. Whether it counts is decided by the ledger when it next reads the form
 * (curation/src/malavi_curation/ledger.py): that the address belongs to a registered
 * curator, that the revision is the current one, that whoever filed a revision is not the
 * one approving it. This script cannot see the ledger, so the email says exactly that, in
 * one line. curation/fetch_verdicts.py still sends the ledger's own notice when it applies
 * the entry; this one stops the fetch being the only way anyone learns anything.
 *
 * It does not replace fetch_verdicts.py, and it does not change what a verdict does.
 *
 * WHY IT LISTS EVERY ANSWER RATHER THAN PICKING FIELDS
 * ----------------------------------------------------
 * The verdict form has six routes (verdict, withdraw a flag, clear a hold, correction,
 * approve a correction, close). Mapping each route's questions by name would be a second
 * copy of create_verdict_form.gs that drifts the first time a question is reworded. So the
 * body is every answered question, in the form's order, under the form's own titles. Only
 * the subject line reads specific answers, and it falls back to plain words if it cannot
 * find them.
 *
 * PRIVACY, AND THE MESSAGE TO THE SUBMITTER (2026-10-16)
 * ------------------------------------------------------
 * A reason can quote what is wrong with somebody's unpublished data. The notice therefore
 * goes only to the curators, one message each, and says it is confidential. The "Why?"
 * answer is the curators' INTERNAL note and never leaves them.
 *
 * The form has a second free-text question, "Message to the submitter" (added by
 * add_submitter_message_question.gs; the curators asked for two separate fields on
 * 2026-10-15/16). When a curator FLAGS a submission and fills that field, this trigger
 * emails the submitter that text as written, from MalAvi, with the curator and the
 * assigned curator in copy, and records the send on the status sheet. Nothing is sent to
 * the submitter on Accept or Reject, and nothing is sent when the field is empty: then the
 * notice to the curators says so, and the daily clock reminds the assignee to write.
 * The submitter's address comes from the status sheet (status_sheet.gs), where the report
 * publisher put it; with no sheet, or no address on the row, the message is not sent and
 * the curators are told why.
 *
 * INSTALLING IT
 * -------------
 * This file is one of the files of the single "MalAvi curation" project (settings.gs
 * explains). Set VERDICT_FORM_ID and CURATORS in the Script Properties, run
 * `testVerdictNotification` once (it emails the curators a clearly marked sample), then
 * run `installAllTriggers` in triggers.gs, which attaches onVerdictRecorded to the form.
 * Do not look for the Triggers screen: a standalone project is not offered a form trigger
 * there. To test end to end, record an entry on the verdict form against a submission id
 * that does not exist (MALAVI-SUB-0000-TEST): the ledger refuses an unknown id at the next
 * fetch, so the test changes nothing.
 *
 * QUOTA
 * -----
 * One message per curator per form response. A consumer Gmail account may send about 100
 * recipients a day through Apps Script; five curators and a handful of verdicts a week is
 * nowhere near it.
 */

// ---------------------------------------------------------------------------------------
// WHO GETS TOLD.
//
// The addresses are the CURATORS Script Property, read through curators_() (settings.gs)
// at the moment they are needed. No live value is written in this published file.
// config/curators.yml is the record of who is a curator.
//
// This list is for NOTIFICATION only. It grants nobody authority: whether a verdict counts
// is decided by config/curators.yml, which this script cannot read.
// ---------------------------------------------------------------------------------------
var SETTINGS_NEEDED_VERDICT = ['CURATORS', 'VERDICT_FORM_ID', 'STATUS_SHEET_ID',
                               'UPDATE_FORM_URL'];

// Question titles this script reads, matched on a lowercase substring so light rewording
// of the form does not blank a field. Keep in step with create_verdict_form.gs. Nothing
// else in this script depends on a question's wording.
var TITLE_SUBMISSION_ID = 'submission id';
var TITLE_ACTION = 'what are you recording';
var TITLE_VERDICT = 'your verdict on this revision';
var TITLE_WHY = 'why?';
var TITLE_MESSAGE = 'message to the submitter';

// The three verdict answers, as create_verdict_form.gs spells them, and the word each
// becomes in a subject line.
var VERDICT_WORDS = {
  'Accept': 'accepted',
  'Flag for further review': 'flagged for further review',
  'Reject': 'rejected'
};
var VERDICT_FLAG = 'Flag for further review';
var VERDICT_REJECT = 'Reject';


/**
 * The trigger. Runs on every response to the verdict form.
 *
 * Three independent jobs, each in its own try so one failing cannot stop the others:
 * record the entry on the status sheet, send the message to the submitter if there is
 * one to send, and tell the curators (including what happened with the first two).
 */
function onVerdictRecorded(e) {
  var entry = readEntry(e);
  var outcome = { sheet: '', submitter: '' };
  try {
    outcome.sheet = statusSheetEnabled_()
        ? withSheetLock_(function () { return recordVerdictOnSheet_(entry); })
        : '';
  } catch (err) {
    outcome.sheet = 'The status sheet could not be updated: ' + err;
    Logger.log(outcome.sheet);
  }
  try {
    outcome.submitter = sendSubmitterMessage_(entry);
  } catch (err2) {
    outcome.submitter = 'The message to the submitter FAILED to send: ' + err2 +
                        '. A curator must write to them.';
    Logger.log(outcome.submitter);
  }
  try {
    notifyCuratorsOfEntry(entry, outcome);
  } catch (err3) {
    // A failed notice must be visible to somebody, or the form is a letterbox again.
    Logger.log('FAILED to send the verdict notice: ' + err3);
    sendMail_({ to: fallbackAddress_(), subject: 'MalAvi: verdict notice FAILED',
                body: 'Something was recorded on the verdict form but the notice to the ' +
                      'curators failed:\n\n' + err3 + '\n\nOpen the responses sheet to see ' +
                      'what was recorded.',
                kind: 'system', force: true, note: 'verdict notice failed' });
  }
}


/**
 * Pull the response into a plain object: who, when, and every answered question in order.
 */
function readEntry(e) {
  var entry = { email: '', recorded: new Date(), answers: [] };
  if (!e || !e.response) return entry;

  entry.email = e.response.getRespondentEmail() || '';
  entry.recorded = e.response.getTimestamp() || new Date();

  var items = e.response.getItemResponses();
  for (var i = 0; i < items.length; i++) {
    var value = items[i].getResponse();
    // A checkbox answer is an array; show it as one line.
    if (Object.prototype.toString.call(value) === '[object Array]') {
      value = value.join(', ');
    }
    value = String(value == null ? '' : value).trim();
    if (!value) continue;       // an optional question left empty says nothing
    entry.answers.push({ title: items[i].getItem().getTitle(), value: value });
  }
  return entry;
}


/**
 * The answer to the first question whose title contains `fragment`, or ''.
 */
function answerTo(entry, fragment) {
  for (var i = 0; i < entry.answers.length; i++) {
    if (entry.answers[i].title.toLowerCase().indexOf(fragment) !== -1) {
      return entry.answers[i].value;
    }
  }
  return '';
}


/**
 * Is this address on the list of curators this script emails?
 *
 * Only used to word the email and to decide whether a message to the submitter may go
 * out. It is not the authorization check, which belongs to the ledger; an address missing
 * here may still be a registered curator who is not on the notification list yet.
 */
function onCuratorList(address) {
  var wanted = String(address || '').trim().toLowerCase();
  var curators = curators_();
  for (var i = 0; i < curators.length; i++) {
    if (curators[i].toLowerCase() === wanted) return true;
  }
  return false;
}


// ---------------------------------------------------------------------------------------
// The status sheet
// ---------------------------------------------------------------------------------------

/**
 * Append the entry to the Verdicts tab and refresh the one-line summary on the
 * Submissions row. Returns a sentence for the notice, or '' when there is no sheet.
 */
function recordVerdictOnSheet_(entry) {
  if (!statusSheetEnabled_()) return '';
  var submission = answerTo(entry, TITLE_SUBMISSION_ID);
  var all = [];
  for (var i = 0; i < entry.answers.length; i++) {
    all.push(entry.answers[i].title.replace(/[?:]\s*$/, '') + ': ' + entry.answers[i].value);
  }
  appendRow_(TAB_VERDICTS, {
    recorded_at: isoNow_(entry.recorded),
    id: submission,
    curator: entry.email,
    action: answerTo(entry, TITLE_ACTION),
    verdict: answerTo(entry, TITLE_VERDICT),
    internal_note: answerTo(entry, TITLE_WHY),
    message_to_submitter: answerTo(entry, TITLE_MESSAGE),
    answers: all.join('\n')
  });
  // The summary goes on the Submissions row only when the row exists. Creating one here
  // would let a mistyped or invented id (the form takes anything) sit in the digest as an
  // open submission forever (review 2026-10-16, finding 8).
  var row = findRow_(TAB_SUBMISSIONS, 'id', submission);
  if (row) {
    writeFields_(TAB_SUBMISSIONS, row._row, { verdicts: verdictSummary_(submission) });
    return 'Recorded on the status sheet.';
  }
  return 'Recorded on the Verdicts tab; the status sheet has no row for ' +
         (submission || 'this id') + ' (the ledger will say whether the id is real).';
}


/**
 * Email the submitter the "Message to the submitter" text, when the rules allow it.
 *
 * Sent only when ALL of these hold: the entry is a FLAG; the field is not empty; the
 * entry came from an address on the curator list (never for a stranger with the link);
 * the status sheet is on and holds the submitter's address for this submission. Every
 * other case returns a sentence saying what did not happen and why, which goes into the
 * notice to the curators, so a message that did not go out is never mistaken for one that
 * did.
 */
function sendSubmitterMessage_(entry) {
  var verdict = answerTo(entry, TITLE_VERDICT);
  var message = answerTo(entry, TITLE_MESSAGE);
  var submission = answerTo(entry, TITLE_SUBMISSION_ID);

  if (!message) {
    if (verdict === VERDICT_FLAG) {
      return 'No message to the submitter was written on the form, so nothing was sent to ' +
             'them: whoever flagged writes to them (reply-all on this email keeps the ' +
             'MalAvi address in the thread), or asks the assigned curator to.';
    }
    return '';
  }
  if (verdict !== VERDICT_FLAG) {
    return 'A message to the submitter was written but NOT sent: only a flag sends it, ' +
           'and this entry was ' + (verdict ? VERDICT_WORDS[verdict] || verdict : 'not a verdict') +
           '. A reject reaches the submitter only when a lead closes the submission.';
  }
  if (!onCuratorList(entry.email)) {
    return 'A message to the submitter was written but NOT sent: the entry came from an ' +
           'address that is not on the curator list.';
  }
  if (!statusSheetEnabled_()) {
    return 'A message to the submitter was written but NOT sent: no status sheet is ' +
           'configured, so their address is not known here. A curator must write to them.';
  }
  var row = findRow_(TAB_SUBMISSIONS, 'id', submission);
  var to = row ? String(row.submitter_email || '').trim() : '';
  if (!to || to.indexOf('@') === -1) {
    return 'A message to the submitter was written but NOT sent: the status sheet has no ' +
           'address for ' + (submission || 'this submission') + '. A curator must write to them.';
  }

  var who = curatorName_(entry.email);
  var name = row.submitter_name ? row.submitter_name.split(/\s+/)[0] : 'colleague';
  var updateForm = setting_('UPDATE_FORM_URL');
  var lines = [
    'Dear ' + name + ',',
    '',
    'A curator reviewing your MalAvi submission ' + submission + ' has a question or a ' +
      'request. Their message, as written:',
    ''
  ];
  var parts = message.split('\n');
  for (var p = 0; p < parts.length; p++) lines.push('    ' + parts[p]);
  lines.push('');
  lines.push('Please reply to this email; your reply reaches the curators. ' +
      (updateForm
        ? 'If the answer is a corrected template, upload it through the update form: ' +
          updateForm
        : 'If the answer is a corrected template, attach it to your reply.'));
  lines.push('');
  lines.push('Your submission keeps its id and its reserved lineage names while this is ' +
      'resolved.');
  lines.push('');
  lines.push('Best regards,');
  lines.push(who + ', for the MalAvi curators');
  lines.push('https://malavi-db.github.io/');

  // The curator who wrote it and the assignee are in copy, so a reply-all reaches the
  // people who can answer; the MalAvi address receives the reply as the sender.
  var copies = [entry.email];
  if (row.assignee && row.assignee.toLowerCase() !== entry.email.toLowerCase()) {
    copies.push(row.assignee);
  }
  var subject = 'MalAvi submission ' + submission + ': a question from the curators';
  var result = sendAndRecord_(to, subject, lines.join('\n'), { cc: copies.join(',') },
                              submission, 'flag message written by ' + entry.email);
  if (!result.sent) {
    // Held by mail.gs (the mode, a duplicate, a cap, the quota): the sheet must not say
    // sent, and the clock then reminds the curator to write (code review 2026-10-16, 3).
    return 'A message to the submitter was written but NOT sent (' + result.held + '). ' +
           'A curator must write to them, or it goes out when the mail mode allows.';
  }

  var stamp = isoNow_();
  writeFields_(TAB_SUBMISSIONS, row._row, { last_to_submitter: stamp });
  // Mark the Verdicts row just written (the last one for this id by this curator).
  var verdicts = readTable_(TAB_VERDICTS);
  for (var v = verdicts.length - 1; v >= 0; v--) {
    if (verdicts[v].id === submission && verdicts[v].curator === entry.email) {
      writeFields_(TAB_VERDICTS, verdicts[v]._row, { sent_to_submitter_at: stamp });
      break;
    }
  }
  return 'The message to the submitter was sent to ' + to + ' as written, from MalAvi, ' +
         'with ' + copies.join(' and ') + ' in copy.';
}


// ---------------------------------------------------------------------------------------
// The notice to the curators
// ---------------------------------------------------------------------------------------

/**
 * Compose the subject and body for one form response. Separate from the sending so that
 * `testVerdictNotification` and a reader of this file can see exactly what goes out.
 * `outcome` carries what the sheet and the submitter message did (both optional).
 */
function composeEntryNotice(entry, outcome) {
  var result = outcome || { sheet: '', submitter: '' };
  var submission = answerTo(entry, TITLE_SUBMISSION_ID) || 'a submission';
  var action = answerTo(entry, TITLE_ACTION);
  var verdict = answerTo(entry, TITLE_VERDICT);
  var who = entry.email || 'an address the form did not record';

  // The subject says what happened in the fewest words that are still true. For a verdict
  // that is the verdict; for the five other routes it is the route's own name.
  var what;
  if (verdict) {
    what = (VERDICT_WORDS[verdict] || verdict) + ' on the form';
  } else if (action) {
    what = action;
  } else {
    what = 'an entry on the verdict form';
  }
  var subject = 'MalAvi: ' + submission + ': ' + what + ' (' + who + ')';

  var lines = [
    '[this is an automatic email]',
    '',
    who + ' recorded this on the MalAvi verdict form at ' +
      Utilities.formatDate(entry.recorded, 'GMT', "yyyy-MM-dd HH:mm 'GMT'") + ':',
    ''
  ];

  // Every answered question, in the form's order and under the form's own titles. A long
  // answer (the reasoning) goes on its own indented lines so it reads as a quotation.
  for (var i = 0; i < entry.answers.length; i++) {
    var title = entry.answers[i].title.replace(/[?:]\s*$/, '');
    var value = entry.answers[i].value;
    if (value.length > 60 || value.indexOf('\n') !== -1) {
      lines.push(title + ':');
      var parts = value.split('\n');
      for (var p = 0; p < parts.length; p++) lines.push('    ' + parts[p]);
    } else {
      lines.push(title + ': ' + value);
    }
  }

  lines.push('');
  // One line per paragraph, not hand-wrapped: a mail client re-wraps to its own width.
  lines.push('This is what was entered on the form, sent the moment it was submitted. It '
      + 'takes effect when the ledger next reads the form and checks it against the rules '
      + '(a registered curator, the current revision of the submission).');

  if (entry.email && !onCuratorList(entry.email)) {
    lines.push('');
    lines.push('Note: ' + entry.email + ' is not on the list of curators this notice is '
        + 'sent to. The ledger decides whether the entry counts.');
  }

  if (verdict === VERDICT_FLAG) {
    lines.push('');
    lines.push('A flag blocks the submission until the curator who placed it withdraws it '
        + 'or a lead curator clears it.');
  }
  if (verdict === VERDICT_REJECT) {
    lines.push('');
    lines.push('Reject is for data that should not be in MalAvi at all. Nothing is sent to '
        + 'the submitter until a lead curator closes the submission. If the problem could '
        + 'be fixed, a flag is the right entry instead.');
  }
  if (result.submitter) {
    lines.push('');
    lines.push('Submitter: ' + result.submitter);
  }
  if (result.sheet) {
    lines.push('');
    lines.push(result.sheet);
  }

  lines.push('');
  lines.push('--');
  lines.push('Confidential. A reason can quote unpublished data. Please do not forward '
      + 'this email.');

  return { subject: subject, body: lines.join('\n') };
}


/**
 * Send the notice: to every curator when a curator made the entry, to the first address
 * only when somebody else did.
 *
 * The person who clicked gets it too, on purpose: it is their acknowledgment that the
 * entry arrived, which the form itself never gave them.
 *
 * AN ENTRY FROM AN ADDRESS THAT IS NOT ON THE LIST GOES TO THE FIRST ADDRESS ONLY. The
 * form accepts a response from anyone signed in to Google who has its link, and this
 * script mails whatever they typed. Sent to everyone, that would let a stranger with a
 * forwarded link put arbitrary text in every curator's inbox under MalAvi's name and use
 * up the account's daily sending quota. A registered curator answering from an address
 * that is not on this list yet is the innocent case; the first address (the lead) sees it
 * and the ledger still decides whether it counts.
 *
 * One send per address, each in its own try: a bad address must not stop the others.
 */
function notifyCuratorsOfEntry(entry, outcome) {
  var curators = curators_();
  if (!curators.length) {
    // Thrown, not returned: the trigger's catch then mails the account that owns the
    // script, which is the only address left to tell.
    throw new Error('CURATORS is not set (Project Settings > Script Properties)');
  }
  var notice = composeEntryNotice(entry, outcome);
  var recipients = onCuratorList(entry.email) ? curators : curators.slice(0, 1);
  var submission = answerTo(entry, TITLE_SUBMISSION_ID);
  // The identity of this notice is the RESPONSE: who recorded what, when. The same
  // response announced twice is one message (mail.gs duplicate check).
  var key = 'verdict-form|' + submission + '|' + String(entry.email).toLowerCase() + '|' +
            isoNow_(entry.recorded);
  var sent = 0;
  var failures = [];
  for (var i = 0; i < recipients.length; i++) {
    try {
      var result = sendMail_({ to: recipients[i], subject: notice.subject, body: notice.body,
                               kind: 'curator', submissionId: submission, key: key,
                               note: 'verdict form entry by ' + entry.email });
      if (result.sent) sent += 1;
    } catch (err) {
      failures.push(recipients[i] + ': ' + err);
    }
  }
  if (failures.length) {
    // Raised after the loop, so everyone who could be told was told; the trigger's own
    // handler then reports the failure to the first address.
    throw new Error('could not send to ' + failures.join('; '));
  }
  return sent;
}


/**
 * Attach onVerdictRecorded to the verdict form. installAllTriggers (triggers.gs) does
 * this together with the others; this one exists for installing it alone. Safely
 * repeatable: any existing trigger for this handler is removed first.
 */
function installVerdictTrigger() {
  requireSetting_('CURATORS');
  var formId = requireSetting_('VERDICT_FORM_ID');
  var existing = ScriptApp.getProjectTriggers();
  var removed = 0;
  for (var i = 0; i < existing.length; i++) {
    if (existing[i].getHandlerFunction() === 'onVerdictRecorded') {
      ScriptApp.deleteTrigger(existing[i]);
      removed++;
    }
  }
  ScriptApp.newTrigger('onVerdictRecorded')
      .forForm(formId)
      .onFormSubmit()
      .create();
  Logger.log((removed ? 'Removed ' + removed + ' existing trigger(s). ' : '') +
             'Installed onVerdictRecorded on form ' + formId);
}


