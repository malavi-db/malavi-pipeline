/**
 * Build the "update a submission" form from code, and its notifier.
 *
 * WHY THIS EXISTS
 * ---------------
 * When a curator flags a submission and writes to the submitter, the answer that comes
 * back is a sentence, or the corrected template attached to an email. Nobody wants to go
 * through the whole submission form again, and they should not: a fresh submission mints
 * a new id and a new date, and the names they reserved would be lost to anyone who claimed
 * them in between. This form takes the answer as an UPDATE to the original submission: its
 * id, what changed, and the corrected template if there is one.
 * curation/fetch_updates.py files it as a new revision of the original (same id, same
 * date, same names) and the intake cycle screens and reports it again.
 *
 * Any curator may also fill this form in on a submitter's behalf, from an emailed answer
 * or an attached spreadsheet. That is the written-down rule, so that it does not default
 * to the maintainer.
 *
 * HOW TO RUN IT
 * -------------
 *   1. Sign in as the MalAvi operational account (malaviadmin@gmail.com). The account that
 *      runs this OWNS the form.
 *   2. script.google.com > New project, paste this file in, name it "MalAvi update form".
 *   3. Run `createUpdateForm`. Authorize when asked (Forms, Sheets).
 *   4. Read View > Logs. Then do every step in `finishByHand()` below: Apps Script cannot
 *      add a file-upload question, and the upload is the point.
 *   5. Put the responses sheet id in config/project.yml as
 *      submissions.update_responses_sheet, and the public URL as
 *      submissions.update_form_url. Share the sheet Viewer with the fetcher's service
 *      account (as the verdict sheet is; curation/GOOGLE_ACCESS.md).
 *   6. Set the CURATORS and UPDATE_FORM_ID Script Properties (settings.gs; run
 *      `showSettings` until READY), run `installUpdateTrigger`, then `showTriggers`.
 *
 * WHAT THE NOTIFIER SAYS
 * ----------------------
 * That an update arrived for submission X, from which address, with the submitter's note
 * and how many files. It goes to every curator; the flag that asked for the update was one
 * of theirs. Nothing is decided here, and the fetch decides nothing either: a revision
 * clears the earlier approvals, and the curators look at the new report.
 */

// The addresses are the CURATORS Script Property (settings.gs, pasted into this project
// as a second file; set under Project Settings > Script Properties; run showSettings).
// No live value is written in this published file.
var SETTINGS_NEEDED_UPDATE_FORM = ['CURATORS', 'UPDATE_FORM_ID'];
// CURATORS is read through curators_() (settings.gs) at the moment it is needed.

// The form's id, for installUpdateTrigger: the UPDATE_FORM_ID Script Property, set from
// createUpdateForm's log; the live value is recorded in CUSTODY_PRIVATE.md, not here.
// UPDATE_FORM_ID is read with setting_('UPDATE_FORM_ID') when the trigger is installed.

// Question titles. curation/fetch_updates.py reads the responses sheet by a lowercase
// substring of these ("submission id", "what changed", "template file"), so a change
// here is a change there.
var TITLE_ID = 'Submission id';
var TITLE_CHANGED = 'What changed?';
var TITLE_FILE = 'Upload the corrected template file (optional)';


function createUpdateForm() {
  var form = FormApp.create('MalAvi — update a submission');
  form.setDescription(
      'For answering a curator\'s question about a submission you already made, without ' +
      'filling in the submission form again. Your submission keeps its id, its date and ' +
      'the lineage names it reserved.\n\n' +
      'Give the submission id from the email you received (it looks like ' +
      'MALAVI-SUB-2026-000123), say what changed, and attach the corrected template if ' +
      'you have one. A curator will look at the new version.');

  setVerifiedEmailCollection(form);
  form.setProgressBar(false);
  form.setAllowResponseEdits(false);     // a second thought is a second update
  form.setLimitOneResponsePerUser(false);

  form.addTextItem()
      .setTitle(TITLE_ID)
      .setHelpText('From the email about your submission. Looks like MALAVI-SUB-2026-000123.')
      .setValidation(FormApp.createTextValidation()
          .requireTextMatchesPattern('^\\s*MALAVI-SUB-\\d{4}-\\d{6}\\s*$')
          .setHelpText('A MalAvi submission id looks like MALAVI-SUB-2026-000123.')
          .build())
      .setRequired(true);

  form.addParagraphTextItem()
      .setTitle(TITLE_CHANGED)
      .setHelpText('In a few words: which lineage, sample or record, and what is different ' +
                   'now. If you attach a corrected template, say what you changed in it.')
      .setRequired(true);

  // The file-upload question is added by hand: see finishByHand().

  var sheet = SpreadsheetApp.create('MalAvi — submission updates (responses)');
  // GMT, no daylight saving: the response time is what orders updates.
  sheet.setSpreadsheetTimeZone('Etc/GMT');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  Logger.log('Form (edit)     : ' + form.getEditUrl());
  Logger.log('Form (public)   : ' + form.getPublishedUrl());
  Logger.log('Form id         : ' + form.getId());
  Logger.log('Responses sheet : ' + sheet.getId());
  Logger.log('Sheet timezone  : ' + sheet.getSpreadsheetTimeZone());
  Logger.log('');
  Logger.log('NOT FINISHED: do the steps in finishByHand(), then set');
  Logger.log('  submissions.update_responses_sheet and submissions.update_form_url');
  Logger.log('in config/project.yml, and the UPDATE_FORM_ID Script Property here.');
}


/**
 * The steps Apps Script cannot do. Read this; it runs nothing.
 *
 *   1. Open the form (edit URL in the log). Add a question of type "File upload" with
 *      EXACTLY this title:
 *          Upload the corrected template file (optional)
 *      Allow only specific file types: spreadsheets. Maximum number of files: 3. Maximum
 *      file size: 10 MB. Not required.
 *      The title matters: fetch_updates.py finds the uploaded files by the words
 *      "template file" in the column heading.
 *   2. Settings > Responses: confirm "Collect email addresses" is Verified.
 *   3. Settings > Responses: "Allow response editing" off, "Limit to 1 response" off.
 *   4. Share the responses sheet Viewer with the fetcher's service account (the address
 *      curation/fetch_submissions.py prints), General access Restricted.
 *   5. Share the form's upload folder (Drive, "... (File responses)") Viewer with each
 *      curator, as the submission form's upload folders are shared (RUNBOOK section 3ca).
 */
function finishByHand() {
  Logger.log('This function only documents the manual steps. Read its comment.');
}


function setVerifiedEmailCollection(form) {
  try {
    form.setEmailCollectionType(FormApp.EmailCollectionType.VERIFIED);
    Logger.log('Email collection: VERIFIED (set through the API).');
  } catch (err) {
    try {
      form.setCollectEmail(true);
      Logger.log('WARNING: fell back to setCollectEmail(true); check Settings > Responses > ' +
                 'Collect email addresses > Verified by hand.');
    } catch (err2) {
      Logger.log('ERROR: could not enable email collection (' + err2 + '). Fix by hand.');
    }
  }
}


// ---------------------------------------------------------------------------------------
// The notifier: every curator hears that an update arrived
// ---------------------------------------------------------------------------------------

function onUpdateReceived(e) {
  var entry = { email: '', received: new Date(), id: '', changed: '', files: 0 };
  try {
    if (e && e.response) {
      entry.email = e.response.getRespondentEmail() || '';
      entry.received = e.response.getTimestamp() || new Date();
      var items = e.response.getItemResponses();
      for (var i = 0; i < items.length; i++) {
        var title = items[i].getItem().getTitle().toLowerCase();
        var value = items[i].getResponse();
        if (Object.prototype.toString.call(value) === '[object Array]') {
          entry.files += value.length;
        } else if (title.indexOf('submission id') !== -1) {
          entry.id = String(value || '').trim();
        } else if (title.indexOf('what changed') !== -1) {
          entry.changed = String(value || '').trim();
        }
      }
    }
    try {
      recordUpdateOnSheet_(entry);
    } catch (err0) {
      Logger.log('Could not record the update on the status sheet: ' + err0);
    }
    notifyCuratorsOfUpdate(entry);
  } catch (err) {
    Logger.log('FAILED to send the update notice: ' + err);
    sendMail_({ to: fallbackAddress_(), subject: 'MalAvi: update notice FAILED',
                body: 'An update arrived on the update form but the notice failed:\n\n' + err +
                      '\n\nOpen the responses sheet to see it.',
                kind: 'system', force: true, note: 'update notice failed' });
  }
}


function composeUpdateNotice(entry) {
  var subject = 'MalAvi: ' + (entry.id || 'a submission') + ': an update from the submitter';
  var lines = [
    '[this is an automatic email]',
    '',
    'An update arrived on the MalAvi update form for submission ' +
      (entry.id || '(no id given)') + ', from ' + (entry.email || 'an address the form did not record') +
      ', at ' + Utilities.formatDate(entry.received, 'GMT', "yyyy-MM-dd HH:mm 'GMT'") + '.',
    '',
    'Files attached: ' + (entry.files ? entry.files : 'none') + '.',
    ''
  ];
  if (entry.changed) {
    lines.push('What changed, in their words:');
    var parts = entry.changed.split('\n');
    for (var p = 0; p < parts.length; p++) lines.push('    ' + parts[p]);
    lines.push('');
  }
  lines.push(entry.files
    ? 'The intake programs file the attached template as a new revision of the original '
      + 'submission, screen it, and send the new report to the curators. Earlier '
      + 'acceptances do not carry over to a new revision.'
    : 'No file was attached, so there is nothing to screen. Whoever flagged the '
      + 'submission reads the words above and either files what they say as a correction '
      + 'on the verdict form or asks the submitter for the template.');
  lines.push('');
  lines.push('--');
  lines.push('Confidential. A submission may contain unpublished sequences. Please do not '
      + 'forward this email.');
  return { subject: subject, body: lines.join('\n') };
}


function notifyCuratorsOfUpdate(entry) {
  var curators = curators_();
  if (!curators.length) {
    throw new Error('CURATORS is not set (Project Settings > Script Properties)');
  }
  var notice = composeUpdateNotice(entry);
  var key = 'update|' + (entry.id || '') + '|' + String(entry.email || '').toLowerCase() +
            '|' + isoNow_(entry.received);
  var failures = [];
  for (var i = 0; i < curators.length; i++) {
    try {
      sendMail_({ to: curators[i], subject: notice.subject, body: notice.body,
                  kind: 'curator', submissionId: entry.id || '', key: key,
                  note: 'update notice' });
    } catch (err) {
      failures.push(curators[i] + ': ' + err);
    }
  }
  if (failures.length) throw new Error('could not send to ' + failures.join('; '));
}


/**
 * An update is the submitter writing to us: note it on the Submissions row
 * (last_from_submitter) and the Mail tab, so the clock stops asking them and the
 * assignee sees it. Nothing is written when there is no status sheet.
 */
function recordUpdateOnSheet_(entry) {
  if (!statusSheetEnabled_()) return;
  var stamp = isoNow_(entry.received);
  recordMail_({ direction: 'in', id: entry.id || '', from: entry.email || '',
                to: 'update form', subject: 'update form response',
                note: (entry.files ? entry.files + ' file(s); ' : 'no file; ') +
                      (entry.changed || '').slice(0, 200) });
  if (/^MALAVI-SUB-\d{4}-\d{6}$/.test(entry.id || '')) {
    var row = findRow_(TAB_SUBMISSIONS, 'id', entry.id);
    if (row) writeFields_(TAB_SUBMISSIONS, row._row, { last_from_submitter: stamp });
  }
}


// installAllTriggers (triggers.gs) attaches onUpdateReceived with the others; this one
// exists for installing it alone.
function installUpdateTrigger() {
  requireSetting_('CURATORS');
  var formId = requireSetting_('UPDATE_FORM_ID');
  var existing = ScriptApp.getProjectTriggers();
  for (var i = 0; i < existing.length; i++) {
    if (existing[i].getHandlerFunction() === 'onUpdateReceived') ScriptApp.deleteTrigger(existing[i]);
  }
  ScriptApp.newTrigger('onUpdateReceived').forForm(formId).onFormSubmit().create();
  Logger.log('Installed onUpdateReceived on form ' + formId);
}


function testUpdateNotification() {
  requireSetting_('CURATORS');
  var curators = curators_();
  notifyCuratorsOfUpdate({ email: curators[0], received: new Date(), id: 'MALAVI-SUB-0000-TEST',
                           changed: 'This is a test of the update notice. No update was made.',
                           files: 1 });
  Logger.log('Sent a sample to ' + curators.length + ' address(es).');
}


// ======================================================================================
// FILE: inbox_triage.gs
// ======================================================================================

/**
 * Triage the MalAvi inbox: file every incoming message under its submission, forward it to
 * the curator who owns that submission, and record it on the status sheet.
 *
 * WHY THIS EXISTS
 * ---------------
 * Mail to malaviadmin@gmail.com forwards to one person (CUSTODY_PRIVATE.md, set
 * 2026-09-24). A submitter's reply, a corrected workbook, a curator's note all land in
 * that one inbox, mixed with everything else, and nothing records who was written to or
 * when. By 2026-10-16 the maintainer was "overwhelmed by the emails of submissions" and
 * could not tell what was waiting on whom. This script is the answer that needs no new
 * service and no Google Group: the account reads its own inbox on a timer and does the
 * sorting a person was doing by hand.
 *
 * WHAT IT DOES, EVERY 15 MINUTES (triggers.gs)
 * --------------------------------------------
 * For each message in the inbox from the last 14 days that it has not seen before (the
 * Mail tab remembers message ids) and that the account did not send itself:
 *   1. Find the submission: a MALAVI-SUB-YYYY-NNNNNN id anywhere in the subject or body,
 *      else the sender's address matched against the submitter addresses on the
 *      Submissions tab (the most recent open one wins).
 *   2. Matched: label the thread "MalAvi/filed" and "MalAvi/<id>"; write a Mail row;
 *      if the sender is THE SUBMITTER of that submission (the address on the Submissions
 *      row), set last_from_submitter and FORWARD the message to the assignee and the leads
 *      (never to whoever sent it, never to people already on the message), with the id in
 *      the subject and reply-to set to the submitter, so "Reply" answers them and "Reply
 *      all" keeps the MalAvi address in the thread. Mail from anyone else that mentions an
 *      id (a curator's reply-all, a stranger quoting a public id) is filed and logged but
 *      NOT forwarded: curators are already on their own threads, and ids are public
 *      (review 2026-10-16, finding 2).
 *   3. Not matched: label the thread "MalAvi/unfiled" and write a Mail row with no id.
 *      Nothing is forwarded; the daily digest lists these for the leads. (Gmail's own
 *      forwarding to the custodian, if still on, is untouched by this script.)
 * It also records the account's own SENT mail of the last 14 days to a submitter's
 * address (a lead writing from malaviadmin by hand) as an outgoing Mail row and sets
 * last_to_submitter, so the clock knows the submitter was written to.
 *
 * WHAT IT NEVER DOES
 * ------------------
 * It deletes nothing, archives nothing, marks nothing read, and never replies. It never
 * forwards an unmatched message anywhere: a stranger's mail must not be able to make this
 * account relay text to the curators. The body of a message is read only to look for a
 * submission id and is quoted nowhere.
 *
 * QUOTA
 * -----
 * Each forward is one send against the account's daily limit (about 100 recipients a day
 * for a consumer account, shared with every report and notice). At most
 * MAX_MESSAGES_PER_RUN messages are handled and MAX_FORWARDS_PER_RUN forwarded per run,
 * only submitters' mail is forwarded, and nothing is forwarded when the remaining daily
 * quota is below QUOTA_RESERVE, so a burst of mail cannot silence the real notices.
 */

var SETTINGS_NEEDED_TRIAGE = ['STATUS_SHEET_ID', 'ATTENTION_TO'];

var LABEL_FILED = 'MalAvi/filed';
var LABEL_UNFILED = 'MalAvi/unfiled';
var LABEL_PREFIX = 'MalAvi/';

var SUBMISSION_ID_RE = /MALAVI-SUB-\d{4}-\d{6}/;
var MAX_MESSAGES_PER_RUN = 40;
var MAX_FORWARDS_PER_RUN = 10;
var QUOTA_RESERVE = 30;
var TRIAGE_WINDOW_DAYS = 14;

// Senders that are machinery, not people. Their mail is left alone entirely.
var TRIAGE_SKIP_SENDERS = /(noreply|no-reply|do-not-reply|notification|mailer-daemon|postmaster|forms-receipts|drive-shares|calendar-notification)@/i;


/** The address this script runs as (malaviadmin), lower case. Falls back to the active
 *  user; '' when neither is known, which the caller treats as "do not run" rather than
 *  risk forwarding the account's own replies (review 2026-10-16, "could not verify"). */
function ownAddress_() {
  var address = '';
  try { address = Session.getEffectiveUser().getEmail() || ''; } catch (err) { address = ''; }
  if (!address) {
    try { address = Session.getActiveUser().getEmail() || ''; } catch (err2) { address = ''; }
  }
  return String(address).trim().toLowerCase();
}


/** The plain address out of "Name <addr>" or a bare address, lower case. */
function bareAddress_(text) {
  var found = String(text || '').match(/[^<\s,;"']+@[^>\s,;"']+/);
  return found ? found[0].toLowerCase() : '';
}


/** A Gmail label by name, created if missing. */
function label_(name) {
  return GmailApp.getUserLabelByName(name) || GmailApp.createLabel(name);
}


/** The message ids already on the Mail tab, as a set. */
function knownMessageIds_() {
  var rows = readTable_(TAB_MAIL);
  var known = {};
  for (var i = 0; i < rows.length; i++) {
    if (rows[i].message_id) known[rows[i].message_id] = true;
  }
  return known;
}


/**
 * Submitter address -> the Submissions row to file their mail under. When one person has
 * several submissions, the open one received most recently wins; a closed one is used
 * only when nothing is open.
 */
function submitterIndex_(rows) {
  var index = {};
  for (var i = 0; i < rows.length; i++) {
    var address = (rows[i].submitter_email || '').toLowerCase();
    if (!address) continue;
    var isOpen = !rows[i].state || LIVE_STATES.indexOf(rows[i].state) !== -1;
    var current = index[address];
    if (!current) { index[address] = rows[i]; index[address]._open = isOpen; continue; }
    if (isOpen && !current._open) { index[address] = rows[i]; rows[i]._open = true; continue; }
    if (isOpen === current._open && (rows[i].received || '') > (current.received || '')) {
      index[address] = rows[i]; rows[i]._open = isOpen;
    }
  }
  return index;
}


/** The submission a message belongs to: by id in the text, else by sender. '' if none. */
function matchSubmission_(message, rows, index) {
  var text = message.getSubject() + '\n' + message.getPlainBody().slice(0, 20000);
  var found = text.match(SUBMISSION_ID_RE);
  if (found) return found[0];
  var sender = bareAddress_(message.getFrom());
  var row = sender ? index[sender] : null;
  return row ? row.id : '';
}


/**
 * The trigger. Runs every 15 minutes; does nothing without a status sheet.
 */
function triageInbox() {
  if (!statusSheetEnabled_()) return;
  withSheetLock_(triageInboxLocked_);
}


function triageInboxLocked_() {
  var me = ownAddress_();
  if (!me) {
    logEvent_('triageInbox', 'SKIPPED: the account\'s own address is not known in this ' +
              'context, so our own replies could not be told from incoming mail');
    return;
  }
  var quotaLeft = MailApp.getRemainingDailyQuota();
  var known = knownMessageIds_();
  var rows = readTable_(TAB_SUBMISSIONS);
  var index = submitterIndex_(rows);
  var handled = 0, filed = 0, unfiled = 0, forwarded = 0, outgoing = 0;

  // ---- incoming ---------------------------------------------------------------------
  var threads = GmailApp.search('in:inbox newer_than:' + TRIAGE_WINDOW_DAYS + 'd -in:spam ' +
                                '-in:trash', 0, 60);
  for (var t = 0; t < threads.length && handled < MAX_MESSAGES_PER_RUN; t++) {
    var messages = threads[t].getMessages();
    for (var m = 0; m < messages.length && handled < MAX_MESSAGES_PER_RUN; m++) {
      var message = messages[m];
      var messageId = message.getId();
      if (known[messageId]) continue;
      var sender = bareAddress_(message.getFrom());
      if (!sender || sender === me) continue;                 // our own sends
      if (TRIAGE_SKIP_SENDERS.test(sender)) continue;         // machinery
      if (daysBetween_(message.getDate(), new Date()) > TRIAGE_WINDOW_DAYS) continue;
      handled += 1;
      known[messageId] = true;

      var threadUrl = 'https://mail.google.com/mail/u/0/#all/' + threads[t].getId();
      var id = '';
      try { id = matchSubmission_(message, rows, index); } catch (err) { id = ''; }

      if (!id) {
        threads[t].addLabel(label_(LABEL_UNFILED));
        recordMail_({ direction: 'in', id: '', from: sender, to: me,
                      subject: message.getSubject(), thread_url: threadUrl,
                      message_id: messageId, note: 'unfiled: no submission id and no ' +
                      'known submitter address' });
        unfiled += 1;
        continue;
      }

      threads[t].addLabel(label_(LABEL_FILED));
      threads[t].addLabel(label_(LABEL_PREFIX + id));
      var row = null;
      for (var r = 0; r < rows.length; r++) if (rows[r].id === id) { row = rows[r]; break; }
      var fromSubmitter = !!(row && row.submitter_email &&
                             row.submitter_email.toLowerCase() === sender);
      var note = fromSubmitter ? 'from the submitter' : 'about the submission (not from its submitter)';

      // The Mail row is written BEFORE the forward: the row is the dedupe record, and a
      // forward that went out without one would go out again every run (finding 6).
      var mailRow = recordMail_({ direction: 'in', id: id, from: sender, to: me,
                                  subject: message.getSubject(), thread_url: threadUrl,
                                  message_id: messageId, note: note });
      if (!mailRow) {
        logEvent_('triageInbox', 'Mail tab write failed for ' + messageId + '; not forwarding');
        filed += 1;
        continue;
      }

      // Only the submitter's own mail is forwarded. Curators are on their own threads;
      // strangers can quote a public id (finding 2).
      var recipients = fromSubmitter ? forwardRecipients_(row, sender, message) : [];
      if (recipients.length && forwarded >= MAX_FORWARDS_PER_RUN) {
        note += '; forward deferred to the next run (per-run cap)';
        known[messageId] = false;        // not handled: picked up next run
        writeFields_(TAB_MAIL, mailRow, { note: note });
        // Leave the row so the message is not re-recorded; clear its id so it is retried.
        writeFields_(TAB_MAIL, mailRow, { message_id: '' });
        continue;
      }
      if (recipients.length) {
        // mail.gs applies the mode, the duplicate check (this message id to this
        // address), the per-run cap and the quota reserve, and records each recipient.
        var outcome = forwardMail_(message, recipients, {
          subject: '[MalAvi ' + id + '] ' + message.getSubject(),
          name: 'MalAvi',
          replyTo: sender,
          htmlBody: forwardPreface_(id, row, sender) + message.getBody()
        }, 'curator', id, 'forward of the submitter\'s mail');
        if (outcome.sent) {
          forwarded += 1;
          quotaLeft -= outcome.sent;
          note += '; forwarded to ' + outcome.sent + ' address(es)';
        }
        var retry = false;
        for (var h = 0; h < outcome.held.length; h++) {
          note += '; NOT forwarded to ' + outcome.held[h].to + ': ' + outcome.held[h].reason;
          if (outcome.held[h].reason !== 'duplicate') retry = true;
        }
        if (retry && !outcome.sent) {
          // Held by the mode, a cap or the quota: clear the id so the next run tries
          // again, the same way the per-run cap above does (code review 2026-10-16, 12).
          known[messageId] = false;
          writeFields_(TAB_MAIL, mailRow, { message_id: '' });
        }
      } else if (fromSubmitter) {
        note += '; not forwarded (everyone to tell is already on the message)';
      }
      writeFields_(TAB_MAIL, mailRow, { note: note });
      if (row && fromSubmitter) {
        var stamp = isoNow_(message.getDate());
        if (!row.last_from_submitter || row.last_from_submitter < stamp) {
          writeFields_(TAB_SUBMISSIONS, row._row, { last_from_submitter: stamp });
          row.last_from_submitter = stamp;
        }
      }
      filed += 1;
    }
  }

  // ---- outgoing, written by hand from this account --------------------------------------
  var sentThreads = GmailApp.search('in:sent newer_than:' + TRIAGE_WINDOW_DAYS + 'd', 0, 40);
  for (var s = 0; s < sentThreads.length; s++) {
    var sentMessages = sentThreads[s].getMessages();
    for (var k = 0; k < sentMessages.length; k++) {
      var out = sentMessages[k];
      var outId = out.getId();
      if (known[outId]) continue;
      if (bareAddress_(out.getFrom()) !== me) continue;
      // Automatic sends are already on the Mail tab (sendAndRecord_) or carry a marker.
      var outBody = out.getPlainBody();
      if (outBody.indexOf('[this is an automatic email]') !== -1 ||
          outBody.indexOf(AUTOMATIC_FOOTER) !== -1 ||
          outBody.indexOf('[forwarded automatically by MalAvi]') !== -1 ||
          out.getSubject().indexOf('[MalAvi MALAVI-SUB-') === 0) continue;   // our own forwards
      var toAddresses = String(out.getTo() + ',' + out.getCc()).toLowerCase()
          .match(/[^<\s,;"']+@[^>\s,;"']+/g) || [];
      var matchedRow = null;
      for (var a = 0; a < toAddresses.length && !matchedRow; a++) {
        matchedRow = index[toAddresses[a]] || null;
      }
      var subjectId = (out.getSubject() + out.getPlainBody().slice(0, 5000)).match(SUBMISSION_ID_RE);
      var outSubmission = subjectId ? subjectId[0] : (matchedRow ? matchedRow.id : '');
      if (!outSubmission) continue;                 // unrelated mail from the account
      known[outId] = true;
      recordMail_({ direction: 'out', id: outSubmission, from: me, to: out.getTo(),
                    subject: out.getSubject(),
                    thread_url: 'https://mail.google.com/mail/u/0/#all/' + sentThreads[s].getId(),
                    message_id: outId, note: 'written by hand from the MalAvi account' });
      outgoing += 1;
      if (matchedRow) {
        var sentStamp = isoNow_(out.getDate());
        if (!matchedRow.last_to_submitter || matchedRow.last_to_submitter < sentStamp) {
          writeFields_(TAB_SUBMISSIONS, matchedRow._row, { last_to_submitter: sentStamp });
          matchedRow.last_to_submitter = sentStamp;
        }
      }
    }
  }

  if (handled || outgoing) {
    logEvent_('triageInbox', handled + ' new incoming (' + filed + ' filed, ' + unfiled +
              ' unfiled, ' + forwarded + ' forwarded); ' + outgoing + ' outgoing recorded');
  }
}


/** Who a submitter's message is forwarded to: the assignee and the leads, never the
 *  sender, never anyone already in the message's To or Cc. */
function forwardRecipients_(row, sender, message) {
  var wanted = [];
  if (row && row.assignee) wanted.push(row.assignee);
  var leads = attentionTo_();
  for (var i = 0; i < leads.length; i++) wanted.push(leads[i]);
  var already = {};
  if (message) {
    var onIt = String(message.getTo() + ',' + message.getCc()).toLowerCase()
        .match(/[^<\s,;"']+@[^>\s,;"']+/g) || [];
    for (var k = 0; k < onIt.length; k++) already[onIt[k]] = true;
  }
  var seen = {};
  var out = [];
  for (var j = 0; j < wanted.length; j++) {
    var address = wanted[j].toLowerCase();
    if (!address || address === sender || seen[address] || already[address]) continue;
    seen[address] = true;
    out.push(wanted[j]);
  }
  return out;
}


/** The lines above a forwarded message: what it is, who owns it, how to answer. */
function forwardPreface_(id, row, sender) {
  var owner = row && row.assignee ? curatorName_(row.assignee) : 'nobody yet';
  var who = row && row.submitter_email && row.submitter_email.toLowerCase() === sender
      ? 'the submitter' + (row.submitter_name ? ' (' + row.submitter_name + ')' : '')
      : sender;
  return '<p style="font-family:sans-serif;font-size:90%;color:#444">' +
         '[forwarded automatically by MalAvi] Mail from ' + who + ' about <b>' + id +
         '</b> (assigned to ' + owner +
         (row && row.state ? '; state ' + row.state : '') + '). ' +
         'Reply answers the sender; Reply all keeps the MalAvi address in the thread, ' +
         'which is how the message is filed. The original follows.</p><hr>';
}


/** HAND FUNCTION. Run one triage pass now and print what it did. */
function triageInboxNow() {
  if (!statusSheetEnabled_()) { Logger.log('STATUS_SHEET_ID is not set.'); return; }
  triageInbox();
  var rows = readTable_(TAB_MAIL);
  Logger.log(rows.length + ' row(s) on the Mail tab. Last five:');
  for (var i = Math.max(0, rows.length - 5); i < rows.length; i++) {
    Logger.log([rows[i].at, rows[i].direction, rows[i].id || '(unfiled)', rows[i].from,
                rows[i].subject].join(' | '));
  }
}


// ======================================================================================
// FILE: daily_clock.gs
// ======================================================================================

/**
 * The daily clock: reminders to whoever a submission is waiting on, and one digest a day
 * to the leads.
 *
 * WHY
 * ---
 * The curators agreed (2026-10-15/16) to one assigned reviewer per submission, a two-week
 * clock, and reminders at 7 and 14 days. Before this, the only reminder in the system was
 * `ledger.stale_live`, which told the maintainer, after 30 days, only when promote.py ran.
 * Submissions sat for weeks with nobody written to. This runs once a day on Google's own
 * timer (triggers.gs), reads the status sheet, and sends what the rules below say. It
 * never changes a verdict or a state: it only reminds, and it logs every reminder.
 *
 * THE RULES (one row = one submission on the Submissions tab)
 * ----------------------------------------------------------
 *   needs a verdict   state ready_for_review / in_review (or not yet synced) with a report
 *                     and no verdict by the assignee since that report:
 *                       >= 7 days  -> remind the assignee
 *                       >= 14 days -> remind every curator (the assignee by name)
 *                       >= 21 days -> REASSIGN to the next available curator; both are
 *                                     told; the first is released, not nagged again
 *                                     (what Kubernetes and Flutter do when an owner's
 *                                     clock runs out; research report item 2)
 *                     Unassigned rows with a report and no verdict are ASSIGNED first
 *                     (the backlog from before assignment existed), and the new assignee
 *                     is emailed.
 *   about to go       state awaiting_submitter for 53 days or more -> digest ("goes
 *   dormant           dormant this week"), so the 60-day step is never a surprise
 *                     (research report item 8: automation must not close silently).
 *   flagged           state held: the flag's message to the submitter was not sent by the
 *                     verdict trigger and nobody has written to the submitter since the
 *                     flag -> after 3 days remind the curator who flagged (else the
 *                     assignee) to write.
 *   waiting on the    state awaiting_submitter: >= 14 days since the submitter was last
 *   submitter         written to -> a short reminder to the submitter, with the update-form
 *                     link; again at >= 30 days. Never after that: the ledger's 60-day
 *                     clock takes over (dormant).
 *   arrival with no   an Arrivals row more than 2 days old with no matching Submissions
 *   report            row -> digest ("the screen has not run").
 *   hold elapsed,     state approved with hold_ends more than a day in the past and the
 *   nothing happened  sheet not synced since -> digest ("the cycle has not run").
 *   sheet stale       the newest synced_at older than 36 hours -> digest, first line.
 *   unfiled mail      Mail rows without an id since the last digest -> digest.
 *
 * Every reminder to a person is throttled by the row's last_reminder (nothing twice within
 * six days); the submitter reminders are additionally keyed by threshold in the Log so each
 * fires once. One email per recipient per day, all their reminders in it.
 *
 * THE DIGEST
 * ----------
 * To the leads (ATTENTION_TO), every day there is anything open: the whole queue as a
 * table, then the alerts. It is the one email the maintainer needs instead of the stream.
 */

var SETTINGS_NEEDED_CLOCK = ['STATUS_SHEET_ID', 'CURATORS', 'ATTENTION_TO', 'UPDATE_FORM_URL'];

var REMIND_ASSIGNEE_DAYS = 7;
var REMIND_EVERYONE_DAYS = 14;
var REASSIGN_AFTER_DAYS = 21;
// The ledger's awaiting-submitter timeout (config/project.yml, 60 days) minus a week.
var DORMANT_WARNING_DAYS = 53;
var REMIND_WRITE_TO_SUBMITTER_DAYS = 3;
var REMIND_SUBMITTER_DAYS = [14, 30];
var REMINDER_THROTTLE_DAYS = 6;
var ARRIVAL_WITHOUT_REPORT_DAYS = 2;
var ARRIVAL_GIVE_UP_DAYS = 14;
var SHEET_STALE_HOURS = 36;

var STATES_NEED_VERDICT = ['ready_for_review', 'in_review'];


/**
 * The trigger. Once a day. Does nothing without a status sheet.
 */
function dailyClock() {
  if (!statusSheetEnabled_()) return;
  withSheetLock_(dailyClockLocked_);
}


function dailyClockLocked_() {
  var now = new Date();
  var today = isoNow_(now);
  var rows = readTable_(TAB_SUBMISSIONS);
  var verdicts = readTable_(TAB_VERDICTS);
  var arrivals = readTable_(TAB_ARRIVALS);
  var mail = readTable_(TAB_MAIL);
  var log = readTable_(TAB_LOG);

  var reminders = {};        // address -> [lines]
  var alerts = [];           // lines for the digest
  var changed = 0;

  function remind(address, line) {
    var key = String(address || '').trim();
    if (!key) return;
    if (!reminders[key]) reminders[key] = [];
    reminders[key].push(line);
  }

  // ---- 0. assign the backlog ------------------------------------------------------------
  for (var b = 0; b < rows.length; b++) {
    var row0 = rows[b];
    var open0 = !row0.state || LIVE_STATES.indexOf(row0.state) !== -1;
    var needs0 = !row0.state || STATES_NEED_VERDICT.indexOf(row0.state) !== -1;
    if (!open0 || !needs0 || row0.assignee || !row0.report_at) continue;
    if (verdictsFor_(verdicts, row0.id, row0.report_at).length) continue;
    try {
      var who = nextAssignee_();
      writeFields_(TAB_SUBMISSIONS, row0._row, { assignee: who, assigned_at: today });
      row0.assignee = who;
      row0.assigned_at = today;
      logEvent_('dailyClock', row0.id + ' was unassigned; assigned to ' + who);
      remind(who, 'ASSIGNED TO YOU: ' + row0.id + ' (report of ' +
             String(row0.report_at).slice(0, 10) + ', no verdict yet). Report: ' +
             (row0.report_url || 'see the status sheet') + '. Please record a verdict ' +
             'within two weeks.');
      changed += 1;
    } catch (err0) {
      alerts.push(row0.id + ' is unassigned and could not be assigned: ' + err0);
    }
  }

  // ---- 1. per-row rules -----------------------------------------------------------------
  var newestSync = '';
  for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    if (row.synced_at && row.synced_at > newestSync) newestSync = row.synced_at;
    var open = !row.state || LIVE_STATES.indexOf(row.state) !== -1;
    if (!open) continue;
    var throttled = row.last_reminder && daysBetween_(row.last_reminder, now) < REMINDER_THROTTLE_DAYS;

    // needs a verdict
    var needsVerdict = (!row.state || STATES_NEED_VERDICT.indexOf(row.state) !== -1) && row.report_at;
    if (needsVerdict) {
      // Counted from the assignment when there is one: a curator who got it yesterday
      // (backlog or reassignment) is not behind on a report that is three weeks old
      // (review 2026-10-16, finding 5).
      var waitedDays = daysBetween_(row.assignee ? (row.assigned_at || row.report_at)
                                                 : row.report_at, now);
      var byAssignee = row.assignee
          ? verdictsFor_(verdicts, row.id, row.report_at, row.assignee).length : 0;
      if (row.assignee && !byAssignee && waitedDays !== null) {
        var sinceAssigned = daysBetween_(row.assigned_at || row.report_at, now);
        if (sinceAssigned !== null && sinceAssigned >= REASSIGN_AFTER_DAYS) {
          try {
            var relieved = row.assignee;
            var next = nextAssignee_([relieved]);
            if (next.toLowerCase() !== relieved.toLowerCase()) {
              reassignSubmission_(row.id, next, 'no verdict from ' + curatorName_(relieved) +
                                  ' in ' + sinceAssigned + ' days; reassigned by the clock');
              row.assignee = next; row.assigned_at = today; row.last_reminder = '';
              alerts.push(row.id + ': reassigned from ' + curatorName_(relieved) + ' to ' +
                          curatorName_(next) + ' after ' + sinceAssigned + ' days without a verdict');
              changed += 1;
              continue;
            }
          } catch (errR) {
            alerts.push(row.id + ': could not be reassigned: ' + errR);
          }
        }
        if (waitedDays >= REMIND_EVERYONE_DAYS && !throttled) {
          var everyone = curators_();
          for (var c = 0; c < everyone.length; c++) {
            remind(everyone[c], row.id + ' has waited ' + waitedDays + ' days for a verdict ' +
                   '(assigned to ' + curatorName_(row.assignee) + '). Anyone may record ' +
                   'one. Report: ' + (row.report_url || 'see the status sheet'));
          }
          markReminded_(row, today); changed += 1;
          alerts.push(row.id + ': ' + waitedDays + ' days without a verdict; everyone reminded');
        } else if (waitedDays >= REMIND_ASSIGNEE_DAYS && !throttled) {
          remind(row.assignee, row.id + ' has waited ' + waitedDays + ' days for your ' +
                 'verdict. Report: ' + (row.report_url || 'see the status sheet') +
                 '. If you cannot take it, reply to this email and a lead will reassign it.');
          markReminded_(row, today); changed += 1;
        }
      }
    }

    // flagged, submitter not yet written to
    if (row.state === 'held') {
      var flags = verdictsFor_(verdicts, row.id, '', '', 'Flag for further review');
      if (!flags.length && row.waiting_on === 'flag' && row.waiting_since) {
        // A flag recorded before the sheet existed (or on a form the trigger missed): the
        // ledger sync still says the row waits on a flag and since when. Treat that as the
        // flag, with the assignee as the person to write (first live day, 2026-10-16: the
        // three held submissions had no Verdicts row and nobody was nudged).
        flags = [{ recorded_at: row.waiting_since, curator: row.assignee || '',
                   sent_to_submitter_at: '' }];
      }
      if (flags.length) {
        var latest = flags[flags.length - 1];
        var writtenSince = row.last_to_submitter && row.last_to_submitter >= latest.recorded_at;
        // A reply from the submitter after the flag means they were written to, by
        // somebody, somehow; do not ask anyone to write again (finding 1).
        var repliedSince = row.last_from_submitter && row.last_from_submitter >= latest.recorded_at;
        if (!latest.sent_to_submitter_at && !writtenSince && !repliedSince &&
            daysBetween_(latest.recorded_at, now) >= REMIND_WRITE_TO_SUBMITTER_DAYS &&
            !throttled) {
          var writer = onCuratorList(latest.curator) ? latest.curator : (row.assignee || '');
          if (writer) {
            remind(writer, row.id + ' was flagged on ' + String(latest.recorded_at).slice(0, 10) +
                   ' and the submitter has not been written to. Please write to ' +
                   (row.submitter_email || 'them') + ' (copy the MalAvi address so the ' +
                   'message is filed), or reply here and a lead will.');
            markReminded_(row, today); changed += 1;
          }
          alerts.push(row.id + ': flagged ' + daysBetween_(latest.recorded_at, now) +
                      ' days ago, submitter not written to' +
                      (writer ? ' (reminder to ' + curatorName_(writer) + ')' : ''));
        }
      }
    }

    // waiting on the submitter
    if (row.state === 'awaiting_submitter' && row.waiting_since &&
        daysBetween_(row.waiting_since, now) >= DORMANT_WARNING_DAYS) {
      alerts.push(row.id + ': waiting on the submitter for ' + daysBetween_(row.waiting_since, now) +
                  ' days; goes dormant at 60 (names kept). Write to them now if that is wrong.');
    }
    if (row.state === 'awaiting_submitter' && row.submitter_email) {
      // The wait is measured from when the ledger started it, never from our last
      // message (a reminder must not postpone the next one; finding 7). A reply from the
      // submitter since then means the ball is with us: no reminder to them, an alert to
      // the leads instead (finding 1: the ledger stays awaiting_submitter until a curator
      // files what the reply says).
      var since = row.waiting_since || row.received;
      var waiting = daysBetween_(since, now);
      var replied = row.last_from_submitter && row.last_from_submitter >= since;
      var recentlyWritten = row.last_to_submitter && daysBetween_(row.last_to_submitter, now) < REMINDER_THROTTLE_DAYS;
      if (replied) {
        alerts.push(row.id + ': the submitter wrote on ' + String(row.last_from_submitter).slice(0, 10) +
                    ' but the ledger still says awaiting_submitter; a curator should file ' +
                    'their answer (correction or update) or write back');
      } else if (!recentlyWritten) {
        for (var th = REMIND_SUBMITTER_DAYS.length - 1; th >= 0; th--) {
          var threshold = REMIND_SUBMITTER_DAYS[th];
          if (waiting === null || waiting < threshold) continue;
          var key = 'remind:' + row.id + ':' + threshold;
          if (loggedBefore_(log, key)) break;
          if (!sendSubmitterReminder_(row, waiting)) {
            // Held by mail.gs: not logged as sent, so it is tried again tomorrow.
            alerts.push(row.id + ': submitter reminder HELD by the mail guard (' + waiting +
                        ' days); see the Mail tab');
            break;
          }
          logEvent_('dailyClock', key + ' sent to ' + row.submitter_email);
          alerts.push(row.id + ': submitter reminded (' + waiting + ' days)');
          changed += 1;
          break;
        }
      }
    }

    // approved, hold elapsed, nothing moved
    if (row.state === 'approved' && row.hold_ends && row.hold_ends < today &&
        daysBetween_(row.hold_ends, now) >= 1 && (!row.synced_at || row.synced_at < row.hold_ends)) {
      alerts.push(row.id + ': publish hold ended ' + String(row.hold_ends).slice(0, 10) +
                  ' and the ledger has not synced since; the intake cycle has not run');
    }
  }

  // ---- 2. arrivals with no report -------------------------------------------------------
  for (var a = 0; a < arrivals.length; a++) {
    var arrival = arrivals[a];
    if (arrival.matched_id) continue;
    var match = matchArrival_(arrival, rows);
    if (match) {
      writeFields_(TAB_ARRIVALS, arrival._row, { matched_id: match.id });
      continue;
    }
    var age = daysBetween_(arrival.form_timestamp, now);
    if (age !== null && age > ARRIVAL_GIVE_UP_DAYS) {
      // A test or spam response never gets a row; after two weeks stop asking about it
      // (finding 14). Any text in matched_id silences the alert.
      writeFields_(TAB_ARRIVALS, arrival._row, { matched_id: 'no row after ' + age + ' days; ignored' });
      continue;
    }
    if (age !== null && age >= ARRIVAL_WITHOUT_REPORT_DAYS) {
      alerts.push('a submission from ' + (arrival.submitter_name || arrival.submitter_email ||
                  'an unknown sender') + ' arrived ' + String(arrival.form_timestamp).slice(0, 10) +
                  ' and has no report after ' + age + ' days: the screen has not run');
    }
  }

  // ---- 3. the sheet itself ---------------------------------------------------------------
  var staleHours = newestSync ? (now.getTime() - parseStamp_(newestSync).getTime()) / 3600000 : null;
  if (staleHours === null) {
    alerts.unshift('the ledger has NEVER synced to this sheet (no synced_at); states and ' +
                   '"waiting on" below come from Google only');
  } else if (staleHours > SHEET_STALE_HOURS) {
    alerts.unshift('the ledger last synced ' + Math.round(staleHours) + ' hours ago: the ' +
                   'intake cycle is not running (RUNBOOK 4b)');
  }

  // ---- 4. unfiled mail since yesterday ---------------------------------------------------
  var cutoff = isoNow_(new Date(now.getTime() - 25 * 3600000));
  var unfiled = [];
  for (var u = 0; u < mail.length; u++) {
    if (mail[u].direction === 'in' && !mail[u].id && mail[u].at >= cutoff) {
      unfiled.push(mail[u].from + ': ' + (mail[u].subject || '(no subject)') +
                   (mail[u].thread_url ? ' ' + mail[u].thread_url : ''));
    }
  }

  // ---- send -------------------------------------------------------------------------------
  var sent = 0;
  for (var address in reminders) {
    var lines = ['[this is an automatic email]', '',
                 'Reminders from the MalAvi status sheet, ' + today.slice(0, 10) + ':', ''];
    for (var L = 0; L < reminders[address].length; L++) lines.push('- ' + reminders[address][L]);
    lines.push('');
    lines.push('Verdicts are recorded through the link in each report. This message is sent ' +
               'once a day at most; replying to it reaches the MalAvi address and the leads.');
    lines.push('', '--', 'Confidential. A submission may contain unpublished sequences.');
    // One reminder email per person per day: the key is the day, so a clock run twice
    // in one day (a hand run after the trigger) sends it once.
    var result = sendMail_({ to: address,
                             subject: 'MalAvi: ' + reminders[address].length + ' reminder' +
                                      (reminders[address].length === 1 ? '' : 's') + ' for today',
                             body: lines.join('\n'), kind: 'curator',
                             // The day AND the content: a hand run later the same day with
                             // something new to say sends; the same list does not.
                             key: 'reminders|' + today.slice(0, 10) + '|' +
                                  mailSha_(reminders[address].join('\n')),
                             note: 'daily reminders' });
    if (result.sent) sent += 1;
  }

  var digestSent = sendDigest_(rows, alerts, unfiled, today);
  logEvent_('dailyClock', sent + ' reminder email(s), digest ' + (digestSent ? 'sent' : 'not needed') +
            ', ' + alerts.length + ' alert(s), ' + changed + ' row change(s)');
}


/** Verdict rows for an id, optionally after a stamp, by a curator, with a given verdict. */
function verdictsFor_(verdicts, id, after, curator, verdict) {
  var out = [];
  var who = String(curator || '').toLowerCase();
  for (var i = 0; i < verdicts.length; i++) {
    var v = verdicts[i];
    if (v.id !== id || !v.verdict) continue;
    if (after && v.recorded_at < after) continue;
    if (who && String(v.curator || '').toLowerCase() !== who) continue;
    if (verdict && v.verdict !== verdict) continue;
    out.push(v);
  }
  return out;
}


function markReminded_(row, today) {
  writeFields_(TAB_SUBMISSIONS, row._row, { last_reminder: today });
  row.last_reminder = today;
}


/** Has a Log row with this message prefix been written before? */
function loggedBefore_(log, key) {
  for (var i = 0; i < log.length; i++) {
    if (String(log[i].message || '').indexOf(key + ' ') === 0) return true;
  }
  return false;
}


/** The Submissions row an Arrivals row belongs to: same address, received after the form
 *  timestamp minus a day (the fetch records the form's own time). */
function matchArrival_(arrival, rows) {
  var address = (arrival.submitter_email || '').toLowerCase();
  if (!address) return null;
  var floor = parseStamp_(arrival.form_timestamp);
  var best = null;
  for (var i = 0; i < rows.length; i++) {
    if ((rows[i].submitter_email || '').toLowerCase() !== address) continue;
    var received = parseStamp_(rows[i].received);
    if (floor && received && received.getTime() < floor.getTime() - 86400000) continue;
    if (!best || (rows[i].received || '') < (best.received || '')) best = rows[i];
  }
  return best;
}


/** The reminder to a submitter we are waiting on. Recorded as outgoing mail. */
function sendSubmitterReminder_(row, waitingDays) {
  var name = row.submitter_name ? row.submitter_name.split(/\s+/)[0] : 'colleague';
  var updateForm = setting_('UPDATE_FORM_URL');
  var lines = [
    'Dear ' + name + ',',
    '',
    'Your MalAvi submission ' + row.id + ' is waiting for a reply from you (about ' +
      waitingDays + ' days now). The earlier message from the curators says what is needed.',
    '',
    updateForm
      ? 'If the answer is a corrected template, upload it through the update form: ' + updateForm +
        '. Otherwise, reply to this email.'
      : 'Please reply to this email; a corrected template can be attached to the reply.',
    '',
    'Your reserved lineage names are kept while we wait. A submission that stays unanswered ' +
      'for 60 days is set aside until we hear from you; nothing is lost and nothing is ' +
      'given away.',
    '',
    'Best regards,',
    'The MalAvi curators',
    'https://malavi-db.github.io/'
  ];
  var copies = row.assignee ? { cc: row.assignee } : {};
  var result = sendAndRecord_(row.submitter_email, 'MalAvi submission ' + row.id +
                              ': still waiting for your reply', lines.join('\n'), copies,
                              row.id, 'reminder at ' + waitingDays + ' days');
  if (!result.sent) return false;        // held: nothing stamped, tried again tomorrow
  // last_to_submitter records the contact; the next threshold is still measured from
  // waiting_since (see the caller), so this does not postpone it.
  writeFields_(TAB_SUBMISSIONS, row._row, { last_to_submitter: isoNow_(), last_reminder: isoNow_() });
  return true;
  row.last_to_submitter = isoNow_();
}


/** The leads' digest. Returns true if one was sent. */
function sendDigest_(rows, alerts, unfiled, today) {
  var open = [];
  for (var i = 0; i < rows.length; i++) {
    if (!rows[i].state || LIVE_STATES.indexOf(rows[i].state) !== -1) open.push(rows[i]);
  }
  if (!open.length && !alerts.length && !unfiled.length) return false;

  open.sort(function (a, b) {
    return String(a.waiting_since || a.received) < String(b.waiting_since || b.received) ? -1 : 1;
  });
  var lines = ['[this is an automatic email]', '',
               'MalAvi queue, ' + today.slice(0, 10) + ': ' + open.length + ' open submission' +
               (open.length === 1 ? '' : 's') + '.', ''];
  if (alerts.length) {
    lines.push('NEEDS ATTENTION');
    for (var a = 0; a < alerts.length; a++) lines.push('- ' + alerts[a]);
    lines.push('');
  }
  lines.push('THE QUEUE (longest wait first)');
  for (var o = 0; o < open.length; o++) {
    var r = open[o];
    var since = r.waiting_since || r.report_at || r.received;
    var days = daysBetween_(since, new Date());
    lines.push('- ' + r.id + ' | ' + (r.state || 'not synced') + ' | waiting on ' +
               (r.waiting_on || '?') + (days !== null ? ' for ' + days + ' d' : '') +
               ' | assigned: ' + (r.assignee ? curatorName_(r.assignee) : 'NOBODY') +
               (r.verdicts ? ' | ' + r.verdicts : ' | no verdicts') +
               (r.embargoed === 'yes' ? ' | embargoed' : ''));
  }
  lines.push('');
  if (unfiled.length) {
    lines.push('UNFILED MAIL since yesterday (no submission id, sender not a known submitter)');
    for (var u = 0; u < unfiled.length; u++) lines.push('- ' + unfiled[u]);
    lines.push('');
  }
  lines.push('The status sheet has the detail: ' + statusSpreadsheet_().getUrl());
  lines.push(mailStatusLine_());
  lines.push('', '--', 'Confidential. Names of submitters appear above; do not forward.');

  var leads = attentionTo_();
  var delivered = false;
  for (var L = 0; L < leads.length; L++) {
    var result = sendMail_({ to: leads[L],
                             subject: 'MalAvi daily: ' + open.length + ' open' +
                                      (alerts.length ? ', ' + alerts.length + ' need attention' : ''),
                             body: lines.join('\n'), kind: 'lead',
                             key: 'digest|' + today.slice(0, 10), note: 'daily digest' });
    if (result.sent) delivered = true;
  }
  return delivered;
}


/** HAND FUNCTION. Run the clock now. It sends whatever is due, exactly as the trigger would. */
function dailyClockNow() {
  if (!statusSheetEnabled_()) { Logger.log('STATUS_SHEET_ID is not set.'); return; }
  dailyClock();
  Logger.log('Done; see the Log tab for what was sent.');
}


// ======================================================================================
// FILE: triggers.gs
// ======================================================================================

/**
 * Install, list and remove every trigger of the "MalAvi curation" project in one place.
 *
 * WHY ONE PLACE
 * -------------
 * Each file used to carry its own installTrigger() and showTriggers(). In a single project
 * those names collide (Apps Script keeps whichever file loads last, silently), and five
 * separate install steps are five chances to forget one. installAllTriggers() is the one
 * step: it removes every trigger this project owns for the handlers below and recreates
 * the ones whose settings exist, so running it twice cannot double an email, and a form
 * whose id is not set is simply reported as skipped.
 *
 * THE TRIGGERS
 * ------------
 *   onSubmissionReceived   form submit  SUBMISSION_FORM_ID   notify_on_submission.gs
 *   onVerdictRecorded      form submit  VERDICT_FORM_ID      notify_on_verdict.gs
 *   onUpdateReceived       form submit  UPDATE_FORM_ID       create_update_form.gs
 *   triageInbox            every 15 min (needs STATUS_SHEET_ID)   inbox_triage.gs
 *   dailyClock             daily, 07:00 in the project's time zone (UTC, appsscript.json)
 *                                       (needs STATUS_SHEET_ID)   daily_clock.gs
 *
 * Do not look for the Triggers screen to add the form triggers: a standalone project is
 * not offered "From form" there. Creating them in code works and is repeatable.
 *
 * AFTER THE MERGE
 * ---------------
 * The old separate projects ("MalAvi submission notifier", and any verdict or update
 * notifier that was installed) keep their own triggers until somebody removes them. Open
 * each old project once and run its removal, or delete the project; otherwise every
 * arrival is announced twice.
 */

var TRIGGER_HANDLERS = ['onSubmissionReceived', 'onVerdictRecorded', 'onUpdateReceived',
                        'triageInbox', 'dailyClock'];

// The hour (project time zone, UTC) the daily clock runs. 07:00 UTC is morning in Europe
// and the previous evening in the Americas, so a reminder is read on the day it is sent.
var DAILY_CLOCK_HOUR = 7;
var TRIAGE_EVERY_MINUTES = 15;


/** Remove every trigger of this project whose handler is one of ours. Returns the count. */
function removeOurTriggers_() {
  var existing = ScriptApp.getProjectTriggers();
  var removed = 0;
  for (var i = 0; i < existing.length; i++) {
    if (TRIGGER_HANDLERS.indexOf(existing[i].getHandlerFunction()) !== -1) {
      ScriptApp.deleteTrigger(existing[i]);
      removed += 1;
    }
  }
  return removed;
}


/**
 * HAND FUNCTION. Install every trigger whose settings exist. Safe to run again at any
 * time: it starts by removing the ones already installed.
 */
function installAllTriggers() {
  var report = [];
  var removed = removeOurTriggers_();
  if (removed) report.push('removed ' + removed + ' existing trigger(s)');

  var forms = [
    ['onSubmissionReceived', 'SUBMISSION_FORM_ID'],
    ['onVerdictRecorded', 'VERDICT_FORM_ID'],
    ['onUpdateReceived', 'UPDATE_FORM_ID']
  ];
  for (var f = 0; f < forms.length; f++) {
    var handler = forms[f][0];
    var formId = setting_(forms[f][1]);
    if (!formId) {
      report.push(handler + ': SKIPPED, ' + forms[f][1] + ' is not set');
      continue;
    }
    ScriptApp.newTrigger(handler).forForm(formId).onFormSubmit().create();
    report.push(handler + ': installed on form ' + formId);
  }

  if (statusSheetEnabled_()) {
    ScriptApp.newTrigger('triageInbox').timeBased().everyMinutes(TRIAGE_EVERY_MINUTES).create();
    report.push('triageInbox: every ' + TRIAGE_EVERY_MINUTES + ' minutes');
    ScriptApp.newTrigger('dailyClock').timeBased().everyDays(1).atHour(DAILY_CLOCK_HOUR).create();
    report.push('dailyClock: daily at ' + DAILY_CLOCK_HOUR + ':00 ' +
                Session.getScriptTimeZone());
  } else {
    report.push('triageInbox and dailyClock: SKIPPED, STATUS_SHEET_ID is not set ' +
                '(run createStatusSheet first, then this again)');
  }

  if (!curators_().length) {
    report.push('WARNING: CURATORS is empty; the form triggers will have nobody to tell');
  }
  logEvent_('installAllTriggers', report.join('; '));
  Logger.log(report.join('\n'));
}


/** HAND FUNCTION. Remove every trigger this project installed. Nothing else is touched. */
function removeAllTriggers() {
  var removed = removeOurTriggers_();
  logEvent_('removeAllTriggers', 'removed ' + removed + ' trigger(s)');
  Logger.log('Removed ' + removed + ' trigger(s).');
}


/** List what is currently attached, so "did that work?" has an answer. */
function showTriggers() {
  var triggers = ScriptApp.getProjectTriggers();
  if (!triggers.length) { Logger.log('No triggers installed.'); return; }
  for (var i = 0; i < triggers.length; i++) {
    var source = '';
    try { source = ' on ' + triggers[i].getTriggerSourceId(); } catch (err) { source = ''; }
    Logger.log(triggers[i].getHandlerFunction() + '  <-  ' + triggers[i].getEventType() + source);
  }
}


